@model KarnelTravelGuide.Web.Models.Entities.Transportation
@{
    ViewData["Title"] = "Delete Route";
}

<div class="card shadow border-danger border-2 rounded-4" style="max-width: 600px; margin: 0 auto;">
    <div class="card-body p-5 text-center">
        <div class="mb-4">
            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Delete this route?</h3>
        <p class="text-muted mb-4">You are about to delete the transportation route from <strong>@Model.FromBranch?.BranchName</strong> to <strong>@Model.ToSpot?.SpotName</strong>. This action cannot be undone.</p>

        <div class="bg-light p-4 rounded-3 text-start mb-4 border">
            <div class="d-flex align-items-center mb-3">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px;" class="me-3 shadow-sm border" />
                }
                else
                {
                    <div class="bg-white border rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-image text-muted fs-3"></i>
                    </div>
                }
                <div>
                    <h5 class="fw-bold text-primary mb-1">
                        @Model.FromBranch?.BranchName <i class="bi bi-arrow-right mx-1"></i> @Model.ToSpot?.SpotName
                    </h5>
                    <span class="badge bg-danger"><i class="bi bi-clock me-1"></i> @Model.DepartureTime?.ToString("HH:mm")</span>
                </div>
            </div>
            
            <div class="mb-2">
                <small class="text-muted fw-bold d-block">From Address:</small>
                <span class="text-dark small"><i class="bi bi-geo-alt text-danger me-1"></i>@Model.FromBranch?.Address</span>
            </div>
            <div class="mb-3">
                <small class="text-muted fw-bold d-block">To Address:</small>
                <span class="text-dark small"><i class="bi bi-geo-alt text-danger me-1"></i>@Model.ToSpot?.Address</span>
            </div>

            <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-2">
                <div class="text-muted small text-truncate pe-2" style="max-width: 60%;">
                    <strong>Transport:</strong> <span class="text-dark fw-bold">@Model.TransportName</span>
                </div>
                <h5 class="mb-0 text-success fw-bold">$@Model.PriceTransport?.ToString("0") USD</h5>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="TransportationId" />
            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Index" class="btn btn-light border px-4 fw-semibold">Cancel</a>
                <button type="submit" class="btn btn-danger px-4 fw-semibold"><i class="bi bi-trash me-1"></i> Yes, Delete it!</button>
            </div>
        </form>
    </div>
</div>