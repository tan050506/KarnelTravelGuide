@model KarnelTravelGuide.Web.Models.Entities.Transportation
@{
    ViewData["Title"] = "Delete Route";
}

<div class="k-card p-4 bg-white shadow-sm mx-auto" style="max-width: 600px; border-radius: 1rem; border: 2px solid #dc3545 !important;">
    <div class="p-2 text-center">
        <div class="mb-4">
            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Delete this route?</h3>
        <p class="text-muted mb-4">You are about to delete the transportation route from <strong>@Model.FromBranch?.BranchName</strong> to <strong>@Model.ToSpot?.SpotName</strong>. This action cannot be undone, and the associated image file will be permanently removed.</p>

        <div class="bg-light p-4 rounded-4 text-start mb-5 border">
            <div class="d-flex align-items-center mb-4">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/img/no-image.jpg" : Model.ImageUrl)" style="width: 80px; height: 80px; object-fit: cover;" class="me-3 shadow-sm border rounded-3" />
                <div>
                    <h5 class="fw-bold text-primary mb-2">@Model.FromBranch?.BranchName <i class="bi bi-arrow-right mx-1 text-dark"></i> @Model.ToSpot?.SpotName</h5>
                    <span class="badge bg-danger fs-6"><i class="bi bi-clock me-1"></i> @Model.DepartureTime?.ToString("HH:mm")</span>
                </div>
            </div>
            
            <div class="mb-3">
                <small class="text-muted fw-bold d-block">From Address:</small>
                <span class="text-dark small"><i class="bi bi-geo-alt text-danger me-1"></i>@Model.FromBranch?.Address</span>
            </div>
            <div class="mb-3">
                <small class="text-muted fw-bold d-block">To Address:</small>
                <span class="text-dark small"><i class="bi bi-geo-alt text-danger me-1"></i>@Model.ToSpot?.Address</span>
            </div>

            <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-4">
                <div class="text-muted small text-truncate pe-2">
                    <strong>Transport:</strong> <span class="text-dark fw-bold">@Model.TransportName</span>
                </div>
                <h4 class="mb-0 text-success fw-bold">$@Model.PriceTransport?.ToString("0.##") USD</h4>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="TransportationId" />
            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Index" class="btn btn-light border px-4 py-2 fw-bold rounded-3">No, Cancel</a>
                <button type="submit" class="btn btn-danger px-4 py-2 fw-bold rounded-3"><i class="bi bi-trash me-2"></i> Yes, Delete it!</button>
            </div>
        </form>
    </div>
</div>