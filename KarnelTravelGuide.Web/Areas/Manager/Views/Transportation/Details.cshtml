@model KarnelTravelGuide.Web.Models.Entities.Transportation
@{
    ViewData["Title"] = "Route Details";
}

<div class="card shadow-sm border-0 rounded-4" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header bg-white pt-4 px-4 border-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-primary mb-0"><i class="bi bi-info-circle me-2"></i>Route Details</h5>
        @if (Model.TransportType == "Air") { <span class="badge bg-primary px-3 py-2"><i class="bi bi-airplane me-1"></i> Air</span> }
        else if (Model.TransportType == "Land") { <span class="badge bg-success px-3 py-2"><i class="bi bi-car-front me-1"></i> Land</span> }
        else { <span class="badge bg-info text-dark px-3 py-2"><i class="bi bi-water me-1"></i> Water</span> }
    </div>
    <div class="card-body p-4">
        <div class="row align-items-center">
            <div class="col-md-5 text-center mb-4 mb-md-0">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid rounded-3 shadow-sm border" style="max-height: 280px; width: 100%; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-light rounded-3 d-flex align-items-center justify-content-center border" style="height: 280px; width: 100%;">
                        <div class="text-muted"><i class="bi bi-image text-secondary d-block mb-2" style="font-size: 3rem;"></i><span>No Image</span></div>
                    </div>
                }
            </div>
            <div class="col-md-7 ps-md-4">
                
                <div class="mb-3">
                    <span class="d-block small text-muted text-uppercase fw-bold">Departure (From)</span>
                    <h6 class="fw-bold text-dark mb-0">@Model.FromBranch?.BranchName</h6>
                    <small class="text-danger"><i class="bi bi-geo-alt"></i> @Model.FromBranch?.Address</small>
                </div>
                
                <div class="mb-3">
                    <span class="d-block small text-muted text-uppercase fw-bold">Destination (To)</span>
                    <h6 class="fw-bold text-primary mb-0">@Model.ToSpot?.SpotName</h6>
                    <small class="text-danger"><i class="bi bi-geo-alt"></i> @Model.ToSpot?.Address</small>
                </div>

                <hr class="text-muted opacity-25" />
                
                <div class="row mb-3">
                    <div class="col-6">
                        <p class="text-muted mb-1 small">Fixed Time</p>
                        <h5 class="fw-bold text-danger"><i class="bi bi-clock me-1"></i> @Model.DepartureTime?.ToString("HH:mm")</h5>
                    </div>
                    <div class="col-6">
                        <p class="text-muted mb-1 small">Ticket Price</p>
                        <h5 class="fw-bold text-success"><i class="bi bi-cash me-1"></i> $@Model.PriceTransport?.ToString("0") USD</h5>
                    </div>
                </div>
                
                <div class="mb-3 bg-light p-3 rounded-3 border">
                    <span class="d-block small text-muted text-uppercase fw-bold mb-1">Transport Name</span>
                    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-tag-fill text-primary me-2"></i>@Model.TransportName</h5>
                </div>
                
                <h6 class="fw-bold text-secondary mb-2">Additional Details:</h6>
                <p class="text-dark small" style="white-space: pre-line; line-height: 1.6;">@(string.IsNullOrEmpty(Model.Description) ? "No additional details." : Model.Description)</p>
            </div>
        </div>
    </div>
    <div class="card-footer bg-light px-4 py-3 border-0 rounded-bottom-4 d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-outline-secondary fw-semibold"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.TransportationId" class="btn btn-primary fw-semibold me-2"><i class="bi bi-pencil-square me-1"></i> Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.TransportationId" class="btn btn-danger fw-semibold"><i class="bi bi-trash me-1"></i> Delete</a>
        </div>
    </div>
</div>