@model KarnelTravelGuide.Web.Models.Entities.Transportation
@{
    ViewData["Title"] = "Edit Route";
}

<div class="card shadow-sm border-0 rounded-4" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header bg-white pt-4 px-4 border-0">
        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Route</h5>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <input type="hidden" asp-for="TransportationId" />
            <input type="hidden" asp-for="ImageUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Departure (From)</label>
                    <input type="text" class="form-control bg-light text-muted fw-bold border-0 mb-1" value="@ViewBag.BranchName" readonly />
                    <small class="text-danger"><i class="bi bi-geo-alt"></i> @ViewBag.BranchAddress</small>
                    <input type="hidden" asp-for="FromBranchId" />
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold text-primary small text-uppercase">Destination (To)</label>
                    <select asp-for="ToSpotId" class="form-select border-primary mb-1" id="spotSelect" onchange="updateAddress()" required>
                        <option value="">-- Select Tourist Spot --</option>
                        @foreach (var spot in ViewBag.TouristSpots)
                        {
                            if (spot.SpotId == Model.ToSpotId)
                            {
                                <option value="@spot.SpotId" data-address="@spot.Address" selected>@spot.SpotName</option>
                            }
                            else
                            {
                                <option value="@spot.SpotId" data-address="@spot.Address">@spot.SpotName</option>
                            }
                        }
                    </select>
                    <small class="text-danger" id="destAddressText"><i class="bi bi-geo-alt"></i> Loading address...</small>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Transport Type</label>
                    <select asp-for="TransportType" class="form-select" required>
                        <option value="Land">🚌 Land</option>
                        <option value="Air">✈️ Air</option>
                        <option value="Water">🛳️ Water</option>
                    </select>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Fixed Time</label>
                    <input asp-for="DepartureTime" class="form-control" type="time" value="@Model.DepartureTime?.ToString("HH:mm")" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Ticket Price (USD)</label>
                    <input asp-for="PriceTransport" class="form-control" type="number" min="0" step="1" value="@Model.PriceTransport?.ToString("0")" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Tổng số ghế <span class="text-danger">*</span></label>
                    <input asp-for="SeatCapacity" class="form-control" type="number" min="5" max="100" value="@Model.SeatCapacity" required />
                </div>
                
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Transport Name <span class="text-danger">*</span></label>
                <input asp-for="TransportName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Additional Details</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Update Image (Optional)</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" onchange="previewImage(event)" />
                <div class="mt-3 text-center bg-light rounded-3 p-3 border">
                    <span class="d-block text-muted small mb-2">Current / Preview Image</span>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img id="imagePreview" src="@Model.ImageUrl" style="max-height: 200px; object-fit: cover; border-radius: 8px;" />
                    }
                    else
                    {
                        <img id="imagePreview" style="max-height: 200px; object-fit: cover; border-radius: 8px; display: none;" />
                    }
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-light border fw-semibold">Cancel</a>
                <button type="submit" class="btn btn-primary fw-semibold"><i class="bi bi-check2-circle me-1"></i> Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function(){
                var output = document.getElementById('imagePreview');
                output.src = reader.result;
                output.style.display = 'inline-block';
            };
            if(event.target.files[0]) reader.readAsDataURL(event.target.files[0]);
        }
        function updateAddress() {
            var select = document.getElementById("spotSelect");
            if(select.selectedIndex >= 0) {
                var address = select.options[select.selectedIndex].getAttribute("data-address");
                document.getElementById("destAddressText").innerHTML = '<i class="bi bi-geo-alt"></i> ' + (address ? address : "Address not found");
            }
        }
        window.onload = updateAddress;
    </script>
}