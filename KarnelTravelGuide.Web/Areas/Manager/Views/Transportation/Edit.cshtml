@model KarnelTravelGuide.Web.Models.Entities.Transportation
@{
    ViewData["Title"] = "Edit Route";
}

<style>
    .preview-box { position: relative; display: inline-block; }
    .btn-remove-preview { position: absolute; top: -10px; right: -10px; width: 25px; height: 25px; padding: 0; background: #fff; color: #dc3545; border-radius: 50%; border: 1px solid #dc3545; display: flex; align-items: center; justify-content: center; font-size: 1rem; cursor: pointer; transition: 0.3s; z-index: 5; }
    .btn-remove-preview:hover { background: #dc3545; color: #fff; transform: scale(1.1); }

    /* CSS cho Dropdown tìm kiếm */
    .custom-dropdown-menu { max-height: 250px; overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1000; width: 100%; display: none; margin-top: 5px; }
    .custom-dropdown-menu.show { display: block; }
    .dropdown-item-custom { transition: background-color 0.2s; cursor: pointer; white-space: normal; }
    .dropdown-item-custom:hover { background-color: #f8f9fa; }
</style>

<div class="k-card mx-auto" style="max-width: 900px;">
    <div class="d-flex align-items-center border-bottom pb-3 mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3"><i class="bi bi-arrow-left"></i></a>
        <h4 class="fw-bold m-0 text-dark">Update Route: <span class="text-primary">@Model.TransportName</span></h4>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="transportForm">
        <input type="hidden" asp-for="TransportationId" />
        <input type="hidden" asp-for="ImageUrl" />
        
        <div class="row g-4">
            
            <div class="col-md-6">
                <div class="p-3 rounded-3 bg-light border h-100">
                    <label class="label-karnel text-muted">Departure (From)</label>
                    <div class="fw-bold text-dark fs-5 mb-1">@ViewBag.BranchName</div>
                    <small class="text-danger"><i class="bi bi-geo-alt"></i> @ViewBag.BranchAddress</small>
                    <input type="hidden" asp-for="FromBranchId" />
                </div>
            </div>

            <div class="col-md-6">
                <div class="p-3 rounded-3 bg-light border h-100 position-relative">
                    <label class="label-karnel text-muted">Destination (To) <span class="text-danger">*</span></label>
                    
                    <div class="position-relative">
                        <input type="text" id="spotSearchInput" class="k-input mb-1" placeholder="Type spot name or address..." autocomplete="off" required>
                        <input type="hidden" asp-for="ToSpotId" id="hiddenSpotId" />
                        
                        <div id="spotDropdown" class="custom-dropdown-menu k-card shadow-lg p-0 border"></div>
                    </div>

                    <small class="text-danger d-block mt-1" id="destAddressText"><i class="bi bi-geo-alt"></i> Loading address...</small>
                </div>
            </div>

            <div class="col-md-3">
                <label class="label-karnel">Transport Type</label>
                <select asp-for="TransportType" class="k-input" required>
                    <option value="Land">🚌 Land</option>
                    <option value="Air">✈️ Air</option>
                    <option value="Water">🛳️ Water</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="label-karnel">Fixed Time</label>
                <input asp-for="DepartureTime" class="k-input" type="time" value="@Model.DepartureTime?.ToString("HH:mm")" required />
            </div>

            <div class="col-md-3">
                <label class="label-karnel">Price (USD)</label>
                <input asp-for="PriceTransport" class="k-input" type="number" min="0" step="1" value="@Model.PriceTransport?.ToString("0")" required />
            </div>

            <div class="col-md-3">
                <label class="label-karnel">Total Seats</label>
                <input asp-for="SeatCapacity" class="k-input" type="number" min="5" max="100" value="@Model.SeatCapacity" required />
            </div>

            <div class="col-md-6">
                <label class="label-karnel">Transport Name</label>
                <input asp-for="TransportName" class="k-input" required />
            </div>

            <div class="col-md-6">
                <label class="label-karnel">Additional Details</label>
                <textarea asp-for="Description" class="k-input" rows="1"></textarea>
            </div>

            <div class="col-12">
                <div class="p-4 border rounded-4 bg-light text-center">
                    <label class="label-karnel d-block text-start mb-3"><i class="bi bi-image me-1"></i>Update Image</label>
                    <input type="file" name="imageFile" id="imageInput" class="form-control w-50 mx-auto" accept="image/*" onchange="previewImage(event)" />
                    <small class="text-muted d-block mt-2">Leave blank to keep current image.</small>

                    <div id="previewContainer" class="mt-4 @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")">
                        <div class="preview-box">
                            <button type="button" class="btn-remove-preview" onclick="removeImage()"><i class="bi bi-x"></i></button>
                            <img id="imagePreview" src="@Model.ImageUrl" class="img-fluid rounded-3 shadow border" style="max-height: 250px; object-fit: cover;" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 mt-5 text-end border-top pt-4">
                <button type="submit" class="k-btn-primary px-5 py-3"><i class="bi bi-check2-circle me-2"></i> Save Changes</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Xử lý ảnh
        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('previewContainer').classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            }
        }

        function removeImage() {
            document.getElementById('imageInput').value = '';
            document.getElementById('previewContainer').classList.add('d-none');
            document.getElementById('imagePreview').src = '';
        }

        // Logic Custom Dropdown (Có hỗ trợ Pre-fill dữ liệu cũ)
        const spots = [
            @foreach(var s in ViewBag.TouristSpots)
            {
                <text>{ id: @s.SpotId, name: "@Html.Raw(s.SpotName)", address: "@Html.Raw(s.Address)" },</text>
            }
        ];

        const searchInput = document.getElementById('spotSearchInput');
        const dropdown = document.getElementById('spotDropdown');
        const hiddenId = document.getElementById('hiddenSpotId');
        const addressText = document.getElementById('destAddressText');

        // Tự động load dữ liệu cũ khi vào trang Edit
        window.onload = function() {
            if (hiddenId.value) {
                const currentSpot = spots.find(s => s.id == hiddenId.value);
                if (currentSpot) {
                    searchInput.value = currentSpot.name;
                    addressText.innerHTML = `<i class="bi bi-geo-alt"></i> ${currentSpot.address || 'Address not found'}`;
                }
            } else {
                addressText.innerHTML = '<i class="bi bi-geo-alt"></i> Please select a destination...';
            }
        };

        function renderDropdown(filterText = "") {
            dropdown.innerHTML = '';
            const lowerFilter = filterText.toLowerCase();

            const filtered = spots.filter(s =>
                (s.name && s.name.toLowerCase().includes(lowerFilter)) ||
                (s.address && s.address.toLowerCase().includes(lowerFilter))
            );

            if (filtered.length === 0) {
                dropdown.innerHTML = '<div class="p-3 text-muted small fst-italic">No spots found.</div>';
            } else {
                filtered.forEach(s => {
                    const item = document.createElement('div');
                    item.className = 'dropdown-item-custom p-3 border-bottom';
                    item.innerHTML = `
                        <div class="fw-bold text-dark fs-6 mb-1">${s.name}</div>
                        <div class="small text-muted"><i class="bi bi-geo-alt text-danger me-1"></i> ${s.address || 'N/A'}</div>
                    `;
                    item.onclick = function() {
                        searchInput.value = s.name;
                        hiddenId.value = s.id;
                        addressText.innerHTML = `<i class="bi bi-geo-alt"></i> ${s.address || 'Address not found'}`;
                        dropdown.classList.remove('show');
                    };
                    dropdown.appendChild(item);
                });
            }
            dropdown.classList.add('show');
        }

        searchInput.addEventListener('input', function() {
            hiddenId.value = ''; 
            addressText.innerHTML = '<i class="bi bi-geo-alt"></i> Please select a destination...';
            renderDropdown(this.value);
        });
        searchInput.addEventListener('focus', function() {
            renderDropdown(this.value);
        });
        document.addEventListener('click', function(e) {
            if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.classList.remove('show');
            }
        });

        document.getElementById('transportForm').addEventListener('submit', function(e) {
            if (!hiddenId.value) {
                e.preventDefault();
                alert("Please select a Tourist Spot destination from the dropdown list!");
                searchInput.focus();
            }
        });
    </script>
}