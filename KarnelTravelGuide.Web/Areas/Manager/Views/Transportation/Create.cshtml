@model KarnelTravelGuide.Web.Models.Entities.Transportation
@{
    ViewData["Title"] = "Add Transportation Route";
}

<div class="card shadow-sm border-0 rounded-4" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header bg-white pt-4 px-4 border-0">
        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-bus-front me-2 text-primary"></i>Add New Route</h5>
    </div>
    <div class="card-body p-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row">
                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Departure (From)</label>
                    <input type="text" class="form-control bg-light text-muted fw-bold border-0 mb-1" value="@ViewBag.BranchName" readonly />
                    <small class="text-danger"><i class="bi bi-geo-alt"></i> @ViewBag.BranchAddress</small>
                    <input type="hidden" asp-for="FromBranchId" value="@ViewBag.FromBranchId" />
                </div>

                <div class="col-md-6 mb-4">
                    <label class="form-label fw-bold text-primary small text-uppercase">Destination (To) <span class="text-danger">*</span></label>
                    <select asp-for="ToSpotId" class="form-select border-primary mb-1" id="spotSelect" onchange="updateAddress()" required>
                        <option value="" data-address="Please select a destination to see the address">-- Select Tourist Spot --</option>
                        @foreach (var spot in ViewBag.TouristSpots)
                        {
                            <option value="@spot.SpotId" data-address="@spot.Address">@spot.SpotName</option>
                        }
                    </select>
                    <small class="text-danger" id="destAddressText"><i class="bi bi-geo-alt"></i> Please select a destination...</small>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Transport Type <span class="text-danger">*</span></label>
                    <select asp-for="TransportType" class="form-select" required>
                        <option value="">-- Select Type --</option>
                        <option value="Land">🚌 Land</option>
                        <option value="Air">✈️ Air</option>
                        <option value="Water">🛳️ Water</option>
                    </select>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Fixed Time <span class="text-danger">*</span></label>
                    <input asp-for="DepartureTime" class="form-control" type="time" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-semibold">Ticket Price (USD) <span class="text-danger">*</span></label>
                    <input asp-for="PriceTransport" class="form-control" type="number" min="0" step="1" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Transport Name <span class="text-danger">*</span></label>
                <input asp-for="TransportName" class="form-control" placeholder="e.g., Boeing 747, Limousine, Phương Trang..." required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Additional Details / Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="e.g., Free Wi-Fi, Air Conditioning..."></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Transport Image <span class="text-danger">*</span></label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" required onchange="previewImage(event)" />
                <div class="mt-3 text-center bg-light rounded-3 p-2" id="previewContainer" style="display: none;">
                    <img id="imagePreview" style="max-height: 200px; object-fit: cover; border-radius: 8px; border: 1px solid #dee2e6;" />
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-light border fw-semibold">Cancel</a>
                <button type="submit" class="btn btn-primary fw-semibold"><i class="bi bi-save me-1"></i> Create Route</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function(){
                var output = document.getElementById('imagePreview');
                document.getElementById('previewContainer').style.display = 'block';
                output.src = reader.result;
            };
            if(event.target.files[0]) reader.readAsDataURL(event.target.files[0]);
        }

        function updateAddress() {
            var select = document.getElementById("spotSelect");
            var address = select.options[select.selectedIndex].getAttribute("data-address");
            document.getElementById("destAddressText").innerHTML = '<i class="bi bi-geo-alt"></i> ' + (address ? address : "Address not found");
        }
    </script>
}