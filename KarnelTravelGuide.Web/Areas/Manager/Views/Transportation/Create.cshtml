@model KarnelTravelGuide.Web.Models.Entities.Transportation
@{
    ViewData["Title"] = "Add Transportation Route";
}

<style>
    .preview-box { position: relative; display: inline-block; }
    .btn-remove-preview { position: absolute; top: -10px; right: -10px; width: 25px; height: 25px; padding: 0; background: #fff; color: #dc3545; border-radius: 50%; border: 1px solid #dc3545; display: flex; align-items: center; justify-content: center; font-size: 1rem; cursor: pointer; transition: 0.3s; z-index: 5; }
    .btn-remove-preview:hover { background: #dc3545; color: #fff; transform: scale(1.1); }
    
    .custom-dropdown-menu { max-height: 250px; overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1000; width: 100%; display: none; margin-top: 5px; }
    .custom-dropdown-menu.show { display: block; }
    .dropdown-item-custom { transition: background-color 0.2s; cursor: pointer; white-space: normal; }
    .dropdown-item-custom:hover { background-color: #f8f9fa; }
</style>

<div class="k-card p-4 bg-white rounded-4 shadow-sm border-0 mx-auto" style="max-width: 900px;">
    <div class="d-flex align-items-center border-bottom pb-3 mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="bi bi-arrow-left"></i></a>
        <h4 class="fw-bold m-0 text-dark">Add New Transportation</h4>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="transportForm">
        <div class="row g-4">
            
            <div class="col-md-6">
                <div class="p-3 rounded-3 bg-primary bg-opacity-10 border border-primary border-opacity-25 h-100">
                    <label class="fw-bold text-primary mb-1">Departure (From)</label>
                    <div class="fw-bold text-dark fs-5 mb-1">@ViewBag.BranchName</div>
                    <small class="text-danger"><i class="bi bi-geo-alt me-1"></i>@ViewBag.BranchAddress</small>
                    <input type="hidden" asp-for="FromBranchId" value="@ViewBag.FromBranchId" />
                </div>
            </div>

            <div class="col-md-6 position-relative">
                <div class="p-3 rounded-3 bg-light border h-100 position-relative">
                    <label class="fw-bold text-dark mb-2">Destination (To) <span class="text-danger">*</span></label>
                    <div class="position-relative">
                        <input type="text" id="spotSearchInput" class="form-control bg-white border mb-1" placeholder="Type destination name..." autocomplete="off" required>
                        <input type="hidden" asp-for="ToSpotId" id="hiddenSpotId" />
                        <div id="spotDropdown" class="custom-dropdown-menu k-card shadow-lg p-0 border"></div>
                    </div>
                    <small class="text-danger d-block mt-1" id="destAddressText"><i class="bi bi-geo-alt me-1"></i>Please select a destination...</small>
                </div>
            </div>

            <div class="col-md-3">
                <label class="fw-bold text-dark mb-2">Transport Type <span class="text-danger">*</span></label>
                <select asp-for="TransportType" class="form-select bg-light border" required>
                    <option value="" disabled selected>-- Select --</option>
                    <option value="Land">🚌 Land</option>
                    <option value="Air">✈️ Air</option>
                    <option value="Water">🛳️ Water</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="fw-bold text-dark mb-2">Fixed Time <span class="text-danger">*</span></label>
                <input asp-for="DepartureTime" class="form-control bg-light border" type="time" required />
            </div>

            <div class="col-md-3">
                <label class="fw-bold text-dark mb-2">Price ($) <span class="text-danger">*</span></label>
                <input asp-for="PriceTransport" id="PriceTransport" class="form-control bg-light border" type="number" min="1" step="any" placeholder="" required />
                <small class="text-danger fw-bold d-none mt-1" id="priceError">Price must be greater than 0.</small>
            </div>

            <div class="col-md-3">
                <label class="fw-bold text-dark mb-2">Total Seats <span class="text-danger">*</span></label>
                <input asp-for="SeatCapacity" id="SeatCapacity" class="form-control bg-light border" type="number" min="1" placeholder="" required />
                <small class="text-danger fw-bold d-none mt-1" id="seatError">Seats must be between 1 and 100.</small>
            </div>

            <div class="col-md-6">
                <label class="fw-bold text-dark mb-2">Transport Name <span class="text-danger">*</span></label>
                <input asp-for="TransportName" class="form-control bg-light border" placeholder="" required />
            </div>

            <div class="col-md-6">
                <label class="fw-bold text-dark mb-2">Additional Details</label>
                <textarea asp-for="Description" class="form-control bg-light border" rows="1" placeholder=""></textarea>
            </div>

            <div class="col-12">
                <div class="p-4 border rounded-4 bg-light text-center">
                    <label class="fw-bold text-primary d-block text-start mb-3"><i class="bi bi-image me-1"></i>Transport Image <span class="text-danger">*</span></label>
                    <input type="file" name="imageFile" id="imageInput" class="form-control w-50 mx-auto bg-white" accept="image/*" required onchange="previewImage(event)" />
                    
                    <div id="previewContainer" class="mt-4 d-none">
                        <div class="preview-box">
                            <button type="button" class="btn-remove-preview" onclick="removeImage()"><i class="bi bi-x"></i></button>
                            <img id="imagePreview" class="img-fluid rounded-3 shadow border" style="max-height: 250px; object-fit: cover;" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 mt-5 text-end border-top pt-4">
                <button type="submit" class="btn btn-primary px-5 py-3 fw-bold rounded-3"><i class="bi bi-save me-2"></i> Save Transportation</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const priceInput = document.getElementById('PriceTransport');
        const seatInput = document.getElementById('SeatCapacity');
        const priceError = document.getElementById('priceError');
        const seatError = document.getElementById('seatError');

        function validatePrice() {
            const val = parseFloat(priceInput.value);
            if (isNaN(val) || val < 1) {
                priceError.classList.remove('d-none');
                priceInput.classList.add('border-danger');
                return false;
            } else {
                priceError.classList.add('d-none');
                priceInput.classList.remove('border-danger');
                return true;
            }
        }

        const transportTypeSelect = document.getElementById('TransportType');

        function validateSeats() {
            const val = parseInt(seatInput.value);
            const maxSeats = transportTypeSelect.value === 'Land' ? 100 : 300;
            if (isNaN(val) || val < 1 || val > maxSeats) {
                seatError.innerText = `Seats must be between 1 and ${maxSeats}.`;
                seatError.classList.remove('d-none');
                seatInput.classList.add('border-danger');
                return false;
            } else {
                seatError.classList.add('d-none');
                seatInput.classList.remove('border-danger');
                return true;
            }
        }

        transportTypeSelect.addEventListener('change', function() {
            const maxSeats = this.value === 'Land' ? 100 : 300;
            seatInput.setAttribute('max', maxSeats);
            if (seatInput.value !== '') validateSeats();
        });

        priceInput.addEventListener('input', validatePrice);
        seatInput.addEventListener('input', validateSeats);

        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('previewContainer').classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            }
        }

        function removeImage() {
            document.getElementById('imageInput').value = '';
            document.getElementById('previewContainer').classList.add('d-none');
            document.getElementById('imagePreview').src = '';
        }

        const spots = [
            @foreach(var s in ViewBag.TouristSpots)
            {
                <text>{ id: @s.SpotId, name: "@Html.Raw(s.SpotName)", address: "@Html.Raw(s.Address)" },</text>
            }
        ];
        const searchInput = document.getElementById('spotSearchInput');
        const dropdown = document.getElementById('spotDropdown');
        const hiddenId = document.getElementById('hiddenSpotId');
        const addressText = document.getElementById('destAddressText');

        function renderDropdown(filterText = "") {
            dropdown.innerHTML = '';
            const lowerFilter = filterText.toLowerCase();

            const filtered = spots.filter(s =>
                (s.name && s.name.toLowerCase().includes(lowerFilter)) ||
                (s.address && s.address.toLowerCase().includes(lowerFilter))
            );

            if (filtered.length === 0) {
                dropdown.innerHTML = '<div class="p-3 text-muted small fst-italic">No spots found.</div>';
            } else {
                filtered.forEach(s => {
                    const item = document.createElement('div');
                    item.className = 'dropdown-item-custom p-3 border-bottom';
                    item.innerHTML = `
                        <div class="fw-bold text-dark fs-6 mb-1">${s.name}</div>
                        <div class="small text-muted"><i class="bi bi-geo-alt text-danger me-1"></i> ${s.address || 'N/A'}</div>
                    `;
                    item.onclick = function() {
                        searchInput.value = s.name;
                        hiddenId.value = s.id;
                        addressText.innerHTML = `<i class="bi bi-geo-alt me-1"></i> ${s.address || 'Address not found'}`;
                        addressText.classList.replace('text-danger', 'text-muted');
                        dropdown.classList.remove('show');
                        
                        searchInput.classList.remove('border-danger');
                    };
                    dropdown.appendChild(item);
                });
            }
            dropdown.classList.add('show');
        }

        searchInput.addEventListener('input', function() {
            hiddenId.value = ''; 
            addressText.innerHTML = '<i class="bi bi-geo-alt me-1"></i> Please select a destination...';
            addressText.classList.replace('text-muted', 'text-danger');
            renderDropdown(this.value);
        });

        searchInput.addEventListener('focus', function() { renderDropdown(this.value); });
        document.addEventListener('click', function(e) { if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) dropdown.classList.remove('show'); });

        document.getElementById('transportForm').addEventListener('submit', function(e) {
            const isPriceValid = validatePrice();
            const isSeatsValid = validateSeats();
            let isValid = true;

            if (!hiddenId.value) {
                alert("Please select a Tourist Spot destination from the dropdown list!");
                searchInput.classList.add('border-danger');
                searchInput.focus();
                isValid = false;
            }

            if (!isPriceValid) { priceInput.focus(); isValid = false; }
            else if (!isSeatsValid) { seatInput.focus(); isValid = false; }

            if (!isValid) e.preventDefault();
        });
    </script>
}