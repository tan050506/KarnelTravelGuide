@model KarnelTravelGuide.Web.Models.Entities.Transportation
@{
    ViewData["Title"] = "Add Transportation Route";
}

<style>
    .preview-box { position: relative; display: inline-block; }
    .btn-remove-preview { position: absolute; top: -10px; right: -10px; width: 25px; height: 25px; padding: 0; background: #fff; color: #dc3545; border-radius: 50%; border: 1px solid #dc3545; display: flex; align-items: center; justify-content: center; font-size: 1rem; cursor: pointer; transition: 0.3s; z-index: 5; }
    .btn-remove-preview:hover { background: #dc3545; color: #fff; transform: scale(1.1); }
</style>

<div class="k-card mx-auto" style="max-width: 900px;">
    <div class="d-flex align-items-center border-bottom pb-3 mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3"><i class="bi bi-arrow-left"></i></a>
        <h4 class="fw-bold m-0 text-dark">Add New Route</h4>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="row g-4">
            
            <div class="col-md-6">
                <div class="p-3 rounded-3 bg-light border h-100">
                    <label class="label-karnel text-muted">Departure (From)</label>
                    <div class="fw-bold text-dark fs-5 mb-1">@ViewBag.BranchName</div>
                    <small class="text-danger"><i class="bi bi-geo-alt"></i> @ViewBag.BranchAddress</small>
                    <input type="hidden" asp-for="FromBranchId" value="@ViewBag.FromBranchId" />
                </div>
            </div>

            <div class="col-md-6">
                <div class="p-3 rounded-3 bg-light border h-100">
                    <label class="label-karnel text-muted">Destination (To) <span class="text-danger">*</span></label>
                    <select asp-for="ToSpotId" class="k-input mb-2" id="spotSelect" onchange="updateAddress()" required>
                        <option value="" data-address="Please select a destination">-- Select Tourist Spot --</option>
                        @foreach (var spot in ViewBag.TouristSpots) {
                            <option value="@spot.SpotId" data-address="@spot.Address">@spot.SpotName</option>
                        }
                    </select>
                    <small class="text-danger" id="destAddressText"><i class="bi bi-geo-alt"></i> Please select a destination...</small>
                </div>
            </div>

            <div class="col-md-3">
                <label class="label-karnel">Transport Type <span class="text-danger">*</span></label>
                <select asp-for="TransportType" class="k-input" required>
                    <option value="">-- Select --</option>
                    <option value="Land">🚌 Land</option>
                    <option value="Air">✈️ Air</option>
                    <option value="Water">🛳️ Water</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="label-karnel">Fixed Time <span class="text-danger">*</span></label>
                <input asp-for="DepartureTime" class="k-input" type="time" required />
            </div>

            <div class="col-md-3">
                <label class="label-karnel">Price (USD) <span class="text-danger">*</span></label>
                <input asp-for="PriceTransport" class="k-input" type="number" min="0" step="1" required />
            </div>

            <div class="col-md-3">
                <label class="label-karnel">Total Seats <span class="text-danger">*</span></label>
                <input asp-for="SeatCapacity" class="k-input" type="number" min="5" max="100" placeholder="e.g. 34" required />
            </div>

            <div class="col-md-6">
                <label class="label-karnel">Transport Name <span class="text-danger">*</span></label>
                <input asp-for="TransportName" class="k-input" placeholder="e.g. Boeing 747, Limousine..." required />
            </div>

            <div class="col-md-6">
                <label class="label-karnel">Additional Details</label>
                <textarea asp-for="Description" class="k-input" rows="1" placeholder="e.g. Free Wi-Fi, AC..."></textarea>
            </div>

            <div class="col-12">
                <div class="p-4 border rounded-4 bg-light text-center">
                    <label class="label-karnel d-block text-start mb-3"><i class="bi bi-image me-1"></i>Transport Image <span class="text-danger">*</span></label>
                    <input type="file" name="imageFile" id="imageInput" class="form-control w-50 mx-auto" accept="image/*" required onchange="previewImage(event)" />
                    
                    <div id="previewContainer" class="mt-4 d-none">
                        <div class="preview-box">
                            <button type="button" class="btn-remove-preview" onclick="removeImage()"><i class="bi bi-x"></i></button>
                            <img id="imagePreview" class="img-fluid rounded-3 shadow border" style="max-height: 250px; object-fit: cover;" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 mt-5 text-end border-top pt-4">
                <button type="submit" class="k-btn-primary px-5 py-3"><i class="bi bi-save me-2"></i> Save Route</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('previewContainer').classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            }
        }

        function removeImage() {
            document.getElementById('imageInput').value = '';
            document.getElementById('previewContainer').classList.add('d-none');
            document.getElementById('imagePreview').src = '';
        }

        function updateAddress() {
            var select = document.getElementById("spotSelect");
            var address = select.options[select.selectedIndex].getAttribute("data-address");
            document.getElementById("destAddressText").innerHTML = '<i class="bi bi-geo-alt"></i> ' + (address ? address : "Address not found");
        }
    </script>
}