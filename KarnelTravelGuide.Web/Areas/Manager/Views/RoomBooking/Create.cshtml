@using KarnelTravelGuide.Web.Models.Entities
@{ 
    ViewData["Title"] = "Find & Book Rooms"; 
    
    var staysList = ViewBag.Stays as IEnumerable<Stay> ?? new List<Stay>();
    var customersList = ViewBag.Customers as IEnumerable<Account> ?? new List<Account>();
    var spotsList = ViewBag.Spots as IEnumerable<TouristSpot> ?? new List<TouristSpot>();
}

<style>
    .custom-dropdown-menu { max-height: 250px; overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1000; width: 100%; display: none; margin-top: 5px; }
    .custom-dropdown-menu.show { display: block; }
    .dropdown-item-custom { transition: background-color 0.2s; cursor: pointer; white-space: normal; }
    .dropdown-item-custom:hover { background-color: #f8f9fa; }
    .btn-remove-customer { transition: all 0.2s; }
    .btn-remove-customer:hover { background-color: #dc3545; color: white !important; }
</style>

<div class="container py-4" style="max-width: 900px;">
    
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3"><i class="bi bi-arrow-left"></i></a>
        <h3 class="fw-bold mb-0 text-dark">Find & Book Rooms</h3>
    </div>

    @if (TempData["ErrorMessage"] != null) { 
        <div class="alert alert-danger rounded-3 fw-bold"><i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]</div> 
    }

    <form asp-action="SelectRoom" method="get" id="managerBookingForm">
        
        <div class="k-card mb-4">
            <h5 class="fw-bold text-dark mb-4 border-bottom pb-3"><i class="bi bi-person-badge text-primary me-2"></i>Customer Information</h5>
            
            <div class="d-flex gap-4 mb-4">
                <div class="form-check">
                    <input class="form-check-input fs-5" type="radio" name="CustomerType" id="typeWalkIn" value="WalkIn" checked onchange="toggleCustomerSelect()">
                    <label class="form-check-label fw-bold mt-1 text-primary" for="typeWalkIn" id="lblWalkIn">Walk-in Customer</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input fs-5" type="radio" name="CustomerType" id="typeMember" value="Member" onchange="toggleCustomerSelect()">
                    <label class="form-check-label fw-bold mt-1 text-muted" for="typeMember" id="lblMember">Existing Member</label>
                </div>
            </div>

            <div id="walkInDiv" class="row g-3">
                <div class="col-md-6">
                    <label class="label-karnel">Full Name <span class="text-danger">*</span></label>
                    <input type="text" name="WalkInName" id="inputWalkInName" class="k-input" placeholder="Enter customer name..." />
                </div>
                <div class="col-md-6">
                    <label class="label-karnel">Phone Number <span class="text-danger">*</span></label>
                    <input type="text" name="WalkInPhone" id="inputWalkInPhone" class="k-input" placeholder="Enter phone number..." />
                </div>
            </div>

            <div id="memberSelectDiv" class="d-none position-relative">
                <label class="label-karnel">Search Existing Account <span class="text-danger">*</span></label>
                <div class="position-relative" id="searchCustomerWrapper">
                    <input type="text" id="customerSearchInput" class="k-input" placeholder="Type phone number or name to search..." autocomplete="off">
                    <div id="customerDropdown" class="custom-dropdown-menu k-card shadow-lg p-0 border"></div>
                </div>
                <div id="selectedCustomerCard" class="d-none p-3 border border-primary rounded-3 bg-primary bg-opacity-10 position-relative mt-2">
                    <button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-2 rounded-circle btn-remove-customer d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; padding: 0;" onclick="clearCustomerSelection()" title="Change Customer">
                        <i class="bi bi-x fs-5"></i>
                    </button>
                    <div class="fw-bold text-primary fs-5 mb-1" id="selCustName">Customer Name</div>
                    <div class="small text-dark fw-bold">
                        <i class="bi bi-telephone-fill text-muted me-1"></i> <span id="selCustPhone">Phone</span>
                        <span class="mx-3 opacity-25">|</span>
                        <i class="bi bi-envelope-fill text-muted me-1"></i> <span id="selCustEmail">Email</span>
                    </div>
                </div>
                <input type="hidden" name="AccountId" id="hiddenAccountId" />
            </div>
        </div>

        <div class="k-card mb-4">
            <h5 class="fw-bold text-dark mb-4 border-bottom pb-3"><i class="bi bi-search text-success me-2"></i>Search Stay</h5>
            
            <div class="row g-4">
                <div class="col-md-12 position-relative">
                    <label class="label-karnel">Destination (Tourist Spot)</label>
                    <div class="position-relative">
                        <input type="text" id="spotSearchInput" class="k-input bg-light" placeholder="Type destination name..." autocomplete="off">
                        <input type="hidden" id="searchSpot" />
                        <div id="spotDropdown" class="custom-dropdown-menu k-card shadow-lg p-0 border"></div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="label-karnel">Stay Type</label>
                    <select id="searchStayType" class="k-input bg-light">
                        <option value="">All Types</option>
                        <option value="Hotel">🏢 Hotel</option>
                        <option value="Resort">🏖️ Resort</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="label-karnel">Room Type</label>
                    <select id="searchRoomType" class="k-input bg-light">
                        <option value="">All Room Types</option>
                        <option value="Standard">Standard</option>
                        <option value="VIP">VIP</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="label-karnel">Check-in Date <span class="text-danger">*</span></label>
                    <input type="date" name="CheckIn" id="checkInDate" class="k-input bg-light" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-6">
                    <label class="label-karnel">Check-out Date <span class="text-danger">*</span></label>
                    <input type="date" name="CheckOut" id="checkOutDate" class="k-input bg-light" min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-12 mt-4 text-end">
                    <button type="button" class="k-btn-primary px-5 py-3 w-100" onclick="filterStays()"><i class="bi bi-search me-2"></i> Find Available Stays</button>
                </div>
            </div>
        </div>

        <div id="stayResultsContainer"></div>
        <input type="hidden" name="StayId" id="hiddenStayId" />
    </form>
</div>

@section Scripts {
    <script>
        // --- 1. JS TÌM KIẾM KHÁCH HÀNG ---
        const customers = [
            @foreach(var acc in customersList) { <text>{ id: @acc.AccountId, name: "@Html.Raw(acc.FullName)", phone: "@Html.Raw(acc.PhoneNumber)", email: "@Html.Raw(acc.Email)" },</text> }
        ];
        const searchInput = document.getElementById('customerSearchInput');
        const dropdown = document.getElementById('customerDropdown');
        const hiddenId = document.getElementById('hiddenAccountId');
        const searchWrapper = document.getElementById('searchCustomerWrapper');
        const selectedCard = document.getElementById('selectedCustomerCard');

        function renderCustomerDropdown(filterText = "") {
            dropdown.innerHTML = '';
            const lowerFilter = filterText.toLowerCase();
            const filtered = customers.filter(c => (c.name && c.name.toLowerCase().includes(lowerFilter)) || (c.phone && c.phone.includes(lowerFilter)));

            if (filtered.length === 0) {
                dropdown.innerHTML = '<div class="p-3 text-muted small fst-italic">No customers found.</div>';
            } else {
                filtered.forEach(c => {
                    const item = document.createElement('div');
                    item.className = 'dropdown-item-custom p-3 border-bottom';
                    item.innerHTML = `<div class="fw-bold text-dark fs-6 mb-1">${c.name}</div><div class="small text-muted"><i class="bi bi-telephone-fill text-primary me-1"></i> ${c.phone}</div>`;
                    item.onclick = function() {
                        hiddenId.value = c.id;
                        document.getElementById('selCustName').innerText = c.name;
                        document.getElementById('selCustPhone').innerText = c.phone;
                        document.getElementById('selCustEmail').innerText = c.email || 'N/A';
                        searchWrapper.classList.add('d-none');
                        selectedCard.classList.remove('d-none');
                        dropdown.classList.remove('show');
                    };
                    dropdown.appendChild(item);
                });
            }
            dropdown.classList.add('show');
        }

        function clearCustomerSelection() { hiddenId.value = ''; searchInput.value = ''; searchWrapper.classList.remove('d-none'); selectedCard.classList.add('d-none'); searchInput.focus(); }
        searchInput.addEventListener('input', function() { renderCustomerDropdown(this.value); });
        searchInput.addEventListener('focus', function() { renderCustomerDropdown(this.value); });
        document.addEventListener('click', function(e) { if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) dropdown.classList.remove('show'); });

        function toggleCustomerSelect() {
            var isMember = document.getElementById("typeMember").checked;
            document.getElementById("walkInDiv").className = isMember ? "d-none" : "row g-3";
            document.getElementById("memberSelectDiv").className = isMember ? "d-block position-relative" : "d-none position-relative";
            document.getElementById("lblWalkIn").classList.toggle("text-muted", isMember);
            document.getElementById("lblWalkIn").classList.toggle("text-primary", !isMember);
            document.getElementById("lblMember").classList.toggle("text-muted", !isMember);
            document.getElementById("lblMember").classList.toggle("text-primary", isMember);
        }

        // --- 2. JS TÌM KIẾM ĐỊA ĐIỂM ---
        const spotsData = [ @foreach(var s in spotsList) { <text>{ id: @s.SpotId, name: "@Html.Raw(s.SpotName)" },</text> } ];
        const spotInput = document.getElementById('spotSearchInput'); const spotDropdown = document.getElementById('spotDropdown'); const hiddenSpotId = document.getElementById('searchSpot');

        function renderSpotDropdown(filterText = "") {
            spotDropdown.innerHTML = '';
            const lowerFilter = filterText.toLowerCase();
            const filtered = spotsData.filter(s => s.name.toLowerCase().includes(lowerFilter));

            const anyItem = document.createElement('div');
            anyItem.className = 'dropdown-item-custom p-3 border-bottom text-primary fw-bold';
            anyItem.innerText = "All Destinations (Anywhere)";
            anyItem.onclick = function() { hiddenSpotId.value = ""; spotInput.value = ""; spotDropdown.classList.remove('show'); };
            spotDropdown.appendChild(anyItem);

            if (filtered.length === 0) {
                spotDropdown.innerHTML += '<div class="p-3 text-muted small fst-italic">No destinations found.</div>';
            } else {
                filtered.forEach(s => {
                    const item = document.createElement('div');
                    item.className = 'dropdown-item-custom p-3 border-bottom fw-bold text-dark';
                    item.innerText = s.name;
                    item.onclick = function() { hiddenSpotId.value = s.id; spotInput.value = s.name; spotDropdown.classList.remove('show'); };
                    spotDropdown.appendChild(item);
                });
            }
            spotDropdown.classList.add('show');
        }

        spotInput.addEventListener('input', function() { hiddenSpotId.value = ''; renderSpotDropdown(this.value); });
        spotInput.addEventListener('focus', function() { renderSpotDropdown(this.value); });
        document.addEventListener('click', function(e) { if (!spotInput.contains(e.target) && !spotDropdown.contains(e.target)) spotDropdown.classList.remove('show'); });

        // --- 3. JS LỌC KHÁCH SẠN ---
        const allStays = [
            @foreach(var s in staysList) {
                var types = s.Rooms != null ? string.Join(",", s.Rooms.Select(r => r.RoomType).Distinct()) : "";
                <text>
                {
                    id: @s.StayId,
                    name: "@Html.Raw(s.Name)",
                    type: "@Html.Raw(s.StayType)",
                    spotId: "@s.SpotId",
                    spotName: "@Html.Raw(s.Spot?.SpotName)",
                    minPrice: @(s.Rooms != null && s.Rooms.Any() ? (s.Rooms.Min(r => r.PriceRoom) ?? 0) : 0),
                    roomCount: @(s.Rooms?.Count() ?? 0),
                    roomTypes: "@Html.Raw(types)",
                    imageUrl: "@Html.Raw(string.IsNullOrEmpty(s.ImageUrl) ? "/img/no-image.jpg" : s.ImageUrl)"
                },
                </text>
            }
        ];

        function filterStays() {
            const spotId = hiddenSpotId.value;
            const stayType = document.getElementById('searchStayType').value;
            const roomType = document.getElementById('searchRoomType').value;
            const dateIn = document.getElementById('checkInDate').value;
            const dateOut = document.getElementById('checkOutDate').value;

            if (!dateIn || !dateOut) { alert("Please select both Check-in and Check-out dates!"); return; }
            if (dateOut <= dateIn) { alert("Check-out date must be after Check-in date!"); return; }

            const results = allStays.filter(s => { 
                let matchSpot = !spotId || s.spotId == spotId;
                let matchStayType = !stayType || s.type == stayType;
                let matchRoomType = !roomType || s.roomTypes.includes(roomType);
                return matchSpot && matchStayType && matchRoomType;
            });

            const container = document.getElementById('stayResultsContainer');
            container.innerHTML = '<h5 class="fw-bold mb-3 mt-4 text-dark"><i class="bi bi-list-check text-primary me-2"></i>Available Stays</h5>';
            
            if (results.length === 0) {
                container.innerHTML += '<div class="k-card text-center py-5 text-muted"><i class="bi bi-building-x fs-1"></i><p class="mt-2 fw-bold">No matching stays found.</p></div>';
                return;
            }

            results.forEach(s => {
                container.innerHTML += `
                <div class="k-card mb-3 p-4 border border-primary border-opacity-10 transition-all hover-scale cursor-pointer">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <img src="${s.imageUrl}" style="width: 80px; height: 60px; object-fit: cover; border-radius: 8px;" class="me-3 border shadow-sm" />
                            <div>
                                <h5 class="mb-1 fw-bold text-dark">${s.name}</h5>
                                <span class="badge bg-light text-dark border me-2">${s.type}</span>
                                <small class="text-muted fw-bold"><i class="bi bi-geo-alt-fill text-danger"></i> ${s.spotName}</small>
                            </div>
                        </div>
                        <div class="text-end">
                            <small class="text-muted d-block fw-bold">From</small>
                            <h4 class="text-success fw-bold mb-2">$${s.minPrice.toLocaleString('en-US')} <small class="text-muted fs-6">/ night</small></h4>
                            <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" onclick="selectStay(${s.id})">Select Rooms</button>
                        </div>
                    </div>
                </div>`;
            });
        }

        function selectStay(id) {
            var isMember = document.getElementById("typeMember").checked;
            if (!isMember) {
                if (!document.getElementById("inputWalkInName").value || !document.getElementById("inputWalkInPhone").value) {
                    alert("Please enter full name and phone number for walk-in customer!"); return;
                }
            } else {
                if (!document.getElementById("hiddenAccountId").value) {
                    alert("Please select a customer account first!"); return;
                }
            }
            document.getElementById('hiddenStayId').value = id;
            document.getElementById('managerBookingForm').submit();
        }
    </script>
}