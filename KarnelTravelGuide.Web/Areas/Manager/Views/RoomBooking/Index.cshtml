@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.Order>
@{ 
    ViewData["Title"] = "Room Booking Management"; 
    
    // Logic đếm số thứ tự (1, 2, 3...)
    int totalCount = Model?.Count() ?? 0;
    bool isDescending = ViewData["CurrentSort"]?.ToString() == "id_desc";
    int displayIndex = isDescending ? totalCount : 1;
}

<style>
    /* Chỉnh style cho nút Action hình tròn y hệt mẫu */
    .action-btn { width: 32px; height: 32px; padding: 0; line-height: 30px; display: inline-flex; align-items: center; justify-content: center; }
</style>

<div class="k-card p-4 bg-white rounded-4 shadow-sm border-0">
    
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3">
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control bg-light border" style="min-width: 250px; border-radius: 0.5rem;" placeholder="Customer name or phone...">
            
            <div class="input-group" style="max-width: 200px;">
                <input type="date" name="checkInDate" value="@ViewData["CurrentDate"]" class="form-control bg-light border" style="border-radius: 0.5rem;">
            </div>
            
            <button type="submit" class="btn btn-primary" style="border-radius: 0.5rem; width: 45px;"><i class="bi bi-search"></i></button>
            
            @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()) || !string.IsNullOrEmpty(ViewData["CurrentDate"]?.ToString())) {
                <a asp-action="Index" class="btn btn-light border text-muted" style="border-radius: 0.5rem;">Clear</a>
            }
        </form>

        <a asp-action="Create" class="btn btn-primary fw-bold px-4" style="border-radius: 0.5rem;"><i class="bi bi-plus-lg me-2"></i> Walk-in Booking</a>
    </div>

    @if (TempData["SuccessMessage"] != null) {
        <div class="alert alert-success rounded-3 fw-bold"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
    }

    <div class="table-responsive">
        <table class="table align-middle table-hover table-borderless">
            <thead class="border-bottom text-dark small fw-bold text-uppercase">
                <tr>
                    <th style="width: 5%; text-align: center;">
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["IdSortParm"]" class="text-dark text-decoration-none"><i class="bi bi-arrow-down-up"></i></a>
                    </th>
                    <th style="width: 20%;">CUSTOMER</th>
                    <th style="width: 25%;">STAY & ROOM</th>
                    <th style="width: 15%;">DATES</th>
                    <th style="width: 10%;">TOTAL</th>
                    <th style="width: 10%;">STATUS</th>
                    <th style="width: 15%; text-align: center;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any()) {
                    foreach (var item in Model) {
                        var roomDetail = item.OrderDetails?.FirstOrDefault()?.RoomBooking;
                        if (roomDetail == null) continue;

                        <tr class="border-bottom">
                            <td class="fw-bold text-dark fs-6 text-center">@displayIndex</td>
                            
                            <td>
                                <div class="fw-bold text-dark mb-1">@item.Account?.FullName</div>
                                <div class="small fw-bold text-primary"><i class="bi bi-telephone text-primary me-1"></i>@item.Account?.PhoneNumber</div>
                            </td>
                            
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1 mb-1">@roomDetail.NumberOfRooms x @roomDetail.Room?.RoomType</span>
                                <div class="fw-bold text-dark mt-1 text-truncate" style="max-width: 220px;" title="@roomDetail.Room?.Stay?.Name">@roomDetail.Room?.Stay?.Name</div>
                            </td>
                            
                            <td>
                                <div class="small fw-bold"><span class="text-success">In:</span> @(roomDetail.CheckInDate.HasValue ? roomDetail.CheckInDate.Value.ToString("dd/MM/yyyy") : "N/A")</div>
                                <div class="small fw-bold"><span class="text-danger">Out:</span> @(roomDetail.CheckOutDate.HasValue ? roomDetail.CheckOutDate.Value.ToString("dd/MM/yyyy") : "N/A")</div>
                            </td>
                            <td class="fw-bold text-dark fs-6">$@((item.TotalAmount ?? 0).ToString("N0"))</td>
                            
                            <td>
                                @if(item.Status == "Confirmed") { <span class="badge bg-success rounded-pill px-3 py-2">Confirmed</span> }
                                else if(item.Status == "Canceled") { <span class="badge bg-danger rounded-pill px-3 py-2">Canceled</span> }
                                else { <span class="badge bg-warning text-dark rounded-pill px-3 py-2">Pending</span> }
                            </td>
                            
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-outline-info rounded-circle action-btn" title="View Details"><i class="bi bi-eye"></i></a>
                                    
                                    @if (item.Status == "Pending") {
                                        <form asp-action="ConfirmBooking" method="post" class="d-inline" onsubmit="return confirm('Confirm this booking?');">
                                            <input type="hidden" name="orderId" value="@item.OrderId" />
                                            <button type="submit" class="btn btn-outline-success rounded-circle action-btn" title="Confirm"><i class="bi bi-check-lg"></i></button>
                                        </form>
                                    }

                                    @if (item.Status == "Pending" || item.Status == "Confirmed") {
                                        <form asp-action="CancelOrder" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this booking? Rooms will be released.');">
                                            <input type="hidden" name="orderId" value="@item.OrderId" />
                                            <button type="submit" class="btn btn-outline-danger rounded-circle action-btn" title="Cancel"><i class="bi bi-x-lg"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                        if (isDescending) { displayIndex--; } else { displayIndex++; }
                    }
                } else {
                    <tr><td colspan="7" class="text-center py-5 text-muted fw-bold">No room bookings found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>