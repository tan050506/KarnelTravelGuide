<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Manager Portal | Karnel Travel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* NEW DASHBOARD LAYOUT */
        body { background-color: var(--k-bg-light); overflow-x: hidden; }
        
        .k-sidebar { width: 260px; height: 100vh; position: fixed; top: 0; left: 0; background-color: var(--k-sidebar-bg); color: #94a3b8; z-index: 1050; overflow-y: auto; transition: transform 0.3s ease; }
        
        .k-sidebar-brand { padding: 24px; border-bottom: 1px solid rgba(255,255,255,0.05); margin-bottom: 16px; }
        .k-sidebar-brand h5 { color: #ffffff; font-weight: 800; letter-spacing: 1px; }
        
        .k-sidebar-nav { padding: 0 16px; display: flex; flex-direction: column; gap: 4px; }
        .k-sidebar-nav a { color: #94a3b8; text-decoration: none; padding: 12px 16px; border-radius: 10px; display: flex; align-items: center; font-weight: 500; transition: 0.2s; }
        .k-sidebar-nav a:hover { background-color: var(--k-sidebar-hover); color: #ffffff; }
        .k-sidebar-nav a.active { background-color: var(--k-primary); color: #ffffff; box-shadow: 0 4px 12px rgba(0, 97, 230, 0.3); }
        .k-sidebar-nav a i { font-size: 1.2rem; margin-right: 12px; }
        
        .k-section-title { font-size: 0.75rem; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 1px; margin: 20px 0 8px 16px; }

        .k-main-wrapper { margin-left: 260px; min-height: 100vh; display: flex; flex-direction: column; transition: margin-left 0.3s ease; }
        .k-topbar { background-color: #ffffff; height: 80px; padding: 0 32px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--k-border); position: sticky; top: 0; z-index: 999; }
        .k-content { padding: 32px; flex-grow: 1; max-width: 1400px; width: 100%; margin: 0 auto; }

        .sidebar-overlay { 
            display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 1040; opacity: 0; transition: opacity 0.3s ease; 
        }
        .sidebar-overlay.show { display: block; opacity: 1; }

        @@media (max-width: 991.98px) {
            .k-sidebar { transform: translateX(-100%); }
            .k-sidebar.show { transform: translateX(0); }
            .k-main-wrapper { margin-left: 0; }
        }
    </style>
</head>
<body>
    
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="k-sidebar" id="kSidebar">
        <div class="k-sidebar-brand text-center">
            <h5 class="m-0"><i class="bi bi-briefcase-fill text-primary me-2"></i>MANAGER</h5>
            <small>Karnel Travel System</small>
        </div>
        
        <nav class="k-sidebar-nav pb-4">
            <a asp-area="Manager" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            
            <a asp-area="Manager" asp-controller="TouristSpot" asp-action="Index"><i class="bi bi-geo-alt-fill"></i> Tourist Spot</a>
            <a asp-area="Manager" asp-controller="Transportation" asp-action="Index"><i class="bi bi-bus-front-fill"></i> Transportation</a>
            <a asp-area="Manager" asp-controller="Stay" asp-action="Index"><i class="bi bi-buildings-fill"></i> Stay</a>
            <a asp-area="Manager" asp-controller="Restaurant" asp-action="Index"><i class="bi bi-shop-window"></i> Restaurant</a>

            <a asp-area="Manager" asp-controller="RoomBooking" asp-action="Index"><i class="bi bi-door-open-fill"></i> Room Booking</a>
            <a asp-area="Manager" asp-controller="TableBooking" asp-action="Index"><i class="bi bi-cup-hot-fill"></i> Table Booking</a>
            <a asp-area="Manager" asp-controller="TicketBooking" asp-action="Index"><i class="bi bi-ticket-detailed-fill"></i> Ticket Booking</a>

            <a asp-area="Manager" asp-controller="Invoice" asp-action="Index"><i class="bi bi-receipt-cutoff text-warning"></i> Invoice</a>
            <a asp-area="Manager" asp-controller="Feedback" asp-action="Index"><i class="bi bi-chat-right-text-fill"></i> Feedback</a>
            
            <div class="mt-4 border-top pt-3" style="border-color: rgba(255,255,255,0.05) !important;">
                <a href="/Account/Logout" class="text-danger"><i class="bi bi-box-arrow-left"></i> Logout</a>
            </div>
        </nav>
    </aside>

    <div class="k-main-wrapper">
        <header class="k-topbar">
            <div class="d-flex align-items-center gap-2">
                <button id="sidebarToggle" class="btn btn-light d-lg-none shadow-sm border-0 me-2" style="padding: 6px 12px;">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <h4 class="m-0 fw-bold text-dark d-none d-sm-block">@ViewData["Title"]</h4>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill fw-bold">
                    <i class="bi bi-circle-fill small me-2"></i>@(Context.Session.GetString("UserName") ?? "Manager Online")
                </span>
            </div>
        </header>
        
        <main class="k-content">
            @RenderBody()
        </main>
        
        <footer class="text-center py-4 text-muted small mt-auto border-top">
            &copy; 2026 Karnel Travel Manager Portal
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#sidebarToggle').on('click', function() {
                $('#kSidebar').toggleClass('show');
                $('#sidebarOverlay').toggleClass('show');
            });

            $('#sidebarOverlay').on('click', function() {
                $('#kSidebar').removeClass('show');
                $('#sidebarOverlay').removeClass('show');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>