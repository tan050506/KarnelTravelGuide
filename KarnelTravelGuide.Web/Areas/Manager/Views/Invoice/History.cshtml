@model IEnumerable<KarnelTravelGuide.Web.Areas.Manager.Controllers.HistoryGroupViewModel>
@{ 
    ViewData["Title"] = "Payment History"; 
    int totalItems = ViewBag.TotalItems ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
}

<style>
    .sort-icon { cursor: pointer; color: #6c757d; transition: 0.2s; }
    .sort-icon:hover { color: #0d6efd; }
</style>

<div class="k-card p-4 bg-white rounded-4 shadow-sm border-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <h4 class="fw-bold m-0 text-dark"><i class="bi bi-clock-history text-secondary me-2"></i>Payment History</h4>
        
        <div class="d-flex gap-3">
            <form asp-action="History" method="get" class="d-flex gap-2">
                <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control bg-light border" style="min-width: 250px; border-radius: 0.5rem;" placeholder="Search customer info...">
                <button type="submit" class="btn btn-primary" style="border-radius: 0.5rem;"><i class="bi bi-search"></i></button>
            </form>
            <a asp-action="Index" class="btn btn-outline-primary fw-bold px-4" style="border-radius: 0.5rem;"><i class="bi bi-arrow-left me-2"></i>Back to Pending</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null) {
        <div class="alert alert-success rounded-3 fw-bold mb-4"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
    }

    <div class="table-responsive mb-2">
        <table class="table align-middle table-hover table-borderless">
            <thead class="bg-light border-bottom text-dark small fw-bold text-uppercase">
                <tr>
                    <th style="width: 5%; text-align: center;">
                        <a asp-action="History" asp-route-sortOrder="@ViewData["IdSortParm"]" class="text-dark text-decoration-none">
                            <i class="bi bi-arrow-down-up fs-5 sort-icon" title="Reverse Sort"></i>
                        </a>
                    </th>
                    <th style="width: 25%;">Transaction Date</th>
                    <th style="width: 20%; text-align: center;">Total Customers</th>
                    <th style="width: 20%; text-align: center;">Processed Bills</th>
                    <th style="width: 15%; text-align: end;">Daily Revenue</th>
                    <th style="width: 15%; text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any()) {
                    int idx = (currentPage - 1) * pageSize + 1;
                    foreach (var item in Model) {
                        <tr class="border-bottom">
                            <td class="text-center fw-bold text-secondary">@idx</td>
                            <td><div class="fw-bold text-dark fs-6"><i class="bi bi-calendar-check text-primary me-2"></i>@item.Date.ToString("dd/MM/yyyy")</div></td>
                            <td class="text-center fw-bold text-muted">@item.TotalCustomers Customers</td>
                            <td class="text-center"><span class="badge bg-info text-dark rounded-pill px-3 py-2">@item.TotalInvoices Invoices</span></td>
                            <td class="text-end fw-bold text-success fs-5">$@item.TotalRevenue.ToString("0.##")</td>
                            <td class="text-center">
                                <a asp-action="DailyDetails" asp-route-dateStr="@item.Date.ToString("yyyy-MM-dd")" class="btn btn-outline-primary rounded-pill px-4 fw-bold btn-sm shadow-sm">View Details</a>
                            </td>
                        </tr>
                        idx++;
                    }
                } else {
                    <tr><td colspan="6" class="text-center py-5 text-muted fw-bold">No invoice history found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1) {
        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
            <div class="text-muted small fw-bold">Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, totalItems)) of @totalItems entries</div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")"><a class="page-link px-3" asp-action="History" asp-route-page="@(currentPage - 1)" asp-route-searchString="@ViewData["CurrentSearch"]">Prev</a></li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++) {
                        <li class="page-item @(currentPage == i ? "active" : "")"><a class="page-link" asp-action="History" asp-route-page="@i" asp-route-searchString="@ViewData["CurrentSearch"]">@i</a></li>
                    }
                    <li class="page-item @(currentPage == ViewBag.TotalPages ? "disabled" : "")"><a class="page-link px-3" asp-action="History" asp-route-page="@(currentPage + 1)" asp-route-searchString="@ViewData["CurrentSearch"]">Next</a></li>
                </ul>
            </nav>
        </div>
    }
</div>