@model IEnumerable<KarnelTravelGuide.Web.Areas.Manager.Controllers.PendingBillViewModel>
@{ 
    ViewData["Title"] = "Pending Payments"; 
    int totalItems = ViewBag.TotalItems ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
}

<style>
    .sort-icon { cursor: pointer; color: #6c757d; transition: 0.2s; }
    .sort-icon:hover { color: #0d6efd; }
</style>

<div class="k-card p-4 bg-white rounded-4 shadow-sm border-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <h4 class="fw-bold m-0 text-dark"><i class="bi bi-hourglass-split text-warning me-2"></i>Pending Payments</h4>
        
        <div class="d-flex gap-3">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control bg-light border" style="min-width: 250px; border-radius: 0.5rem;" placeholder="Search customer info...">
                <button type="submit" class="btn btn-primary" style="border-radius: 0.5rem;"><i class="bi bi-search"></i></button>
            </form>
            <a asp-action="History" class="btn btn-outline-secondary fw-bold px-4" style="border-radius: 0.5rem;"><i class="bi bi-clock-history me-2"></i>View History</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null) {
        <div class="alert alert-success rounded-3 fw-bold mb-4"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null) {
        <div class="alert alert-danger rounded-3 fw-bold mb-4"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]</div>
    }

    <div class="table-responsive">
        <table class="table align-middle table-hover table-borderless">
            <thead class="bg-light border-bottom text-dark small fw-bold text-uppercase">
                <tr>
                    <th style="width: 5%; text-align: center;">
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["IdSortParm"]" asp-route-searchString="@ViewData["CurrentSearch"]" class="text-dark text-decoration-none">
                            <i class="bi bi-arrow-down-up fs-5 sort-icon" title="Reverse Sort"></i>
                        </a>
                    </th>
                    <th style="width: 25%;">Customer Info</th>
                    <th style="width: 20%;">Order Date & Time</th>
                    <th style="width: 20%; text-align: center;">Distinct Services</th>
                    <th style="width: 15%; text-align: end;">Est. Total</th>
                    <th style="width: 15%; text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any()) {
                    int idx = (currentPage - 1) * pageSize + 1;
                    foreach (var group in Model) {
                        <tr class="border-bottom">
                            <td class="text-center fw-bold text-secondary">@idx</td>
                            <td>
                                <div class="fw-bold text-dark">@group.Account?.FullName</div>
                                <div class="small fw-bold text-primary"><i class="bi bi-telephone me-1"></i>@group.Account?.PhoneNumber</div>
                            </td>
                            <td>
                                <div class="small fw-bold text-dark"><i class="bi bi-calendar-event text-secondary me-1"></i>@(group.OrderDate?.ToString("dd/MM/yyyy"))</div>
                                <div class="small fw-bold text-danger mt-1"><i class="bi bi-clock text-secondary me-1"></i>@(group.OrderDate?.ToString("HH:mm"))</div>
                            </td>
                            <td class="text-center"><span class="badge bg-warning text-dark px-3 py-2 rounded-pill">@group.TotalServices Services</span></td>
                            <td class="text-end fw-bold text-dark fs-5">$@group.SubTotal.ToString("0.##")</td>
                            <td class="text-center">
                                <a asp-action="CustomerBill" asp-route-accountId="@group.Account?.AccountId" asp-route-orderDateStr="@group.OrderDate?.ToString("yyyy-MM-dd HH:mm")" class="btn btn-primary btn-sm px-3 rounded-pill fw-bold">View & Pay</a>
                            </td>
                        </tr>
                        idx++;
                    }
                } else {
                    <tr><td colspan="6" class="text-center py-5 text-muted fw-bold">No pending payments found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1) {
        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
            <div class="text-muted small fw-bold">Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, totalItems)) of @totalItems entries</div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")"><a class="page-link px-3" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-sortOrder="@ViewData["CurrentSort"]">Prev</a></li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++) {
                        <li class="page-item @(currentPage == i ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-sortOrder="@ViewData["CurrentSort"]">@i</a></li>
                    }
                    <li class="page-item @(currentPage == ViewBag.TotalPages ? "disabled" : "")"><a class="page-link px-3" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-sortOrder="@ViewData["CurrentSort"]">Next</a></li>
                </ul>
            </nav>
        </div>
    }
</div>