@model KarnelTravelGuide.Web.Models.Entities.Stay
@{ ViewData["Title"] = "Stay Details"; }

<div class="k-card mx-auto" style="max-width: 900px;">
    <div class="d-flex align-items-center border-bottom pb-3 mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3"><i class="bi bi-arrow-left"></i></a>
        <h4 class="fw-bold m-0 text-dark">Stay Details</h4>
        <div class="ms-auto">
            <span class="badge @(Model.StayType == "Hotel" ? "bg-primary" : "bg-success") px-3 py-2 fs-6">
                @(Model.StayType == "Hotel" ? "🏢 Hotel" : "🏖️ Resort")
            </span>
        </div>
    </div>

    <div class="row align-items-start mb-4">
        <div class="col-md-5 mb-4 mb-md-0">
            @if (!string.IsNullOrEmpty(Model.ImageUrl)) {
                <img src="@Model.ImageUrl" class="img-fluid rounded-4 shadow-sm border w-100" style="height: 300px; object-fit: cover;" />
            } else {
                <div class="bg-light rounded-4 d-flex align-items-center justify-content-center border w-100" style="height: 300px;">
                    <div class="text-muted text-center"><i class="bi bi-image text-secondary d-block mb-2" style="font-size: 3rem;"></i><span>No Image</span></div>
                </div>
            }
        </div>
        
        <div class="col-md-7 ps-md-4">
            <div class="p-3 bg-light rounded-4 border mb-4">
                <div class="mb-3">
                    <span class="d-block small text-muted text-uppercase fw-bold">Tourist Spot (Location)</span>
                    <h5 class="fw-bold text-primary mb-0">@(Model.Spot?.SpotName ?? "N/A")</h5>
                </div>
                <div>
                    <span class="d-block small text-muted text-uppercase fw-bold">Address</span>
                    <small class="text-danger fw-bold"><i class="bi bi-geo-alt"></i> @Model.Address</small>
                </div>
            </div>

            <h4 class="fw-bold text-dark mb-4">@Model.Name</h4>

            <div class="mb-4">
                <span class="text-muted small fw-bold me-2">Feedback Rating:</span>
                @if(Model.StarRating != null && Model.StarRating > 0) {
                    <span class="text-warning fs-5">@for(int i=0; i < Model.StarRating; i++) { <i class="bi bi-star-fill"></i> }</span>
                } else {
                    <span class="text-muted fst-italic small">No ratings yet</span>
                }
            </div>
            
            <h6 class="label-karnel mt-3">Overview Description:</h6>
            <p class="text-dark lh-lg" style="white-space: pre-line;">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>
        </div>
    </div>

    <div class="border rounded-4 bg-light p-4 mb-4">
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-door-open-fill text-primary me-2"></i>Room Types Available</h5>
        <div class="table-responsive">
            <table class="table table-bordered bg-white align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Room Type</th>
                        <th>Price / Night</th>
                        <th>Total Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model.Rooms != null && Model.Rooms.Any()) {
                        foreach(var room in Model.Rooms) {
                            <tr>
                                <td class="fw-bold text-dark">@room.RoomType</td>
                                <td class="fw-bold text-success">$@room.PriceRoom?.ToString("N0")</td>
                                <td>@room.Quantity rooms</td>
                            </tr>
                        }
                    } else {
                        <tr><td colspan="3" class="text-center text-muted fst-italic py-3">No rooms configured.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4 pt-4 border-top text-end">
        <a asp-action="Edit" asp-route-id="@Model.StayId" class="k-btn-primary me-2"><i class="bi bi-pencil-square me-2"></i> Edit Stay & Rooms</a>
        <a asp-action="Delete" asp-route-id="@Model.StayId" class="btn btn-danger fw-bold py-2 px-4 rounded-3"><i class="bi bi-trash me-2"></i> Delete</a>
    </div>
</div>