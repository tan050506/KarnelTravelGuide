@model KarnelTravelGuide.Web.Models.Entities.Stay
@{ ViewData["Title"] = "Delete Stay"; }

<div class="k-card p-4 bg-white shadow-sm mx-auto" style="max-width: 600px; border-radius: 1rem; border: 2px solid #dc3545 !important;">
    <div class="p-2 text-center">
        <div class="mb-4">
            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Delete this Stay?</h3>
        <p class="text-muted mb-4">You are about to delete <strong>@Model.Name</strong>. This action will also delete all its <strong>@Model.Rooms.Count() room types</strong>. This cannot be undone.</p>

        <div class="bg-light p-4 rounded-4 text-start mb-5 border">
            <div class="d-flex align-items-center mb-4">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/img/no-image.jpg" : Model.ImageUrl)" style="width: 80px; height: 80px; object-fit: cover;" class="me-3 shadow-sm border rounded-3" />
                <div>
                    <h5 class="fw-bold text-primary mb-1">@Model.Name</h5>
                    <span class="badge @(Model.StayType == "Hotel" ? "bg-primary" : "bg-success") bg-opacity-10 text-@(Model.StayType == "Hotel" ? "primary" : "success") border border-@(Model.StayType == "Hotel" ? "primary" : "success") border-opacity-25 px-3 py-1 rounded-pill">@Model.StayType</span>
                </div>
            </div>
            
            <div class="mb-3">
                <small class="text-muted fw-bold d-block">Tourist Spot:</small>
                <span class="text-dark small fw-bold">@(Model.Spot?.SpotName ?? "N/A")</span>
            </div>
            <div class="mb-2">
                <small class="text-muted fw-bold d-block">Exact Address:</small>
                <span class="text-dark small"><i class="bi bi-geo-alt text-danger me-1"></i>@Model.Address</span>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="StayId" />
            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Index" class="btn btn-light border px-4 py-2 fw-bold rounded-3">No, Cancel</a>
                <button type="submit" class="btn btn-danger px-4 py-2 fw-bold rounded-3"><i class="bi bi-trash me-2"></i> Yes, Delete it!</button>
            </div>
        </form>
    </div>
</div>