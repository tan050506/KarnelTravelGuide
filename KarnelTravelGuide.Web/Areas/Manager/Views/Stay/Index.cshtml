@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.Stay>
@{ ViewData["Title"] = "Manage Stays"; }

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 flex-wrap">
        <h5 class="mb-0 fw-bold text-secondary flex-shrink-0"><i class="bi bi-buildings me-2"></i>Stay List</h5>
        
        <form asp-action="Index" method="get" class="d-flex mx-auto my-2 my-md-0" style="width: 100%; max-width: 400px;">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control me-2" placeholder="Search by stay name or spot...">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
            <a asp-action="Index" class="btn btn-light ms-1" title="Clear"><i class="bi bi-x-circle"></i></a>
        </form>

        <a asp-action="Create" class="btn btn-primary btn-sm flex-shrink-0"><i class="bi bi-plus-lg"></i> Add New Stay</a>
    </div>
    
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Tourist Spot</th>
                        <th>Type</th>
                        <th>Rating</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                    <tr>
                        <td class="fw-bold text-muted">#@item.StayId</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl)) {
                                <img src="@item.ImageUrl" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" />
                            } else {
                                <div class="bg-secondary text-white d-flex justify-content-center align-items-center rounded" style="width: 60px; height: 60px;">No Img</div>
                            }
                        </td>
                        <td class="fw-semibold">@item.Name</td>
                        <td>@(item.Spot?.SpotName ?? "N/A")</td>
                        <td><span class="badge bg-info text-dark">@item.StayType</span></td>
                        <td>
                            @if(item.StarRating != null && item.StarRating > 0) {
                                @for(int i=0; i < item.StarRating; i++) { <i class="bi bi-star-fill text-warning"></i> }
                            } else {
                                <span class="text-muted small">No feedback</span>
                            }
                        </td>
                        <td class="text-center text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.StayId" class="btn btn-sm btn-outline-info" title="View Details"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.StayId" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil-square"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.StayId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this stay?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>