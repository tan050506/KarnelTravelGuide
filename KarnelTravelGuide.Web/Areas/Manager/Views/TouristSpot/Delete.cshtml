@model KarnelTravelGuide.Web.Models.Entities.TouristSpot
@{
    ViewData["Title"] = "Delete Tourist Spot";
}

<div class="card shadow border-danger border-2 rounded-4" style="max-width: 600px; margin: 0 auto;">
    <div class="card-body p-5 text-center">
        <div class="mb-4">
            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Are you sure?</h3>
        <p class="text-muted mb-4">You are about to delete <strong>@Model.SpotName</strong>. This action cannot be undone and the associated image will also be permanently removed.</p>

        <div class="bg-light p-4 rounded-3 text-start mb-4 border">
            <div class="d-flex align-items-center mb-3">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px;" class="me-3 shadow-sm border" />
                }
                else
                {
                    <div class="bg-white border rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-image text-muted fs-3"></i>
                    </div>
                }
                <div>
                    <h5 class="fw-bold text-primary mb-1">@Model.SpotName</h5>
                    <span class="badge bg-info text-dark">@Model.Branch?.BranchName</span>
                </div>
            </div>
            <p class="mb-0 text-dark"><i class="bi bi-geo-alt text-danger me-2"></i>@Model.Address</p>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="SpotId" />
            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Index" class="btn btn-light border px-4 fw-semibold">Cancel</a>
                <button type="submit" class="btn btn-danger px-4 fw-semibold"><i class="bi bi-trash me-1"></i> Yes, Delete it!</button>
            </div>
        </form>
    </div>
</div>