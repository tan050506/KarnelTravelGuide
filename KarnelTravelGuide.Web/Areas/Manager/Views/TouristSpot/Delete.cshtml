@model KarnelTravelGuide.Web.Models.Entities.TouristSpot
@{ ViewData["Title"] = "Delete Tourist Spot"; }

<div class="k-card p-4 bg-white shadow-sm mx-auto" style="max-width: 600px; border-radius: 1rem; border: 2px solid #dc3545 !important;">
    <div class="p-2 text-center">
        <div class="mb-4">
            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Are you absolutely sure?</h3>
        <p class="text-muted mb-4">You are about to delete <strong class="text-danger">@Model.SpotName</strong>. This action cannot be undone, and the cover image along with all gallery images will be permanently removed from the system.</p>

        <div class="bg-light p-4 rounded-4 text-start mb-5 border">
            <div class="d-flex align-items-center mb-3">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/img/no-image.jpg" : Model.ImageUrl)" style="width: 70px; height: 70px; object-fit: cover;" class="me-3 shadow-sm border rounded-circle" />
                <div>
                    <h5 class="fw-bold text-dark mb-1">@Model.SpotName</h5>
                    <span class="badge bg-white text-dark border">@Model.Branch?.BranchName</span>
                </div>
            </div>
            <p class="mb-0 text-muted small"><i class="bi bi-geo-alt text-danger me-2"></i>@Model.Address</p>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="SpotId" />
            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Index" class="btn btn-light border px-4 py-2 fw-bold rounded-3">No, Cancel</a>
                <button type="submit" class="btn btn-danger px-4 py-2 fw-bold rounded-3"><i class="bi bi-trash me-2"></i> Yes, Delete it!</button>
            </div>
        </form>
    </div>
</div>