@model KarnelTravelGuide.Web.Models.Entities.TouristSpot
@{
    ViewData["Title"] = "Add New Tourist Spot";
}

<div class="card shadow-sm border-0 rounded-4" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header bg-white pt-4 px-4 border-0">
        <h5 class="fw-bold text-dark mb-0">Add New Tourist Spot</h5>
    </div>
    <div class="card-body p-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="mb-4 bg-light p-3 rounded-3 border border-info border-start border-4">
                <label class="form-label fw-bold text-info small text-uppercase">Managing Branch</label>
                <input type="text" class="form-control bg-white text-muted fw-bold" value="@ViewBag.BranchName" readonly />
                <input type="hidden" asp-for="BranchId" value="@ViewBag.BranchId" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Spot Name <span class="text-danger">*</span></label>
                <input asp-for="SpotName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Address</label>
                <input asp-for="Address" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Upload Image <span class="text-danger">*</span></label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" required onchange="previewImage(event)" />
                <div class="mt-3 text-center bg-light rounded-3 p-2" id="previewContainer" style="display: none;">
                    <img id="imagePreview" style="max-height: 200px; object-fit: cover; border-radius: 8px; border: 1px solid #dee2e6;" />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-light border">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Save Tourist Spot</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Code JS để hiển thị ảnh ngay lập tức
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function(){
                var output = document.getElementById('imagePreview');
                var container = document.getElementById('previewContainer');
                output.src = reader.result;
                container.style.display = 'block';
            };
            if(event.target.files[0]){
                reader.readAsDataURL(event.target.files[0]);
            }
        }
    </script>
}