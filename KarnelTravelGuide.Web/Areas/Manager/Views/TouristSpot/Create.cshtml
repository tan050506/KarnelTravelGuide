@model KarnelTravelGuide.Web.Models.Entities.TouristSpot
@{ ViewData["Title"] = "Add New Tourist Spot"; }

<style>
    .preview-box { position: relative; display: inline-block; }
    .btn-remove-preview { position: absolute; top: -10px; right: -10px; width: 25px; height: 25px; padding: 0; background: #fff; color: #dc3545; border-radius: 50%; border: 1px solid #dc3545; display: flex; align-items: center; justify-content: center; font-size: 1rem; cursor: pointer; transition: 0.3s; z-index: 5; }
    .btn-remove-preview:hover { background: #dc3545; color: #fff; transform: scale(1.1); }
</style>

<div class="k-card p-4 bg-white rounded-4 shadow-sm border-0 mx-auto" style="max-width: 900px;">
    <div class="d-flex align-items-center border-bottom pb-3 mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="bi bi-arrow-left"></i></a>
        <h4 class="fw-bold m-0 text-dark">Add New Tourist Spot</h4>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="createForm">
        <div class="row g-4">
            
            <div class="col-12">
                <div class="p-3 rounded-3 bg-primary bg-opacity-10 border border-primary border-opacity-25">
                    <label class="fw-bold text-primary mb-1">Managing Branch</label>
                    <div class="fw-bold text-dark fs-5">@ViewBag.BranchName</div>
                    <input type="hidden" asp-for="BranchId" value="@ViewBag.BranchId" />
                </div>
            </div>

            <div class="col-md-6">
                <label class="fw-bold text-dark mb-2">Spot Name <span class="text-danger">*</span></label>
                <input asp-for="SpotName" class="form-control bg-light border" required placeholder="" />
            </div>
            
            <div class="col-md-6">
                <label class="fw-bold text-dark mb-2">Address <span class="text-danger">*</span></label>
                <input asp-for="Address" class="form-control bg-light border" required placeholder="Enter exact address..." />
            </div>

            <div class="col-12">
                <label class="fw-bold text-dark mb-2">Overview Description</label>
                <textarea asp-for="Description" class="form-control bg-light border" rows="5" placeholder=""></textarea>
            </div>

            <div class="col-md-6">
                <div class="p-4 border rounded-4 bg-light h-100">
                    <label class="fw-bold text-primary mb-2"><i class="bi bi-card-image me-1"></i>Cover Image <span class="text-danger">*</span></label>
                    <p class="small text-muted mb-3">Select the main thumbnail for this spot.</p>
                    
                    <input type="file" name="CoverFile" id="coverInput" class="form-control" accept="image/*" required onchange="previewCover(event)" />
                    
                    <div id="coverPreviewContainer" class="mt-4 text-center d-none">
                        <div class="preview-box w-100">
                            <button type="button" class="btn-remove-preview" onclick="removeCover()"><i class="bi bi-x"></i></button>
                            <img id="coverPreview" class="img-fluid rounded-3 shadow-sm border w-100" style="max-height: 180px; object-fit: cover;" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="p-4 border rounded-4 bg-light h-100">
                    <label class="fw-bold text-success mb-2"><i class="bi bi-images me-1"></i>Photo Gallery</label>
                    <p class="small text-muted mb-3">Add as many photos as you want. You can select single photos multiple times or select many at once.</p>
                    
                    <input type="file" id="galleryInput" class="form-control" accept="image/*" multiple onchange="previewGallery(event)" />
                    
                    <div id="galleryPreviewContainer" class="row g-3 mt-3"></div>
                </div>
            </div>

            <div class="col-12 mt-5 text-end border-top pt-4">
                <button type="submit" class="btn btn-primary px-5 py-3 fw-bold rounded-3"><i class="bi bi-save me-2"></i> Save Tourist Spot</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewCover(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('coverPreview').src = e.target.result;
                    document.getElementById('coverPreviewContainer').classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            }
        }

        function removeCover() {
            document.getElementById('coverInput').value = '';
            document.getElementById('coverPreviewContainer').classList.add('d-none');
            document.getElementById('coverPreview').src = '';
        }

        let selectedGalleryFiles = [];
        function previewGallery(event) {
            const files = event.target.files;
            if (files && files.length > 0) {
                Array.from(files).forEach(file => { selectedGalleryFiles.push(file); });
                renderGalleryPreview();
                updateGalleryInput(); 
            }
        }

        function renderGalleryPreview() {
            const container = document.getElementById('galleryPreviewContainer');
            container.innerHTML = ''; 
            
            selectedGalleryFiles.forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const colDiv = document.createElement('div');
                    colDiv.className = 'col-4 col-sm-3 col-md-4'; 
                    
                    const previewBoxDiv = document.createElement('div');
                    previewBoxDiv.className = 'preview-box h-100';
                    
                    const removeBtn = document.createElement('button');
                    removeBtn.type = 'button';
                    removeBtn.className = 'btn-remove-preview';
                    removeBtn.innerHTML = '<i class="bi bi-x"></i>';
                    removeBtn.onclick = function() { removeGalleryFile(index); };
                    
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'img-fluid rounded-3 shadow-sm border w-100';
                    img.style.height = '80px';
                    img.style.objectFit = 'cover';
                    
                    previewBoxDiv.appendChild(removeBtn);
                    previewBoxDiv.appendChild(img);
                    colDiv.appendChild(previewBoxDiv);
                    container.appendChild(colDiv);
                }
                reader.readAsDataURL(file);
            });
        }

        function removeGalleryFile(indexToRemove) {
            selectedGalleryFiles.splice(indexToRemove, 1);
            renderGalleryPreview();
            updateGalleryInput(); 
        }

        function updateGalleryInput() {
            const dataTransfer = new DataTransfer();
            selectedGalleryFiles.forEach(file => { dataTransfer.items.add(file); });
            document.getElementById('galleryInput').files = dataTransfer.files;
        }
    </script>
}