@model KarnelTravelGuide.Web.Models.Entities.TouristSpot
@{
    ViewData["Title"] = "Spot Details";
}

<div class="k-card mx-auto" style="max-width: 900px;">
    <div class="d-flex align-items-center border-bottom pb-3 mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3"><i class="bi bi-arrow-left"></i></a>
        <h4 class="fw-bold m-0 text-dark">Destination Details</h4>
    </div>

    <div class="row align-items-start">
        <div class="col-md-5 mb-4 mb-md-0">
            @if (!string.IsNullOrEmpty(Model.ImageUrl)) {
                <img src="@Model.ImageUrl" class="img-fluid rounded-4 shadow-sm border w-100" style="height: 300px; object-fit: cover;" />
            } else {
                <div class="bg-light rounded-4 d-flex align-items-center justify-content-center border w-100" style="height: 300px;">
                    <div class="text-muted text-center">
                        <i class="bi bi-image text-secondary d-block mb-2" style="font-size: 3rem;"></i>
                        <span>No Cover Image</span>
                    </div>
                </div>
            }
        </div>
        
        <div class="col-md-7 ps-md-4">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 mb-2 rounded-pill">@Model.Branch?.BranchName</span>
            <h2 class="fw-bold text-dark mb-2">@Model.SpotName</h2>
            <p class="text-muted fs-6"><i class="bi bi-geo-alt-fill text-danger me-2"></i>@Model.Address</p>
            
            <hr class="opacity-25 my-4" />
            
            <h6 class="label-karnel">Overview</h6>
            <p class="text-dark lh-lg" style="text-align: justify; white-space: pre-line;">
                @(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)
            </p>
        </div>
    </div>

    <div class="mt-5 pt-4 border-top">
        <h5 class="fw-bold mb-4"><i class="bi bi-images text-success me-2"></i>Photo Gallery (@Model.TouristSpotImages.Count)</h5>
        <div class="row g-3">
            @foreach (var img in Model.TouristSpotImages) {
                <div class="col-md-3 col-sm-4 col-6">
                    <div class="position-relative overflow-hidden rounded-3 shadow-sm border h-100">
                        <img src="@img.ImageUrl" class="w-100" style="height: 160px; object-fit: cover;" />
                        
                        @if (!string.IsNullOrEmpty(img.Caption))
                        {
                            <div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-75 text-white p-2" style="font-size: 0.85rem; max-height: 50%; overflow-y: auto;">
                                @img.Caption
                            </div>
                        }
                    </div>
                </div>
            }
            @if(Model.TouristSpotImages.Count == 0) {
                <div class="col-12 text-muted fst-italic">No gallery photos uploaded yet.</div>
            }
        </div>
    </div>

    <div class="mt-5 pt-4 border-top text-end">
        <a asp-action="Edit" asp-route-id="@Model.SpotId" class="k-btn-primary me-2"><i class="bi bi-pencil-square me-2"></i> Edit Spot</a>
        <a asp-action="Delete" asp-route-id="@Model.SpotId" class="btn btn-danger fw-bold py-2 px-4 rounded-3"><i class="bi bi-trash me-2"></i> Delete</a>
    </div>
</div>