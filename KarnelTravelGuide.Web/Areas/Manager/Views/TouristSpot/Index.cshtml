@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.TouristSpot>
@{
    ViewData["Title"] = "Tourist Spot Management";
    int index = 1;
}

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-4 d-flex justify-content-between align-items-center">
        <form asp-action="Index" method="get" class="d-flex w-50">
            <div class="input-group">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control bg-light border-0" placeholder="Search by name or address...">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
        <a asp-action="Create" class="btn btn-success fw-semibold"><i class="bi bi-plus-lg me-1"></i> Add New Spot</a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive overflow-hidden">
            <table class="table table-hover align-middle mb-0 w-100" style="table-layout: fixed;">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 5%;">#</th>
                        <th class="text-center" style="width: 12%;">Image</th>
                        <th style="width: 23%;">Spot Name</th>
                        <th class="text-center" style="width: 15%;">Branch</th>
                        <th style="width: 30%;">Address</th>
                        <th class="text-center" style="width: 15%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-muted text-center">@(index++)</td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" style="width: 80px; height: 50px; object-fit: cover; border-radius: 6px;" />
                                    }
                                </td>
                                <td class="fw-bold text-primary text-truncate" title="@item.SpotName">@item.SpotName</td>
                                <td class="text-center"><span class="badge bg-info text-dark">@item.Branch?.BranchName</span></td>
                                <td class="text-truncate" title="@item.Address"><i class="bi bi-geo-alt text-danger small"></i> @item.Address</td>
                                
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.SpotId" class="btn btn-sm btn-outline-info" title="View Details"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.SpotId" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil-square"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.SpotId" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">No tourist spots found in your branch.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>