@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.TouristSpot>
@{
    ViewData["Title"] = "Tourist Spot Management";
    
    // TÍNH TOÁN STT DỰA TRÊN PHÂN TRANG VÀ CHIỀU SẮP XẾP
    bool isDescending = string.IsNullOrEmpty(ViewData["CurrentSort"]?.ToString()) || ViewData["CurrentSort"]?.ToString() == "id_desc";
    int totalItems = ViewBag.TotalItems ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    
    int displayIndex = isDescending ? (totalItems - (currentPage - 1) * pageSize) : ((currentPage - 1) * pageSize + 1);
}

<style>
    .action-btn { width: 32px; height: 32px; padding: 0; line-height: 30px; display: inline-flex; align-items: center; justify-content: center; }
</style>

<div class="k-card p-4 bg-white rounded-4 shadow-sm border-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3">
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control bg-light border" style="min-width: 250px; border-radius: 0.5rem;" placeholder="Search destinations...">
            <button type="submit" class="btn btn-primary" style="border-radius: 0.5rem; width: 45px;"><i class="bi bi-search"></i></button>
            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString())) {
                <a asp-action="Index" class="btn btn-light border text-muted" style="border-radius: 0.5rem;">Clear</a>
            }
        </form>
        <a asp-action="Create" class="btn btn-primary fw-bold px-4" style="border-radius: 0.5rem;"><i class="bi bi-plus-lg me-2"></i> Add New Spot</a>
    </div>

    @if (TempData["SuccessMessage"] != null) {
        <div class="alert alert-success rounded-3 fw-bold"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null) {
        <div class="alert alert-danger rounded-3 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]</div>
    }

    <div class="table-responsive mb-2">
        <table class="table align-middle table-hover table-borderless">
            <thead class="border-bottom text-dark small fw-bold text-uppercase">
                <tr>
                    <th style="width: 5%; text-align: center;">
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["IdSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="text-dark text-decoration-none" title="Click to sort">
                            <i class="bi bi-arrow-down-up fs-5"></i>
                        </a>
                    </th>
                    <th style="width: 100px;">Cover</th>
                    <th>Tourist Spot</th>
                    <th>Managing Branch</th>
                    <th>Gallery</th>
                    <th class="text-center" style="width: 15%;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any()) {
                    foreach (var item in Model) {
                        <tr class="border-bottom">
                            <td class="fw-bold text-secondary fs-6 text-center">@displayIndex</td>
                            <td>
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/img/no-image.jpg" : item.ImageUrl)" class="rounded-3 shadow-sm border" style="width: 80px; height: 60px; object-fit: cover;" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-6">@item.SpotName</div>
                                <div class="small text-muted mt-1"><i class="bi bi-geo-alt me-1 text-danger"></i>@item.Address</div>
                            </td>
                            <td><span class="badge bg-light text-dark border px-3 py-2 rounded-pill">@item.Branch?.BranchName</span></td>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                                    <i class="bi bi-images me-1"></i> @item.TouristSpotImages.Count Photos
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Details" asp-route-id="@item.SpotId" class="btn btn-outline-info rounded-circle action-btn" title="View Details"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.SpotId" class="btn btn-outline-primary rounded-circle action-btn" title="Edit"><i class="bi bi-pencil-square"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.SpotId" class="btn btn-outline-danger rounded-circle action-btn" title="Delete"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                        if (isDescending) { displayIndex--; } else { displayIndex++; }
                    }
                } else {
                    <tr><td colspan="6" class="text-center py-5 text-muted fw-bold">No tourist spots found in your branch.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1) {
        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
            <div class="text-muted small fw-bold">
                Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, totalItems)) of @totalItems entries
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link px-3" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-sortOrder="@ViewData["CurrentSort"]">Prev</a>
                    </li>
                    
                    @for (int i = 1; i <= ViewBag.TotalPages; i++) {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-sortOrder="@ViewData["CurrentSort"]">@i</a>
                        </li>
                    }
                    
                    <li class="page-item @(currentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link px-3" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-sortOrder="@ViewData["CurrentSort"]">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>