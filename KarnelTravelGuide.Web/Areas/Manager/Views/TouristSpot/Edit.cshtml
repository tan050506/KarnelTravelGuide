@model KarnelTravelGuide.Web.Models.Entities.TouristSpot
@{
    ViewData["Title"] = "Edit Tourist Spot";
}

<div class="card shadow-sm border-0 rounded-4" style="max-width: 800px; margin: 0 auto;">
    <div class="card-body p-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <input type="hidden" asp-for="SpotId" />
            <input type="hidden" asp-for="ImageUrl" />
            <input type="hidden" asp-for="BranchId" /> <div class="mb-4 bg-light p-3 rounded-3 border border-info border-start border-4">
                <label class="form-label fw-bold text-info small text-uppercase">Managing Branch</label>
                <input type="text" class="form-control bg-white text-muted fw-bold" value="@ViewBag.BranchName" readonly disabled />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Spot Name</label>
                <input asp-for="SpotName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Address</label>
                <input asp-for="Address" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Update Image (Leave blank to keep current)</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mt-2"><img src="@Model.ImageUrl" style="height: 100px; border-radius: 8px;" /></div>
                }
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-light border">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i> Update Changes</button>
            </div>
        </form>
    </div>
</div>