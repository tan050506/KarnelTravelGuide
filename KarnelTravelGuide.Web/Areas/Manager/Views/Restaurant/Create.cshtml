@model KarnelTravelGuide.Web.Models.Entities.Restaurant
@{ ViewData["Title"] = "Add New Restaurant"; }

<style>
    .preview-box { position: relative; display: inline-block; }
    .btn-remove-preview { position: absolute; top: -10px; right: -10px; width: 25px; height: 25px; padding: 0; background: #fff; color: #dc3545; border-radius: 50%; border: 1px solid #dc3545; display: flex; align-items: center; justify-content: center; font-size: 1rem; cursor: pointer; transition: 0.3s; z-index: 5; }
    .btn-remove-preview:hover { background: #dc3545; color: #fff; transform: scale(1.1); }
    .custom-dropdown-menu { max-height: 250px; overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1000; width: 100%; display: none; margin-top: 5px; }
    .custom-dropdown-menu.show { display: block; }
    .dropdown-item-custom { transition: background-color 0.2s; cursor: pointer; white-space: normal; }
    .dropdown-item-custom:hover { background-color: #f8f9fa; }
</style>

<div class="k-card p-4 bg-white rounded-4 shadow-sm border-0 mx-auto" style="max-width: 1000px;">
    <div class="d-flex align-items-center border-bottom pb-3 mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="bi bi-arrow-left"></i></a>
        <h4 class="fw-bold m-0 text-dark">Add New Restaurant</h4>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="resForm">
        <div class="row g-4">
            <div class="col-md-6">
                <label class="fw-bold text-dark mb-2">Restaurant Name <span class="text-danger">*</span></label>
                <input asp-for="RestaurantName" class="form-control bg-light border" placeholder="" required />
            </div>
            
            <div class="col-md-6 position-relative">
                <label class="fw-bold text-dark mb-2">Tourist Spot (Location) <span class="text-danger">*</span></label>
                <div class="position-relative">
                    <input type="text" id="spotSearchInput" class="form-control bg-light border mb-1" placeholder="Type spot name or address..." autocomplete="off" required>
                    <input type="hidden" asp-for="SpotId" id="hiddenSpotId" />
                    <div id="spotDropdown" class="custom-dropdown-menu k-card shadow-lg p-0 border"></div>
                </div>
                <small class="text-danger d-block mt-1" id="spotAddressText"><i class="bi bi-geo-alt"></i> Please select a tourist spot...</small>
            </div>

            <div class="col-12 mt-2">
                <label class="fw-bold text-dark mb-2">Exact Address <span class="text-danger">*</span></label>
                <input asp-for="Address" class="form-control bg-light border" placeholder="Enter exact address..." required />
            </div>

            <div class="col-12 mt-4">
                <div class="p-4 border rounded-4 bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                        <h5 class="fw-bold text-dark m-0"><i class="bi bi-ui-checks-grid text-primary me-2"></i>Manage Table Types</h5>
                        <button type="button" class="btn btn-sm btn-primary fw-bold" onclick="addTableRow()"><i class="bi bi-plus-lg me-1"></i> Add Table Type</button>
                    </div>
                    
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle mb-0">
                            <thead class="border-bottom bg-light small text-uppercase text-muted fw-bold">
                                <tr>
                                    <th style="width: 40%">Table Type Name</th>
                                    <th style="width: 25%">Price / Table ($)</th>
                                    <th style="width: 25%">Quantity</th>
                                    <th style="width: 10%" class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                </tbody>
                        </table>
                        <small class="text-danger mt-2 fw-bold d-none" id="tableErrorMsg"><i class="bi bi-exclamation-triangle-fill me-1"></i> Error: Price must be $1 - $1,000,000,000. Quantity must be 1 - 100.</small>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <label class="fw-bold text-dark mb-2">Overview Description</label>
                <textarea asp-for="Description" class="form-control bg-light border" rows="3"></textarea>
            </div>

            <div class="col-12">
                <div class="p-4 border rounded-4 bg-light text-center">
                    <label class="fw-bold text-primary d-block text-start mb-3"><i class="bi bi-image me-1"></i>Cover Image <span class="text-danger">*</span></label>
                    <input type="file" name="imageFile" id="imageInput" class="form-control w-50 mx-auto bg-white" accept="image/*" required onchange="previewImage(event)" />
                    
                    <div id="previewContainer" class="mt-4 d-none">
                        <div class="preview-box">
                            <button type="button" class="btn-remove-preview" onclick="removeImage()"><i class="bi bi-x"></i></button>
                            <img id="imagePreview" class="img-fluid rounded-3 shadow border" style="max-height: 250px; object-fit: cover;" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 mt-5 text-end border-top pt-4">
                <button type="submit" class="btn btn-primary px-5 py-3 fw-bold rounded-3"><i class="bi bi-save me-2"></i> Save Restaurant</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const MAX_TABLES = 10;

        function addTableRow() {
            const tbody = document.getElementById('tableBody');
            if (tbody.children.length >= MAX_TABLES) {
                alert("You can only add a maximum of " + MAX_TABLES + " table types.");
                return;
            }

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="py-3">
                    <select name="TableTypes" class="form-select bg-white border" required>
                        <option value="Standard">Standard</option>
                        <option value="VIP">VIP</option>
                    </select>
                </td>
                <td class="py-3">
                    <input type="number" name="Prices" class="form-control bg-white border" min="1" max="1000000000" step="any" placeholder="" required />
                </td>
                <td class="py-3">
                    <input type="number" name="Quantities" class="form-control bg-white border" min="1" max="100" placeholder="" required />
                </td>
                <td class="text-center py-3">
                    <button type="button" class="btn btn-sm btn-danger fw-bold rounded-3" onclick="removeTableRow(this)"><i class="bi bi-trash"></i></button>
                </td>
            `;
            tbody.appendChild(tr);
        }

        function removeTableRow(btn) {
            btn.closest('tr').remove();
            validateTableInputs();
        }

        function validateTableInputs() {
            let isValid = true;
            
            document.querySelectorAll('input[name="Prices"]').forEach(inp => {
                let val = parseFloat(inp.value);
                if (inp.value !== "" && (isNaN(val) || val < 1 || val > 1000000000)) { 
                    inp.classList.add('border-danger'); isValid = false; 
                } else { inp.classList.remove('border-danger'); }
            });

            document.querySelectorAll('input[name="Quantities"]').forEach(inp => {
                let val = parseInt(inp.value);
                if (inp.value !== "" && (isNaN(val) || val < 1 || val > 100)) { 
                    inp.classList.add('border-danger'); isValid = false; 
                } else { inp.classList.remove('border-danger'); }
            });

            const errorMsg = document.getElementById('tableErrorMsg');
            if (!isValid) { errorMsg.classList.remove('d-none'); } else { errorMsg.classList.add('d-none'); }
            
            return isValid;
        }

        document.getElementById('tableBody').addEventListener('input', validateTableInputs);

        window.onload = function() { addTableRow(); }

        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) { document.getElementById('imagePreview').src = e.target.result; document.getElementById('previewContainer').classList.remove('d-none'); }
                reader.readAsDataURL(file);
            }
        }
        function removeImage() { document.getElementById('imageInput').value = ''; document.getElementById('previewContainer').classList.add('d-none'); document.getElementById('imagePreview').src = ''; }

        const spotsData = [ @foreach(var s in ViewBag.TouristSpots) { <text>{ id: @s.SpotId, name: "@Html.Raw(s.SpotName)", address: "@Html.Raw(s.Address)" },</text> } ];
        const spotInput = document.getElementById('spotSearchInput'); const spotDropdown = document.getElementById('spotDropdown'); const hiddenSpotId = document.getElementById('hiddenSpotId'); const spotAddressText = document.getElementById('spotAddressText');

        function renderSpotDropdown(filterText = "") {
            spotDropdown.innerHTML = '';
            const lowerFilter = filterText.toLowerCase();
            const filtered = spotsData.filter(s => (s.name && s.name.toLowerCase().includes(lowerFilter)) || (s.address && s.address.toLowerCase().includes(lowerFilter)));

            if (filtered.length === 0) { spotDropdown.innerHTML += '<div class="p-3 text-muted small fst-italic">No spots found.</div>'; } 
            else {
                filtered.forEach(s => {
                    const item = document.createElement('div');
                    item.className = 'dropdown-item-custom p-3 border-bottom';
                    item.innerHTML = `<div class="fw-bold text-dark fs-6 mb-1">${s.name}</div><div class="small text-muted"><i class="bi bi-geo-alt text-danger me-1"></i> ${s.address || 'N/A'}</div>`;
                    item.onclick = function() { 
                        hiddenSpotId.value = s.id; spotInput.value = s.name; 
                        spotAddressText.innerHTML = `<i class="bi bi-geo-alt me-1"></i>${s.address || 'Address not available'}`;
                        spotAddressText.classList.replace('text-danger', 'text-muted');
                        spotDropdown.classList.remove('show'); 
                        spotInput.classList.remove('border-danger');
                    };
                    spotDropdown.appendChild(item);
                });
            }
            spotDropdown.classList.add('show');
        }

        spotInput.addEventListener('input', function() { 
            hiddenSpotId.value = ''; spotAddressText.innerHTML = '<i class="bi bi-geo-alt"></i> Please select a tourist spot...'; spotAddressText.classList.replace('text-muted', 'text-danger');
            renderSpotDropdown(this.value); 
        });
        spotInput.addEventListener('focus', function() { renderSpotDropdown(this.value); });
        document.addEventListener('click', function(e) { if (!spotInput.contains(e.target) && !spotDropdown.contains(e.target)) spotDropdown.classList.remove('show'); });

        document.getElementById('resForm').addEventListener('submit', function(e) {
            if (!hiddenSpotId.value) { e.preventDefault(); alert("Please select a Tourist Spot!"); spotInput.classList.add('border-danger'); spotInput.focus(); return; }
            if (document.getElementById('tableBody').children.length === 0) { e.preventDefault(); alert("You must add at least 1 table type!"); return; }
            if (!validateTableInputs()) { e.preventDefault(); alert("Please fix the red highlighted errors before saving!"); }
        });
    </script>
}