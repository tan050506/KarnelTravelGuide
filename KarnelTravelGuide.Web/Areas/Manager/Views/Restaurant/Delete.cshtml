@model KarnelTravelGuide.Web.Models.Entities.Restaurant
@{ 
    ViewData["Title"] = "Delete Restaurant"; 
    var totalCap = Model.RestaurantTables?.Sum(t => t.Quantity) ?? 0;
    var types = Model.RestaurantTables != null && Model.RestaurantTables.Any() 
                ? string.Join(", ", Model.RestaurantTables.Select(t => t.TableType).Distinct()) 
                : "No tables";
}

<div class="k-card border-danger border border-2 mx-auto" style="max-width: 600px;">
    <div class="p-4 text-center">
        <div class="mb-4">
            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Delete this Restaurant?</h3>
        <p class="text-muted mb-4">You are about to delete <strong>@Model.RestaurantName</strong> and all its table types from the system. This action cannot be undone.</p>

        <div class="bg-light p-4 rounded-4 text-start mb-5 border">
            <div class="d-flex align-items-center mb-4 border-bottom pb-4">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/img/no-image.jpg" : Model.ImageUrl)" style="width: 80px; height: 80px; object-fit: cover;" class="me-3 shadow-sm border rounded-3" />
                <div>
                    <h5 class="fw-bold text-primary mb-1">@Model.RestaurantName</h5>
                    <div class="d-flex gap-2 mt-2">
                        <span class="badge bg-success bg-opacity-10 text-success border">Total: @totalCap tables</span>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border text-truncate" style="max-width: 150px;">@types</span>
                    </div>
                </div>
            </div>
            
            <div class="mb-3">
                <small class="text-muted fw-bold d-block">Tourist Spot:</small>
                <span class="text-dark small fw-bold">@(Model.Spot?.SpotName ?? "N/A")</span>
            </div>
            <div class="mb-2">
                <small class="text-muted fw-bold d-block">Exact Address:</small>
                <span class="text-dark small"><i class="bi bi-geo-alt text-danger me-1"></i>@(string.IsNullOrEmpty(Model.Address) ? "No exact address" : Model.Address)</span>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="RestaurantId" />
            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Index" class="btn btn-light border px-4 py-2 fw-bold">No, Cancel</a>
                <button type="submit" class="btn btn-danger px-4 py-2 fw-bold"><i class="bi bi-trash me-2"></i> Yes, Delete it!</button>
            </div>
        </form>
    </div>
</div>