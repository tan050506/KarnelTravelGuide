@model KarnelTravelGuide.Web.Models.Entities.Restaurant
@{ ViewData["Title"] = "Restaurant Details"; }

<div class="k-card mx-auto" style="max-width: 900px;">
    <div class="d-flex align-items-center border-bottom pb-3 mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3"><i class="bi bi-arrow-left"></i></a>
        <h4 class="fw-bold m-0 text-dark">Restaurant Details</h4>
    </div>

    <div class="row align-items-start">
        <div class="col-md-5 mb-4 mb-md-0">
            @if (!string.IsNullOrEmpty(Model.ImageUrl)) {
                <img src="@Model.ImageUrl" class="img-fluid rounded-4 shadow-sm border w-100" style="height: 300px; object-fit: cover;" />
            } else {
                <div class="bg-light rounded-4 d-flex align-items-center justify-content-center border w-100" style="height: 300px;">
                    <div class="text-muted text-center"><i class="bi bi-image text-secondary d-block mb-2" style="font-size: 3rem;"></i><span>No Image</span></div>
                </div>
            }
        </div>
        
        <div class="col-md-7 ps-md-4">
            
            <div class="p-3 bg-light rounded-4 border mb-4">
                <div class="mb-3">
                    <span class="d-block small text-muted text-uppercase fw-bold">Tourist Spot (Location)</span>
                    <h5 class="fw-bold text-primary mb-0">@(Model.Spot?.SpotName ?? "N/A")</h5>
                </div>
                <div>
                    <span class="d-block small text-muted text-uppercase fw-bold">Address</span>
                    <small class="text-danger fw-bold"><i class="bi bi-geo-alt"></i> @(string.IsNullOrEmpty(Model.Address) ? "No exact address" : Model.Address)</small>
                </div>
            </div>

            <h4 class="fw-bold text-dark mb-3">@Model.RestaurantName</h4>

            <div class="mb-4 pb-4 border-bottom">
                <span class="text-muted small fw-bold me-2">Feedback Rating:</span>
                @if(Model.StarRating != null && Model.StarRating > 0) {
                    <span class="text-warning fs-5">@for(int i=0; i < Model.StarRating; i++) { <i class="bi bi-star-fill"></i> }</span>
                } else {
                    <span class="text-muted fst-italic small">No ratings yet</span>
                }
            </div>

            <h6 class="label-karnel">Overview Description:</h6>
            <p class="text-dark lh-lg" style="white-space: pre-line;">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>
        </div>

        <div class="col-12 mt-5">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-ui-checks-grid text-primary me-2"></i>Available Tables Overview</h5>
            <div class="table-responsive border rounded-3 shadow-sm">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase fw-bold">
                        <tr>
                            <th class="ps-3">Table Type</th>
                            <th>Price / Table</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model.RestaurantTables != null && Model.RestaurantTables.Any())
                        {
                            foreach(var table in Model.RestaurantTables)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">@table.TableType</td>
                                    <td class="text-success fw-bold">$@((table.PriceRes ?? 0).ToString("0.##"))</td>
                                    <td><span class="badge bg-secondary">@table.Quantity tables</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center py-4 text-muted fst-italic">No table types configured yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-5 pt-4 border-top text-end">
        <a asp-action="Edit" asp-route-id="@Model.RestaurantId" class="k-btn-primary me-2"><i class="bi bi-pencil-square me-2"></i> Edit Restaurant</a>
        <a asp-action="Delete" asp-route-id="@Model.RestaurantId" class="btn btn-danger fw-bold py-2 px-4 rounded-3"><i class="bi bi-trash me-2"></i> Delete</a>
    </div>
</div>