@model KarnelTravelGuide.Web.Models.Entities.Restaurant
@{ ViewData["Title"] = "Restaurant Details"; }

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold text-secondary">Restaurant Details #@Model.RestaurantId</h5>
    </div>
    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-4 text-center mb-4">
                @if(!string.IsNullOrEmpty(Model.ImageUrl)) {
                    <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" alt="@Model.RestaurantName" style="max-height: 300px; object-fit: cover;" />
                } else {
                    <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 250px;">
                        <span class="text-muted"><i class="bi bi-image me-2"></i>No Image Available</span>
                    </div>
                }
            </div>
            
            <div class="col-md-8">
                <h3 class="fw-bold text-primary mb-3">@Model.RestaurantName</h3>
                
                <table class="table table-borderless">
                    <tbody>
                        <tr>
                            <th style="width: 150px;" class="text-muted">Tourist Spot:</th>
                            <td class="fw-semibold">@(Model.Spot?.SpotName ?? "N/A")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Average Price:</th>
                            <td><span class="text-success fw-bold">@(Model.PriceRes?.ToString("N0") ?? "N/A") VNĐ</span></td>
                        </tr>
                        <tr>
                            <th class="text-muted">Rating:</th>
                            <td>
                                @if(Model.StarRating != null && Model.StarRating > 0) {
                                    @for(int i=0; i < Model.StarRating; i++) { <i class="bi bi-star-fill text-warning"></i> }
                                } else {
                                    <span class="text-muted fst-italic">No feedback yet</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">Address:</th>
                            <td>@Model.Address</td>
                        </tr>
                    </tbody>
                </table>

                <div class="mt-3 p-3 bg-light rounded">
                    <h6 class="fw-bold text-secondary">Description</h6>
                    <p class="mb-0" style="white-space: pre-line;">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>
                </div>
            </div>
        </div>
        
        <div class="mt-4 border-top pt-3 text-end">
            <a asp-action="Index" class="btn btn-light me-2"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
            <a asp-action="Edit" asp-route-id="@Model.RestaurantId" class="btn btn-primary"><i class="bi bi-pencil-square me-1"></i> Edit Restaurant</a>
        </div>
    </div>
</div>