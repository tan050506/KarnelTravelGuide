@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.Restaurant>
@{ 
    ViewData["Title"] = "Manage Restaurants"; 
    
    // TÍNH TOÁN STT DỰA TRÊN PHÂN TRANG VÀ CHIỀU SẮP XẾP
    bool isDescending = string.IsNullOrEmpty(ViewData["CurrentSort"]?.ToString()) || ViewData["CurrentSort"]?.ToString() == "id_desc";
    int totalItems = ViewBag.TotalItems ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    
    int displayIndex = isDescending ? (totalItems - (currentPage - 1) * pageSize) : ((currentPage - 1) * pageSize + 1);
}

<style>
    .action-btn { width: 32px; height: 32px; padding: 0; line-height: 30px; display: inline-flex; align-items: center; justify-content: center; }
</style>

<div class="k-card p-4 bg-white rounded-4 shadow-sm border-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3">
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control bg-light border" style="min-width: 250px; border-radius: 0.5rem;" placeholder="Search restaurant name or location...">
            <button type="submit" class="btn btn-primary" style="border-radius: 0.5rem; width: 45px;"><i class="bi bi-search"></i></button>
            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString())) {
                <a asp-action="Index" class="btn btn-light border text-muted" style="border-radius: 0.5rem;">Clear</a>
            }
        </form>
        <a asp-action="Create" class="btn btn-primary fw-bold px-4" style="border-radius: 0.5rem;"><i class="bi bi-plus-lg me-2"></i> Add New Restaurant</a>
    </div>

    @if (TempData["SuccessMessage"] != null) {
        <div class="alert alert-success rounded-3 fw-bold"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null) {
        <div class="alert alert-danger rounded-3 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]</div>
    }

    <div class="table-responsive mb-2">
        <table class="table align-middle table-hover table-borderless">
            <thead class="border-bottom text-dark small fw-bold text-uppercase">
                <tr>
                    <th style="width: 5%; text-align: center;">
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["IdSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" class="text-dark text-decoration-none" title="Click to sort">
                            <i class="bi bi-arrow-down-up fs-5"></i>
                        </a>
                    </th>
                    <th style="width: 10%;">Image</th>
                    <th style="width: 25%;">Restaurant Name</th>
                    <th style="width: 30%;">Location & Address</th>
                    <th style="width: 15%;">Tables</th>
                    <th class="text-end" style="width: 15%;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any()) {
                    foreach (var item in Model) {
                        var typeCount = item.RestaurantTables.Select(t => t.TableType).Distinct().Count();

                        <tr class="border-bottom">
                            <td class="fw-bold text-secondary fs-6 text-center">@displayIndex</td>
                            <td>
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/img/no-image.jpg" : item.ImageUrl)" class="rounded-3 shadow-sm border" style="width: 70px; height: 45px; object-fit: cover;" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark text-truncate" style="max-width: 180px;" title="@item.RestaurantName">@item.RestaurantName</div>
                                @{
                                // THUẬT TOÁN HACK: Lọc Review (R|) và tính trung bình sao
                                var reviews = item.Feedbacks?.Where(f => f.Message != null && f.Message.StartsWith("R|")).ToList() ?? new List<KarnelTravelGuide.Web.Models.Entities.Feedback>();
                                double avgStar = 0;
                                if (reviews.Any()) {
                                    avgStar = reviews.Average(r => {
                                        var parts = r.Message!.Split('|');
                                        return (parts.Length >= 2 && int.TryParse(parts[1], out int s)) ? s : 0;
                                    });
                                }
                            }
                            @if (avgStar > 0) {
                                <div class="mt-1 d-flex align-items-center">
                                    <i class="bi bi-star-fill text-warning me-1"></i>
                                    <span class="fw-bold text-dark me-1" style="font-size: 0.9rem;">@avgStar.ToString("0.0")</span>
                                    <span class="small text-muted">(@reviews.Count reviews)</span>
                                </div>
                            } else {
                                <div class="small text-muted fst-italic mt-1">No rating yet</div>
                            }
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-6 text-truncate" style="max-width: 250px;" title="@(item.Spot?.SpotName)">@(item.Spot?.SpotName ?? "N/A")</div>
                                <div class="small text-muted mt-1 text-truncate" style="max-width: 250px;" title="@item.Address"><i class="bi bi-geo-alt text-danger me-1"></i>@item.Address</div>
                            </td>
                            <td>
                                <div class="fw-bold text-primary"><i class="bi bi-ui-checks-grid me-1"></i> @typeCount Types</div>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Details" asp-route-id="@item.RestaurantId" class="btn btn-outline-info rounded-circle action-btn" title="Details"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.RestaurantId" class="btn btn-outline-primary rounded-circle action-btn" title="Edit"><i class="bi bi-pencil-square"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.RestaurantId" class="btn btn-outline-danger rounded-circle action-btn" title="Delete"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                        if (isDescending) { displayIndex--; } else { displayIndex++; }
                    }
                } else {
                    <tr><td colspan="6" class="text-center py-5 text-muted fw-bold">No restaurants found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1) {
        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
            <div class="text-muted small fw-bold">
                Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, totalItems)) of @totalItems entries
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link px-3" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-sortOrder="@ViewData["CurrentSort"]">Prev</a>
                    </li>
                    
                    @for (int i = 1; i <= ViewBag.TotalPages; i++) {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-sortOrder="@ViewData["CurrentSort"]">@i</a>
                        </li>
                    }
                    
                    <li class="page-item @(currentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link px-3" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-sortOrder="@ViewData["CurrentSort"]">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>