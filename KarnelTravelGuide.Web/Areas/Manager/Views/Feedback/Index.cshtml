@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.Feedback>

@{
    ViewData["Title"] = "Quản lý Đánh giá & Phản hồi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 text-danger fw-bold"><i class="bi bi-chat-left-text me-2"></i>@ViewData["Title"]</h2>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Khách hàng</th>
                        <th>Nội dung</th>
                        <th>Đối tượng</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 text-muted fw-bold">@item.FeedbackId</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="fw-bold">@(item.Account?.FullName ?? "Khách vãng lai")</div>
                                </div>
                            </td>
                            <td>
                                <span class="d-inline-block text-truncate" style="max-width: 250px;" title="@item.Message">
                                    @item.Message
                                </span>
                            </td>
                            <td>
                                @if (item.StayId.HasValue)
                                {
                                    <span class="badge bg-primary rounded-pill"><i class="bi bi-building me-1"></i> Khách sạn</span>
                                }
                                else if (item.RestaurantId.HasValue)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill"><i class="bi bi-cup-hot-fill me-1"></i> Nhà hàng</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill">Chung</span>
                                }
                            </td>
                            <td>
                                @if (string.IsNullOrEmpty(item.ReplyMessage))
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2"><i class="bi bi-x-circle me-1"></i> Chưa phản hồi</span>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i> Đã phản hồi</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <form asp-action="Delete" asp-route-id="@item.FeedbackId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đánh giá này?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger me-2" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                                <a asp-action="Reply" asp-route-id="@item.FeedbackId" class="btn btn-sm btn-primary" title="Xem & Phản hồi">
                                    <i class="bi bi-reply-fill"></i> Xem / Phản hồi
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                Hiện tại chưa có đánh giá hoặc phản hồi nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
