@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.Feedback>
@{ 
    ViewData["Title"] = "Feedback Management"; 
    int totalCount = Model?.Count() ?? 0;
    int displayIndex = 1;
}

<style>
    .action-btn { width: 32px; height: 32px; padding: 0; line-height: 30px; display: inline-flex; align-items: center; justify-content: center; }
</style>

<div class="k-card p-4 bg-white rounded-4 shadow-sm border-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3">
        <h4 class="fw-bold m-0 text-dark">Feedback Management</h4>
        
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control bg-light border" style="min-width: 250px; border-radius: 0.5rem;" placeholder="Search customer or message...">
            
            <select name="serviceType" class="form-select bg-light border" style="width: 160px; border-radius: 0.5rem;">
                <option value="">All Services</option>
                @if (ViewData["CurrentType"]?.ToString() == "Stay") { <option value="Stay" selected>Stays (Rooms)</option> } else { <option value="Stay">Stays (Rooms)</option> }
                @if (ViewData["CurrentType"]?.ToString() == "Restaurant") { <option value="Restaurant" selected>Restaurants</option> } else { <option value="Restaurant">Restaurants</option> }
            </select>

            <button type="submit" class="btn btn-primary" style="border-radius: 0.5rem; width: 45px;"><i class="bi bi-search"></i></button>
            @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()) || !string.IsNullOrEmpty(ViewData["CurrentType"]?.ToString())) {
                <a asp-action="Index" class="btn btn-light border text-muted" style="border-radius: 0.5rem;">Clear</a>
            }
        </form>
    </div>

    @if (TempData["SuccessMessage"] != null) {
        <div class="alert alert-success rounded-3 fw-bold mb-4"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
    }

    <div class="table-responsive">
        <table class="table align-middle table-hover table-borderless">
            <thead class="border-bottom text-dark small fw-bold text-uppercase">
                <tr>
                    <th style="width: 5%; text-align: center;">#</th>
                    <th style="width: 20%;">CUSTOMER</th>
                    <th style="width: 25%;">SERVICE INFO</th>
                    <th style="width: 35%;">MESSAGE</th>
                    <th style="width: 15%; text-align: center;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any()) {
                    foreach (var item in Model) {
                        string serviceName = "Unknown";
                        string serviceBadge = "";

                        if (item.StayId != null) { 
                            serviceName = item.Stay?.Name ?? "N/A"; 
                            serviceBadge = "<span class='badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1'>Stay</span>"; 
                        }
                        else if (item.RestaurantId != null) { 
                            serviceName = item.Restaurant?.RestaurantName ?? "N/A"; 
                            serviceBadge = "<span class='badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1'>Restaurant</span>"; 
                        }

                        <tr class="border-bottom">
                            <td class="fw-bold text-secondary fs-6 text-center">@displayIndex</td>
                            
                            <td>
                                <div class="fw-bold text-dark mb-1">@item.Account?.FullName</div>
                                <div class="small fw-bold text-primary"><i class="bi bi-telephone text-primary me-1"></i>@(item.Account?.PhoneNumber ?? "N/A")</div>
                            </td>
                            
                            <td>
                                <div class="fw-bold text-dark text-truncate mb-2" style="max-width: 220px;" title="@serviceName">@serviceName</div>
                                <div>@Html.Raw(serviceBadge)</div>
                            </td>

                            <td>
                                <div class="text-truncate text-dark fst-italic" style="max-width: 300px;" title="@item.Message">
                                    "@(string.IsNullOrEmpty(item.Message) ? "No message" : item.Message)"
                                </div>
                            </td>
                            
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Details" asp-route-id="@item.FeedbackId" class="btn btn-outline-info rounded-circle action-btn" title="View Details"><i class="bi bi-eye"></i></a>
                                    
                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this feedback? This action cannot be undone.');">
                                        <input type="hidden" name="id" value="@item.FeedbackId" />
                                        <button type="submit" class="btn btn-outline-danger rounded-circle action-btn" title="Delete Feedback"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        displayIndex++;
                    }
                } else {
                    <tr><td colspan="5" class="text-center py-5 text-muted fw-bold">No feedbacks found matching your criteria.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>