@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.Feedback>
@{ 
    ViewData["Title"] = "Customer Reviews"; 

    bool isDescending = string.IsNullOrEmpty(ViewData["CurrentSort"]?.ToString()) || ViewData["CurrentSort"]?.ToString() == "id_desc";
    int totalItems = ViewBag.TotalItems ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    
    int displayIndex = isDescending ? (totalItems - (currentPage - 1) * pageSize) : ((currentPage - 1) * pageSize + 1);
}

<style>
    .action-btn { width: 32px; height: 32px; padding: 0; line-height: 30px; display: inline-flex; align-items: center; justify-content: center; }
    .star-active { color: #ffc107; }
    .star-inactive { color: #e4e5e9; }
</style>

<div class="k-card p-4 bg-white rounded-4 shadow-sm border-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <h4 class="fw-bold m-0 text-dark"><i class="bi bi-star-half text-warning me-2"></i>Customer Reviews</h4>
        
        <div class="d-flex gap-3">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control bg-light border" style="min-width: 250px; border-radius: 0.5rem;" placeholder="Search review...">
                
                <select name="serviceType" class="form-select bg-light border" style="width: 150px; border-radius: 0.5rem;">
                    <option value="">All Services</option>
                    @if (ViewData["CurrentType"]?.ToString() == "Stay") { <option value="Stay" selected>Stays</option> } else { <option value="Stay">Stays</option> }
                    @if (ViewData["CurrentType"]?.ToString() == "Restaurant") { <option value="Restaurant" selected>Restaurants</option> } else { <option value="Restaurant">Restaurants</option> }
                </select>

                <button type="submit" class="btn btn-primary" style="border-radius: 0.5rem; width: 45px;"><i class="bi bi-search"></i></button>
                @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()) || !string.IsNullOrEmpty(ViewData["CurrentType"]?.ToString())) {
                    <a asp-action="Index" class="btn btn-light border text-muted" style="border-radius: 0.5rem;">Clear</a>
                }
            </form>
            
            <a asp-action="SupportChat" class="btn btn-dark fw-bold shadow-sm" style="border-radius: 0.5rem;"><i class="bi bi-chat-dots-fill text-info me-2"></i>Live Inbox</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null) {
        <div class="alert alert-success rounded-3 fw-bold mb-4"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
    }

    <div class="table-responsive mb-2">
        <table class="table align-middle table-hover table-borderless">
            <thead class="bg-light border-bottom text-dark small fw-bold text-uppercase">
                <tr>
                    <th style="width: 5%; text-align: center;">
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["IdSortParm"]" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-serviceType="@ViewData["CurrentType"]" class="text-dark text-decoration-none" title="Click to sort">
                            <i class="bi bi-arrow-down-up fs-5"></i>
                        </a>
                    </th>
                    <th style="width: 20%;">CUSTOMER</th>
                    <th style="width: 20%;">SERVICE</th>
                    <th style="width: 40%;">RATING & COMMENT</th>
                    <th style="width: 15%; text-align: center;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any()) {
                    foreach (var item in Model) {
                        
                        string serviceName = (item.StayId != null ? item.Stay?.Name : item.Restaurant?.RestaurantName) ?? "N/A";
                        
                        string themeColor = item.StayId != null ? "primary" : "success";
                        string badgeText = item.StayId != null ? "Stay" : "Restaurant";

                        string rawMessage = item.Message ?? "";
                        int fbRating = 0; string fbContent = rawMessage;
                        if (rawMessage.StartsWith("R|") && rawMessage.Contains("|")) {
                            var parts = rawMessage.Split('|', 3);
                            if (parts.Length == 3) { int.TryParse(parts[1], out fbRating); fbContent = parts[2]; }
                        }

                        <tr class="border-bottom">
                            <td class="fw-bold text-secondary fs-6 text-center">@displayIndex</td>
                            <td>
                                <div class="fw-bold text-dark mb-1">@item.Account?.FullName</div>
                                <div class="small fw-bold text-primary"><i class="bi bi-telephone text-primary me-1"></i>@(item.Account?.PhoneNumber ?? "N/A")</div>
                            </td>
                            <td>
                                <div><span class='badge bg-@themeColor bg-opacity-10 text-@themeColor border border-@themeColor border-opacity-25 rounded-pill px-3 py-1'>@badgeText</span></div>
                                <div class="small fw-bold text-dark text-truncate mt-1" style="max-width: 180px;" title="@serviceName">@serviceName</div>
                            </td>
                            <td>
                                <div class="mb-1">
                                    @for (int i = 1; i <= 5; i++) {
                                        if (i <= fbRating) { <i class="bi bi-star-fill star-active small"></i> }
                                        else { <i class="bi bi-star-fill star-inactive small"></i> }
                                    }
                                </div>
                                <div class="text-truncate text-dark fst-italic mt-1" style="max-width: 350px;" title="@fbContent">"@fbContent"</div>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Details" asp-route-id="@item.FeedbackId" class="btn btn-outline-info rounded-circle action-btn"><i class="bi bi-eye"></i></a>
                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this review?');">
                                        <input type="hidden" name="id" value="@item.FeedbackId" />
                                        <button type="submit" class="btn btn-outline-danger rounded-circle action-btn"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        if (isDescending) { displayIndex--; } else { displayIndex++; }
                    }
                } else {
                    <tr><td colspan="5" class="text-center py-5 text-muted fw-bold">No reviews found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1) {
        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
            <div class="text-muted small fw-bold">
                Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, totalItems)) of @totalItems entries
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link px-3" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-serviceType="@ViewData["CurrentType"]" asp-route-sortOrder="@ViewData["CurrentSort"]">Prev</a>
                    </li>
                    
                    @for (int i = 1; i <= ViewBag.TotalPages; i++) {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-serviceType="@ViewData["CurrentType"]" asp-route-sortOrder="@ViewData["CurrentSort"]">@i</a>
                        </li>
                    }
                    
                    <li class="page-item @(currentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link px-3" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@ViewData["CurrentSearch"]" asp-route-serviceType="@ViewData["CurrentType"]" asp-route-sortOrder="@ViewData["CurrentSort"]">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>