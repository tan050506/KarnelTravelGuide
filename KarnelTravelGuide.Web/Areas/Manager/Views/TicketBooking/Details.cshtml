@model KarnelTravelGuide.Web.Models.Entities.Order
@{
    ViewData["Title"] = "Booking Details";
    var firstTicket = Model.OrderDetails?.FirstOrDefault(od => od.TicketBooking != null)?.TicketBooking;
    var seatsList = Model.OrderDetails?.Where(od => od.TicketBooking != null).Select(od => od.TicketBooking!.Seat).ToList();
}

<div class="k-card mx-auto" style="max-width: 900px;">
    
    <div class="d-flex align-items-center border-bottom pb-3 mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3"><i class="bi bi-arrow-left"></i></a>
        <h4 class="fw-bold m-0 text-dark">Order #@Model.OrderId Details</h4>
        <div class="ms-auto">
            @if (Model.Status == "Confirmed") { <span class="badge bg-success px-3 py-2 fs-6">Confirmed</span> }
            else if (Model.Status == "Canceled") { <span class="badge bg-danger px-3 py-2 fs-6">Canceled</span> }
            else { <span class="badge bg-warning text-dark px-3 py-2 fs-6">Pending</span> }
        </div>
    </div>
    
    <div class="row mb-5">
        <div class="col-md-6 border-end pe-md-4">
            <h6 class="fw-bold text-secondary text-uppercase mb-3"><i class="bi bi-person-badge text-primary me-2"></i>Customer Info</h6>
            <div class="p-3 bg-light rounded-3 border">
                <p class="mb-2 fw-bold text-dark fs-5">@Model.Account?.FullName</p>
                <p class="mb-1 text-muted"><i class="bi bi-telephone me-2"></i> @Model.Account?.PhoneNumber</p>
                <p class="mb-0 text-muted"><i class="bi bi-envelope me-2"></i> @Model.Account?.Email</p>
            </div>
        </div>
        <div class="col-md-6 ps-md-4">
            <h6 class="fw-bold text-secondary text-uppercase mb-3"><i class="bi bi-credit-card text-success me-2"></i>Payment Info</h6>
            <div class="p-3 bg-light rounded-3 border">
                <h3 class="text-success fw-bold mb-2">$@Model.TotalAmount?.ToString("N0")</h3>
                <p class="text-muted small mb-0 fw-bold">Booking Date: <span class="text-dark">@Model.CreateDate?.ToString("dd/MM/yyyy HH:mm")</span></p>
            </div>
        </div>
    </div>

    @if (firstTicket != null)
    {
        <div class="border border-primary border-opacity-25 rounded-4 p-4 bg-primary bg-opacity-10">
            <h6 class="fw-bold text-primary mb-4 text-uppercase"><i class="bi bi-bus-front-fill me-2"></i>Route Information</h6>
            
            <div class="row align-items-center text-center mb-4 bg-white p-3 rounded-3 shadow-sm mx-1">
                <div class="col-5">
                    <h5 class="fw-bold text-dark mb-1">@firstTicket.Transportation?.FromBranch?.BranchName</h5>
                    <small class="text-danger fw-bold"><i class="bi bi-clock me-1"></i> @firstTicket.Transportation?.DepartureTime?.ToString("HH:mm")</small>
                </div>
                <div class="col-2"><i class="bi bi-arrow-right fs-3 text-muted"></i></div>
                <div class="col-5">
                    <h5 class="fw-bold text-primary mb-1">@firstTicket.Transportation?.ToSpot?.SpotName</h5>
                    <small class="text-muted fw-bold"><i class="bi bi-calendar-event me-1"></i>@(firstTicket.TravelDate.HasValue ? firstTicket.TravelDate.Value.ToString("dd/MM/yyyy") : "N/A")</small>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-3 shadow-sm mx-1">
                <div>
                    <span class="text-muted small d-block fw-bold text-uppercase">Vehicle</span>
                    <strong class="text-dark fs-5">@firstTicket.Transportation?.TransportName</strong>
                </div>
                <div class="text-end">
                    <span class="text-muted small d-block fw-bold text-uppercase mb-1">Selected Seats (@seatsList?.Count)</span>
                    <span class="badge border border-primary text-primary px-3 py-2 fs-6 bg-white">@string.Join(", ", seatsList ?? new List<string?>())</span>
                </div>
            </div>
        </div>
    }
</div>