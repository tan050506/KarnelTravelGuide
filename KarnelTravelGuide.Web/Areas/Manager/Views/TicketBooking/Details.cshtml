@model KarnelTravelGuide.Web.Models.Entities.Order
@{
    ViewData["Title"] = "Booking Details";
    var firstTicket = Model.OrderDetails?.FirstOrDefault(od => od.TicketBooking != null)?.TicketBooking;
    var seatsList = Model.OrderDetails?.Where(od => od.TicketBooking != null).Select(od => od.TicketBooking!.Seat).ToList();
}

<div class="card shadow-sm border-0 rounded-4" style="max-width: 800px; margin: 0 auto; margin-top: 30px;">
    <div class="card-header bg-white pt-4 px-4 border-0 d-flex justify-content-between align-items-center">
        <h4 class="fw-bold text-primary mb-0"><i class="bi bi-info-circle-fill me-2"></i>Order #@Model.OrderId Details</h4>
        @if (Model.Status == "Confirmed") { <span class="badge bg-success px-3 py-2 fs-6">Confirmed</span> }
        else if (Model.Status == "Canceled") { <span class="badge bg-danger px-3 py-2 fs-6">Canceled</span> }
        else { <span class="badge bg-warning text-dark px-3 py-2 fs-6">Pending</span> }
    </div>
    
    <div class="card-body p-4">
        <div class="row mb-4">
            <div class="col-md-6 border-end">
                <h6 class="fw-bold text-secondary text-uppercase mb-3">Customer Info</h6>
                <p class="mb-1"><i class="bi bi-person-circle text-muted me-2"></i> <strong>@Model.Account?.FullName</strong></p>
                <p class="mb-1"><i class="bi bi-telephone text-muted me-2"></i> @Model.Account?.PhoneNumber</p>
                <p class="mb-0"><i class="bi bi-envelope text-muted me-2"></i> @Model.Account?.Email</p>
            </div>
            <div class="col-md-6 ps-4">
                <h6 class="fw-bold text-secondary text-uppercase mb-3">Payment Info</h6>
                <h3 class="text-success fw-bold mb-1">$@Model.TotalAmount?.ToString("N0")</h3>
                <p class="text-muted small mb-0">Date: @Model.CreateDate?.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>

        @if (firstTicket != null)
        {
            <div class="bg-light rounded-4 p-4 border">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-bus-front text-primary me-2"></i>Route Information</h6>
                
                <div class="row align-items-center text-center mb-4">
                    <div class="col-5">
                        <h5 class="fw-bold text-dark mb-0">@firstTicket.Transportation?.FromBranch?.BranchName</h5>
                        <small class="text-danger"><i class="bi bi-clock me-1"></i> @firstTicket.Transportation?.DepartureTime?.ToString("HH:mm")</small>
                    </div>
                    <div class="col-2"><i class="bi bi-arrow-right fs-3 text-muted"></i></div>
                    <div class="col-5">
                        <h5 class="fw-bold text-primary mb-0">@firstTicket.Transportation?.ToSpot?.SpotName</h5>
                        <small class="text-muted">@(firstTicket.TravelDate.HasValue ? firstTicket.TravelDate.Value.ToString("dd/MM/yyyy") : "N/A")</small>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center border-top pt-3">
                    <div>
                        <span class="text-muted small d-block">Vehicle</span>
                        <strong class="text-dark">@firstTicket.Transportation?.TransportName</strong>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block">Selected Seats (@seatsList?.Count)</span>
                        <span class="badge border border-primary text-primary px-3 py-2 fs-6">@string.Join(", ", seatsList ?? new List<string?>())</span>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="card-footer bg-white px-4 py-3 border-top d-flex justify-content-start">
        <a asp-action="Index" class="btn btn-secondary fw-semibold"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
    </div>
</div>