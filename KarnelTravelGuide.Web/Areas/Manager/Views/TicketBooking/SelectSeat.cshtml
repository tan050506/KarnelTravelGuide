@model KarnelTravelGuide.Web.Models.Entities.Transportation
@{
    ViewData["Title"] = "Select Seats";
}

<style>
    .legend-container { display: flex; justify-content: center; gap: 24px; margin-bottom: 30px; }
    .legend-item { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.95rem; color: #555; }
    .legend-box { width: 24px; height: 24px; border-radius: 6px; }

    .seat-grid { display: grid; gap: 15px; justify-content: center; }
    .seat { height: 45px; width: 50px; border-radius: 8px 8px 15px 15px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1rem; cursor: pointer; transition: all 0.2s ease; user-select: none; }
    .seat.available { background-color: #fff; border: 2px solid #28a745; color: #28a745; }
    .seat.available:hover { background-color: #e6f9ed; transform: translateY(-2px); }
    .seat.booked { background-color: #e4e6eb; color: #a0a0a0; border: 2px solid #d0d0d0; cursor: not-allowed; }
    .seat.selected { background-color: #0d6efd; color: white; border: 2px solid #0d6efd; box-shadow: 0 4px 10px rgba(13, 110, 253, 0.3); transform: scale(1.05); }
    
    .bottom-checkout-bar { 
        position: sticky; 
        bottom: 20px; 
        background: #fff; 
        padding: 20px 30px; 
        box-shadow: 0 10px 30px rgba(0,0,0,0.15); 
        z-index: 1000; 
        border: 1px solid #e0e0e0;
        border-radius: 16px;
        margin-top: 30px;
    }

    /* Tùy chỉnh thanh cuộn cho khu vực hiển thị ghế */
    .seat-scroll-box::-webkit-scrollbar { width: 6px; }
    .seat-scroll-box::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 10px; }
</style>

<div class="container py-4" style="max-width: 900px;">
    
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Create" class="btn btn-light rounded-circle me-3"><i class="bi bi-arrow-left"></i></a>
        <h3 class="fw-bold mb-0 text-dark">@Model.TransportName</h3>
    </div>

    @if (TempData["ErrorMessage"] != null) { 
        <div class="alert alert-danger rounded-3 fw-bold"><i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]</div> 
    }

    <form asp-action="Create" method="post" id="checkoutForm">
        <input type="hidden" name="CustomerType" value="@ViewBag.CustomerType" />
        <input type="hidden" name="AccountId" value="@ViewBag.AccountId" />
        <input type="hidden" name="WalkInName" value="@ViewBag.WalkInName" />
        <input type="hidden" name="WalkInPhone" value="@ViewBag.WalkInPhone" />
        <input type="hidden" name="TransportationId" value="@Model.TransportationId" />
        <input type="hidden" name="TravelDate" value="@ViewBag.TravelDate" />
        <input type="hidden" name="Seat" id="selectedSeatInput" required />

        <div class="k-card text-center mb-0">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Seat Map</h5>
                <span class="badge bg-light text-success border border-success fs-6">$@Model.PriceTransport?.ToString("N0") / seat</span>
            </div>

            <div class="legend-container">
                <div class="legend-item"><div class="legend-box" style="background: #fff; border: 2px solid #28a745;"></div> Available</div>
                <div class="legend-item"><div class="legend-box" style="background: #e4e6eb; border: 2px solid #d0d0d0;"></div> Booked</div>
                <div class="legend-item"><div class="legend-box" style="background: #0d6efd;"></div> Selected</div>
            </div>

            <div id="loading" class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-3 text-muted fw-bold">Loading seat map...</p>
            </div>

            <div id="seatMapGrid" class="row d-none g-4 justify-content-center pb-3">
                <div class="col-md-6">
                    <div class="text-center fw-bold text-muted mb-3">LOWER DECK</div>
                    <div class="seat-grid" id="floor1"></div>
                </div>
                <div class="col-md-6">
                    <div class="text-center fw-bold text-muted mb-3">UPPER DECK</div>
                    <div class="seat-grid" id="floor2"></div>
                </div>
            </div>
        </div>

        <div class="bottom-checkout-bar">
            <div class="row align-items-center m-0">
                <div class="col-md-5 text-start ps-0 pe-4">
                    <span class="text-muted fw-bold d-block mb-1">Selected Seats:</span>
                    <div class="fw-bold text-dark fs-5 lh-base seat-scroll-box" id="seatLabel" style="max-height: 60px; overflow-y: auto;">None</div>
                </div>
                
                <div class="col-md-4 text-center border-start border-end">
                    <span class="text-muted fw-bold d-block mb-1">Total Amount:</span>
                    <span class="fs-3 fw-bold text-primary lh-1" id="priceLabel">$0</span>
                </div>
                
                <div class="col-md-3 text-end pe-0 ps-4">
                    <button type="submit" class="k-btn-primary py-3 w-100" id="submitBtn" disabled>Confirm</button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const transportId = @Model.TransportationId;
            const travelDate = "@ViewBag.TravelDate";
            const unitPrice = @(Model.PriceTransport ?? 0);
            const capacity = @(Model.SeatCapacity);
            
            let selectedSeatsArray = [];

            function updateCheckoutBar() {
                if (selectedSeatsArray.length > 0) {
                    selectedSeatsArray.sort();
                    document.getElementById("seatLabel").innerText = selectedSeatsArray.join(", ");
                    const total = selectedSeatsArray.length * unitPrice;
                    document.getElementById("priceLabel").innerText = "$" + total.toLocaleString('en-US');
                    document.getElementById("selectedSeatInput").value = selectedSeatsArray.join(",");
                    document.getElementById("submitBtn").disabled = false;
                } else {
                    document.getElementById("seatLabel").innerText = "None";
                    document.getElementById("priceLabel").innerText = "$0";
                    document.getElementById("selectedSeatInput").value = "";
                    document.getElementById("submitBtn").disabled = true;
                }
            }

            function createSeatHTML(seatId, isBooked) {
                const div = document.createElement("div");
                div.innerText = seatId; 
                if (isBooked) { 
                    div.className = "seat booked";
                } else {
                    div.className = "seat available";
                    div.addEventListener("click", () => {
                        if (div.classList.contains("selected")) {
                            div.classList.remove("selected"); div.classList.add("available");
                            selectedSeatsArray = selectedSeatsArray.filter(s => s !== seatId);
                        } else {
                            div.classList.remove("available"); div.classList.add("selected");
                            selectedSeatsArray.push(seatId);
                        }
                        updateCheckoutBar();
                    });
                }
                return div;
            }

            fetch(`/Manager/TicketBooking/GetBookedSeats?transportationId=${transportId}&date=${travelDate}`)
                .then(r => r.json())
                .then(bookedSeats => { 
                    document.getElementById("loading").classList.add("d-none");
                    document.getElementById("seatMapGrid").classList.remove("d-none");
                    
                    const f1 = document.getElementById("floor1");
                    const f2 = document.getElementById("floor2");
                    
                    let floor1Seats = []; let floor2Seats = [];
                    const cols = ['A', 'B', 'C', 'D', 'E', 'F']; 
                    let colsPerRow = capacity <= 16 ? 3 : (capacity >= 50 ? 6 : 4);

                    let currentSeatCount = 0; let row = 1;
                    while (currentSeatCount < capacity) {
                        for (let c = 0; c < colsPerRow; c++) {
                            if (currentSeatCount >= capacity) break;
                            let seatCode = cols[c] + row; 
                            if (capacity >= 30 && currentSeatCount >= Math.ceil(capacity / 2)) floor2Seats.push(seatCode);
                            else floor1Seats.push(seatCode);
                            currentSeatCount++;
                        }
                        row++;
                    }

                    f1.style.gridTemplateColumns = `repeat(${colsPerRow}, 1fr)`;
                    f2.style.gridTemplateColumns = `repeat(${colsPerRow}, 1fr)`;

                    if (floor2Seats.length === 0) {
                        f2.parentElement.classList.add("d-none");
                        f1.parentElement.classList.remove("col-md-6");
                        f1.parentElement.classList.add("col-12"); 
                    }

                    floor1Seats.forEach(id => f1.appendChild(createSeatHTML(id, bookedSeats.includes(id))));
                    floor2Seats.forEach(id => f2.appendChild(createSeatHTML(id, bookedSeats.includes(id))));
                });

            document.getElementById("checkoutForm").addEventListener("submit", function() {
                const btn = document.getElementById("submitBtn");
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Processing...';
                btn.classList.add('disabled');
            });
        });
    </script>
}