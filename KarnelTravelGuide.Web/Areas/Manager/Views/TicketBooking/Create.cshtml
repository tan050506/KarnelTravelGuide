@{
    ViewData["Title"] = "Find & Book Tickets";
}

<style>
    /* Style cho danh sách thả xuống tùy chỉnh */
    .custom-dropdown-menu { max-height: 250px; overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1000; width: 100%; display: none; margin-top: 5px; }
    .custom-dropdown-menu.show { display: block; }
    .dropdown-item-custom { transition: background-color 0.2s; cursor: pointer; white-space: normal; }
    .dropdown-item-custom:hover { background-color: #f8f9fa; }
    
    /* Hover cho nút Xóa khách hàng đã chọn */
    .btn-remove-customer { transition: all 0.2s; }
    .btn-remove-customer:hover { background-color: #dc3545; color: white !important; }
</style>

<div class="container py-4" style="max-width: 900px;">
    
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3"><i class="bi bi-arrow-left"></i></a>
        <h3 class="fw-bold mb-0 text-dark">Find & Book Tickets</h3>
    </div>

    @if (TempData["ErrorMessage"] != null) { 
        <div class="alert alert-danger rounded-3 fw-bold"><i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]</div> 
    }

    <form asp-action="SelectSeat" method="get" id="managerBookingForm">
        
        <div class="k-card mb-4">
            <h5 class="fw-bold text-dark mb-4 border-bottom pb-3"><i class="bi bi-person-badge text-primary me-2"></i>Customer Information</h5>
            
            <div class="d-flex gap-4 mb-4">
                <div class="form-check">
                    <input class="form-check-input fs-5" type="radio" name="CustomerType" id="typeWalkIn" value="WalkIn" checked onchange="toggleCustomerSelect()">
                    <label class="form-check-label fw-bold mt-1 text-primary" for="typeWalkIn" id="lblWalkIn">Walk-in Customer</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input fs-5" type="radio" name="CustomerType" id="typeMember" value="Member" onchange="toggleCustomerSelect()">
                    <label class="form-check-label fw-bold mt-1 text-muted" for="typeMember" id="lblMember">Existing Member</label>
                </div>
            </div>

            <div id="walkInDiv" class="row g-3">
                <div class="col-md-6">
                    <label class="label-karnel">Full Name <span class="text-danger">*</span></label>
                    <input type="text" name="WalkInName" id="inputWalkInName" class="k-input" placeholder="Enter customer name..." />
                </div>
                <div class="col-md-6">
                    <label class="label-karnel">Phone Number <span class="text-danger">*</span></label>
                    <input type="text" name="WalkInPhone" id="inputWalkInPhone" class="k-input" placeholder="Enter phone number..." />
                </div>
            </div>

            <div id="memberSelectDiv" class="d-none position-relative">
                <label class="label-karnel">Search Existing Account <span class="text-danger">*</span></label>
                
                <div class="position-relative" id="searchCustomerWrapper">
                    <input type="text" id="customerSearchInput" class="k-input" placeholder="Type phone number or name to search..." autocomplete="off">
                    
                    <div id="customerDropdown" class="custom-dropdown-menu k-card shadow-lg p-0 border"></div>
                </div>

                <div id="selectedCustomerCard" class="d-none p-3 border border-primary rounded-3 bg-primary bg-opacity-10 position-relative mt-2">
                    <button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-2 rounded-circle btn-remove-customer d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; padding: 0;" onclick="clearCustomerSelection()" title="Change Customer">
                        <i class="bi bi-x fs-5"></i>
                    </button>
                    
                    <div class="fw-bold text-primary fs-5 mb-1" id="selCustName">Customer Name</div>
                    <div class="small text-dark fw-bold">
                        <i class="bi bi-telephone-fill text-muted me-1"></i> <span id="selCustPhone">Phone</span>
                        <span class="mx-3 opacity-25">|</span>
                        <i class="bi bi-envelope-fill text-muted me-1"></i> <span id="selCustEmail">Email</span>
                    </div>
                </div>

                <input type="hidden" name="AccountId" id="hiddenAccountId" />
            </div>
        </div>

        <div class="k-card mb-4">
            <h5 class="fw-bold text-dark mb-4 border-bottom pb-3"><i class="bi bi-search text-success me-2"></i>Search Route</h5>
            
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="label-karnel">Departure (From)</label>
                    <select id="searchFrom" class="k-input bg-light">
                        <option value="">All Locations</option>
                        @foreach (var branch in ViewBag.Branches) { <option value="@branch.BranchId">@branch.BranchName</option> }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="label-karnel">Destination (To)</label>
                    <select id="searchTo" class="k-input bg-light">
                        <option value="">All Destinations</option>
                        @foreach (var spot in ViewBag.Spots) { <option value="@spot.SpotId">@spot.SpotName</option> }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="label-karnel">Transport Type</label>
                    <select id="searchType" class="k-input bg-light">
                        <option value="">All Types</option>
                        <option value="Land">🚌 Land</option>
                        <option value="Water">🛳️ Water</option>
                        <option value="Air">✈️ Air</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="label-karnel">Travel Date <span class="text-danger">*</span></label>
                    <input type="date" name="TravelDate" id="travelDate" class="k-input bg-light" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-12 mt-4 text-end">
                    <button type="button" class="k-btn-primary px-5 py-3 w-100" onclick="filterRoutes()"><i class="bi bi-search me-2"></i> Find Routes</button>
                </div>
            </div>
        </div>

        <div id="routeResultsContainer"></div>
        <input type="hidden" name="TransportationId" id="hiddenTransportId" />
    </form>
</div>

@section Scripts {
    <script>
        // --- 1. XỬ LÝ DỮ LIỆU TÌM KIẾM KHÁCH HÀNG (CUSTOM AUTOCOMPLETE) ---
        const customers = [
            @foreach(var acc in ViewBag.Customers)
            {
                <text>{ id: @acc.AccountId, name: "@Html.Raw(acc.FullName)", phone: "@Html.Raw(acc.PhoneNumber)", email: "@Html.Raw(acc.Email)" },</text>
            }
        ];

        const searchInput = document.getElementById('customerSearchInput');
        const dropdown = document.getElementById('customerDropdown');
        const hiddenId = document.getElementById('hiddenAccountId');
        const searchWrapper = document.getElementById('searchCustomerWrapper');
        const selectedCard = document.getElementById('selectedCustomerCard');

        function renderCustomerDropdown(filterText = "") {
            dropdown.innerHTML = '';
            const lowerFilter = filterText.toLowerCase();
            
            const filtered = customers.filter(c => 
                (c.name && c.name.toLowerCase().includes(lowerFilter)) || 
                (c.phone && c.phone.includes(lowerFilter))
            );

            if (filtered.length === 0) {
                dropdown.innerHTML = '<div class="p-3 text-muted small fst-italic">No customers found.</div>';
            } else {
                filtered.forEach(c => {
                    const item = document.createElement('div');
                    item.className = 'dropdown-item-custom p-3 border-bottom';
                    item.innerHTML = `
                        <div class="fw-bold text-dark fs-6 mb-1">${c.name}</div>
                        <div class="small text-muted">
                            <i class="bi bi-telephone-fill text-primary me-1"></i> ${c.phone} 
                            <span class="mx-2 opacity-50">|</span> 
                            <i class="bi bi-envelope-fill text-danger me-1"></i> ${c.email || 'N/A'}
                        </div>
                    `;
                    
                    // Sự kiện khi click chọn 1 khách hàng
                    item.onclick = function() {
                        // 1. Gán ID vào hidden field
                        hiddenId.value = c.id;
                        
                        // 2. Điền dữ liệu vào Thẻ hiển thị (Card)
                        document.getElementById('selCustName').innerText = c.name;
                        document.getElementById('selCustPhone').innerText = c.phone;
                        document.getElementById('selCustEmail').innerText = c.email || 'N/A';
                        
                        // 3. Ẩn ô input, Hiện thẻ Card
                        searchWrapper.classList.add('d-none');
                        selectedCard.classList.remove('d-none');
                        dropdown.classList.remove('show');
                    };
                    dropdown.appendChild(item);
                });
            }
            dropdown.classList.add('show');
        }

        // Hàm xóa lựa chọn để tìm lại từ đầu
        function clearCustomerSelection() {
            hiddenId.value = '';
            searchInput.value = '';
            searchWrapper.classList.remove('d-none');
            selectedCard.classList.add('d-none');
            searchInput.focus();
        }

        searchInput.addEventListener('input', function() {
            renderCustomerDropdown(this.value);
        });
        searchInput.addEventListener('focus', function() {
            renderCustomerDropdown(this.value);
        });
        document.addEventListener('click', function(e) {
            if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.classList.remove('show');
            }
        });


        // --- 2. XỬ LÝ LỌC TUYẾN XE ---
        const allRoutes = [
            @foreach(var r in ViewBag.Routes)
            {
                <text>
                {
                    id: @r.TransportationId,
                    name: "@Html.Raw(r.TransportName)",
                    type: "@Html.Raw(r.TransportType)",
                    fromId: "@r.FromBranchId",
                    fromName: "@Html.Raw(r.FromBranch?.BranchName)",
                    toId: "@r.ToSpotId",
                    toName: "@Html.Raw(r.ToSpot?.SpotName)",
                    time: "@(r.DepartureTime?.ToString("HH:mm"))",
                    price: @(r.PriceTransport ?? 0)
                },
                </text>
            }
        ];

        function toggleCustomerSelect() {
            var isMember = document.getElementById("typeMember").checked;
            document.getElementById("walkInDiv").className = isMember ? "d-none" : "row g-3";
            document.getElementById("memberSelectDiv").className = isMember ? "d-block position-relative" : "d-none position-relative";

            document.getElementById("lblWalkIn").classList.toggle("text-muted", isMember);
            document.getElementById("lblWalkIn").classList.toggle("text-primary", !isMember);
            document.getElementById("lblMember").classList.toggle("text-muted", !isMember);
            document.getElementById("lblMember").classList.toggle("text-primary", isMember);
        }

        function filterRoutes() {
            const fromId = document.getElementById('searchFrom').value;
            const toId = document.getElementById('searchTo').value;
            const type = document.getElementById('searchType').value;
            const date = document.getElementById('travelDate').value;

            if (!date) { alert("Please select a travel date!"); return; }

            const results = allRoutes.filter(r => {
                return (!fromId || r.fromId == fromId) && (!toId || r.toId == toId) && (!type || r.type == type);
            });

            const container = document.getElementById('routeResultsContainer');
            container.innerHTML = '<h5 class="fw-bold mb-3 mt-4 text-dark"><i class="bi bi-list-check text-primary me-2"></i>Suggested Routes</h5>';

            if (results.length === 0) {
                container.innerHTML += '<div class="k-card text-center py-5 text-muted"><i class="bi bi-journal-x fs-1"></i><p class="mt-2 fw-bold">No matching routes found.</p></div>';
                return;
            }

            results.forEach(r => {
                container.innerHTML += `
                <div class="k-card mb-3 p-4 border border-primary border-opacity-10 transition-all hover-scale cursor-pointer">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-bus-front-fill fs-3 text-primary me-3"></i>
                            <div>
                                <h5 class="mb-1 fw-bold text-dark">${r.name}</h5>
                                <span class="badge bg-light text-dark border">${r.type}</span>
                            </div>
                        </div>
                    </div>
                    <div class="row align-items-center text-center mb-4">
                        <div class="col-4">
                            <h3 class="fw-bold text-dark mb-1">${r.time}</h3>
                            <small class="text-muted fw-bold">${r.fromName}</small>
                        </div>
                        <div class="col-4"><i class="bi bi-arrow-right fs-4 text-muted"></i></div>
                        <div class="col-4">
                            <h3 class="fw-bold text-primary mb-1">Arrival</h3>
                            <small class="text-muted fw-bold">${r.toName}</small>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <div>
                            <small class="text-muted d-block fw-bold">Ticket Price</small>
                            <h4 class="text-success fw-bold mb-0">$${r.price.toLocaleString('en-US')}</h4>
                        </div>
                        <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" onclick="selectRoute(${r.id})">Select Seats</button>
                    </div>
                </div>`;
            });
        }

        function selectRoute(id) {
            var isMember = document.getElementById("typeMember").checked;
            if (!isMember) {
                if (!document.getElementById("inputWalkInName").value || !document.getElementById("inputWalkInPhone").value) {
                    alert("Please enter full name and phone number for walk-in customer!"); return;
                }
            } else {
                if (!document.getElementById("hiddenAccountId").value) {
                    alert("Please select a customer account first! (Make sure to click a name from the list)"); return;
                }
            }

            document.getElementById('hiddenTransportId').value = id;
            document.getElementById('managerBookingForm').submit();
        }
    </script>
}