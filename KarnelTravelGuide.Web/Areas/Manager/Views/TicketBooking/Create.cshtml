@using KarnelTravelGuide.Web.Models.Entities
@{
    ViewData["Title"] = "Find & Book Tickets";
    var customersList = ViewBag.Customers as IEnumerable<Account> ?? new List<Account>();
    var branchesList = ViewBag.Branches as IEnumerable<Branch> ?? new List<Branch>();
    var spotsList = ViewBag.Spots as IEnumerable<TouristSpot> ?? new List<TouristSpot>();
    var routesList = ViewBag.Routes as IEnumerable<Transportation> ?? new List<Transportation>();
}

<style>
    .custom-dropdown-menu { max-height: 250px; overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1000; width: 100%; display: none; margin-top: 5px; }
    .custom-dropdown-menu.show { display: block; }
    .dropdown-item-custom { transition: background-color 0.2s; cursor: pointer; white-space: normal; }
    .dropdown-item-custom:hover { background-color: #f8f9fa; }
    .btn-remove-customer { transition: all 0.2s; }
    .btn-remove-customer:hover { background-color: #dc3545; color: white !important; }
</style>

<div class="container py-4" style="max-width: 900px;">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="bi bi-arrow-left"></i></a>
        <h3 class="fw-bold mb-0 text-dark">Find & Book Tickets</h3>
    </div>

    @if (TempData["ErrorMessage"] != null) { 
        <div class="alert alert-danger rounded-3 fw-bold"><i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]</div> 
    }

    <form asp-action="SelectSeat" method="get" id="managerBookingForm">
        <div class="k-card p-4 bg-white rounded-4 shadow-sm border-0 mb-4">
            <h5 class="fw-bold text-dark mb-4 border-bottom pb-3"><i class="bi bi-person-badge text-primary me-2"></i>Customer Information</h5>
            
            <div class="d-flex gap-4 mb-4">
                <div class="form-check">
                    <input class="form-check-input fs-5" type="radio" name="CustomerType" id="typeWalkIn" value="WalkIn" checked onchange="toggleCustomerSelect()">
                    <label class="form-check-label fw-bold mt-1 text-primary" for="typeWalkIn" id="lblWalkIn">Walk-in Customer</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input fs-5" type="radio" name="CustomerType" id="typeMember" value="Member" onchange="toggleCustomerSelect()">
                    <label class="form-check-label fw-bold mt-1 text-muted" for="typeMember" id="lblMember">Existing Member</label>
                </div>
            </div>

            <div id="walkInDiv" class="row g-3">
                <div class="col-md-6">
                    <label class="fw-bold text-dark mb-2">Full Name <span class="text-danger">*</span></label>
                    <input type="text" name="WalkInName" id="inputWalkInName" class="form-control bg-light border" placeholder="Enter customer name..." />
                </div>
                <div class="col-md-6">
                    <label class="fw-bold text-dark mb-2">Phone Number (VN) <span class="text-danger">*</span></label>
                    <input type="text" name="WalkInPhone" id="inputWalkInPhone" class="form-control bg-light border" placeholder="e.g. 0912345678" maxlength="10" />
                    <small class="text-danger fw-bold d-none mt-1" id="phoneErrorMsg"><i class="bi bi-exclamation-triangle-fill me-1"></i> Invalid format. Must be 10 digits starting with 03, 05, 07, 08, or 09.</small>
                </div>
            </div>

            <div id="memberSelectDiv" class="d-none position-relative">
                <label class="fw-bold text-dark mb-2">Search Existing Account <span class="text-danger">*</span></label>
                <div class="position-relative" id="searchCustomerWrapper">
                    <input type="text" id="customerSearchInput" class="form-control bg-light border" placeholder="Type phone number or name to search..." autocomplete="off">
                    <div id="customerDropdown" class="custom-dropdown-menu k-card shadow-lg p-0 border"></div>
                </div>
                <div id="selectedCustomerCard" class="d-none p-3 border border-primary rounded-3 bg-primary bg-opacity-10 position-relative mt-2">
                    <button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-2 rounded-circle btn-remove-customer d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; padding: 0;" onclick="clearCustomerSelection()" title="Change Customer"><i class="bi bi-x fs-5"></i></button>
                    <div class="fw-bold text-primary fs-5 mb-1" id="selCustName">Customer Name</div>
                    <div class="small text-dark fw-bold">
                        <i class="bi bi-telephone-fill text-muted me-1"></i> <span id="selCustPhone">Phone</span>
                        <span class="mx-3 opacity-25">|</span>
                        <i class="bi bi-envelope-fill text-muted me-1"></i> <span id="selCustEmail">Email</span>
                    </div>
                </div>
                <input type="hidden" name="AccountId" id="hiddenAccountId" />
            </div>
        </div>

        <div class="k-card p-4 bg-white rounded-4 shadow-sm border-0 mb-4">
            <h5 class="fw-bold text-dark mb-4 border-bottom pb-3"><i class="bi bi-search text-success me-2"></i>Search Routes</h5>
            <div class="row g-4">
                
                <div class="col-md-6 position-relative">
                    <label class="fw-bold text-dark mb-2">Departure (From)</label>
                    <div class="position-relative">
                        <input type="text" id="fromSearchInput" class="form-control bg-light border mb-1" placeholder="Type branch name..." autocomplete="off">
                        <input type="hidden" id="searchFrom" />
                        <div id="fromDropdown" class="custom-dropdown-menu k-card shadow-lg p-0 border"></div>
                    </div>
                </div>
                
                <div class="col-md-6 position-relative">
                    <label class="fw-bold text-dark mb-2">Destination (To)</label>
                    <div class="position-relative">
                        <input type="text" id="toSearchInput" class="form-control bg-light border mb-1" placeholder="Type destination name..." autocomplete="off">
                        <input type="hidden" id="searchTo" />
                        <div id="toDropdown" class="custom-dropdown-menu k-card shadow-lg p-0 border"></div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="fw-bold text-dark mb-2">Travel Date <span class="text-danger">*</span></label>
                    <input type="date" name="TravelDate" id="travelDate" class="form-control bg-light border" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>
                
                <div class="col-md-6">
                    <label class="fw-bold text-dark mb-2">Time Filter <span class="text-muted fw-normal">(Optional)</span></label>
                    <input type="time" id="travelTime" class="form-control bg-light border" />
                </div>

                <div class="col-12 mt-4 text-end">
                    <button type="button" class="btn btn-primary px-5 py-3 w-100 fw-bold rounded-3" onclick="filterRoutes()"><i class="bi bi-search me-2"></i> Find Routes</button>
                </div>
             </div>
        </div>

        <div id="routeResultsContainer"></div>
        <input type="hidden" name="TransportationId" id="hiddenTransportId" />
    </form>
</div>

@section Scripts {
    <script>
        // ================== LOGIC VALIDATION SỐ ĐIỆN THOẠI ==================
        const walkInPhoneInput = document.getElementById('inputWalkInPhone');
        const phoneErrorMsg = document.getElementById('phoneErrorMsg');

        function validatePhone() {
            // Regex bắt buộc 10 số, đầu số 03, 05, 07, 08, 09
            const phoneRegex = /^(03|05|07|08|09)\d{8}$/;
            const val = walkInPhoneInput.value.trim();
            
            if (val === '') {
                walkInPhoneInput.classList.remove('border-danger');
                phoneErrorMsg.classList.add('d-none');
                return false; 
            }

            if (!phoneRegex.test(val)) {
                walkInPhoneInput.classList.add('border-danger');
                phoneErrorMsg.classList.remove('d-none');
                return false;
            } else {
                walkInPhoneInput.classList.remove('border-danger');
                phoneErrorMsg.classList.add('d-none');
                return true;
            }
        }
        walkInPhoneInput.addEventListener('input', function() {
            // Loại bỏ các ký tự không phải số trong lúc gõ
            this.value = this.value.replace(/[^0-9]/g, '');
            validatePhone();
        });


        // ================== TÌM KIẾM KHÁCH HÀNG (MEMBER) ==================
        const customers = [
            @foreach(var acc in customersList) { <text>{ id: @acc.AccountId, name: "@Html.Raw(acc.FullName)", phone: "@Html.Raw(acc.PhoneNumber)", email: "@Html.Raw(acc.Email)" },</text> }
        ];
        const searchInput = document.getElementById('customerSearchInput');
        const dropdown = document.getElementById('customerDropdown');
        const hiddenId = document.getElementById('hiddenAccountId');
        const searchWrapper = document.getElementById('searchCustomerWrapper');
        const selectedCard = document.getElementById('selectedCustomerCard');

        function renderCustomerDropdown(filterText = "") {
            dropdown.innerHTML = '';
            const lowerFilter = filterText.toLowerCase();
            const filtered = customers.filter(c => (c.name && c.name.toLowerCase().includes(lowerFilter)) || (c.phone && c.phone.includes(lowerFilter)));
            if (filtered.length === 0) {
                dropdown.innerHTML = '<div class="p-3 text-muted small fst-italic">No customers found.</div>';
            } else {
                filtered.forEach(c => {
                    const item = document.createElement('div');
                    item.className = 'dropdown-item-custom p-3 border-bottom';
                    item.innerHTML = `<div class="fw-bold text-dark fs-6 mb-1">${c.name}</div><div class="small text-muted"><i class="bi bi-telephone-fill text-primary me-1"></i> ${c.phone}</div>`;
                    item.onclick = function() {
                        hiddenId.value = c.id;
                        document.getElementById('selCustName').innerText = c.name;
                        document.getElementById('selCustPhone').innerText = c.phone;
                        document.getElementById('selCustEmail').innerText = c.email || 'N/A';
                        searchWrapper.classList.add('d-none');
                        selectedCard.classList.remove('d-none');
                        dropdown.classList.remove('show');
                    };
                    dropdown.appendChild(item);
                });
            }
            dropdown.classList.add('show');
        }

        function clearCustomerSelection() { hiddenId.value = ''; searchInput.value = ''; searchWrapper.classList.remove('d-none'); selectedCard.classList.add('d-none'); searchInput.focus(); }
        searchInput.addEventListener('input', function() { renderCustomerDropdown(this.value); });
        searchInput.addEventListener('focus', function() { renderCustomerDropdown(this.value); });
        document.addEventListener('click', function(e) { if (!searchInput.contains(e.target) && !dropdown.contains(e.target)) dropdown.classList.remove('show'); });

        function toggleCustomerSelect() {
            var isMember = document.getElementById("typeMember").checked;
            document.getElementById("walkInDiv").className = isMember ? "d-none" : "row g-3";
            document.getElementById("memberSelectDiv").className = isMember ? "d-block position-relative" : "d-none position-relative";
            document.getElementById("lblWalkIn").classList.toggle("text-muted", isMember);
            document.getElementById("lblWalkIn").classList.toggle("text-primary", !isMember);
            document.getElementById("lblMember").classList.toggle("text-muted", !isMember);
            document.getElementById("lblMember").classList.toggle("text-primary", isMember);
        }


        // ================== DROPDOWN CHO FROM VÀ TO ==================
        const branches = [ @foreach(var b in branchesList) { <text>{ id: @b.BranchId, name: "@Html.Raw(b.BranchName)" },</text> } ];
        const spots = [ @foreach(var s in spotsList) { <text>{ id: @s.SpotId, name: "@Html.Raw(s.SpotName)" },</text> } ];

        const fromInput = document.getElementById('fromSearchInput'); const fromDropdown = document.getElementById('fromDropdown'); const hiddenFromId = document.getElementById('searchFrom');
        const toInput = document.getElementById('toSearchInput'); const toDropdown = document.getElementById('toDropdown'); const hiddenToId = document.getElementById('searchTo');

        function renderFromDropdown(filterText = "") {
            fromDropdown.innerHTML = '';
            const lowerFilter = filterText.toLowerCase();
            const filtered = branches.filter(b => b.name.toLowerCase().includes(lowerFilter));

            const anyItem = document.createElement('div');
            anyItem.className = 'dropdown-item-custom p-3 border-bottom text-primary fw-bold';
            anyItem.innerText = "-- All Branches --";
            anyItem.onclick = function() { hiddenFromId.value = ""; fromInput.value = ""; fromDropdown.classList.remove('show'); };
            fromDropdown.appendChild(anyItem);

            filtered.forEach(b => {
                const item = document.createElement('div');
                item.className = 'dropdown-item-custom p-3 border-bottom fw-bold text-dark';
                item.innerText = b.name;
                item.onclick = function() { hiddenFromId.value = b.id; fromInput.value = b.name; fromDropdown.classList.remove('show'); };
                fromDropdown.appendChild(item);
            });
            fromDropdown.classList.add('show');
        }

        function renderToDropdown(filterText = "") {
            toDropdown.innerHTML = '';
            const lowerFilter = filterText.toLowerCase();
            const filtered = spots.filter(s => s.name.toLowerCase().includes(lowerFilter));

            const anyItem = document.createElement('div');
            anyItem.className = 'dropdown-item-custom p-3 border-bottom text-primary fw-bold';
            anyItem.innerText = "-- All Destinations --";
            anyItem.onclick = function() { hiddenToId.value = ""; toInput.value = ""; toDropdown.classList.remove('show'); };
            toDropdown.appendChild(anyItem);

            filtered.forEach(s => {
                const item = document.createElement('div');
                item.className = 'dropdown-item-custom p-3 border-bottom fw-bold text-dark';
                item.innerText = s.name;
                item.onclick = function() { hiddenToId.value = s.id; toInput.value = s.name; toDropdown.classList.remove('show'); };
                toDropdown.appendChild(item);
            });
            toDropdown.classList.add('show');
        }

        fromInput.addEventListener('input', function() { hiddenFromId.value = ''; renderFromDropdown(this.value); });
        fromInput.addEventListener('focus', function() { renderFromDropdown(this.value); });
        toInput.addEventListener('input', function() { hiddenToId.value = ''; renderToDropdown(this.value); });
        toInput.addEventListener('focus', function() { renderToDropdown(this.value); });

        document.addEventListener('click', function(e) {
            if (!fromInput.contains(e.target) && !fromDropdown.contains(e.target)) fromDropdown.classList.remove('show');
            if (!toInput.contains(e.target) && !toDropdown.contains(e.target)) toDropdown.classList.remove('show');
        });


        // ================== LỌC VÀ HIỂN THỊ CHUYẾN XE ==================
        const allRoutes = [
            @foreach(var r in routesList) {
                <text>
                {
                    id: @r.TransportationId,
                    name: "@Html.Raw(r.TransportName)",
                    fromId: "@r.FromBranchId",
                    fromName: "@Html.Raw(r.FromBranch?.BranchName)",
                    toId: "@r.ToSpotId",
                    toName: "@Html.Raw(r.ToSpot?.SpotName)",
                    price: @(r.PriceTransport ?? 0),
                    time: "@r.DepartureTime?.ToString("HH:mm")",
                    imageUrl: "@Html.Raw(string.IsNullOrEmpty(r.ImageUrl) ? "/img/no-image.jpg" : r.ImageUrl)"
                },
                </text>
            }
        ];

        function filterRoutes() {
            const fromId = document.getElementById('searchFrom').value;
            const toId = document.getElementById('searchTo').value;
            const travelDate = document.getElementById('travelDate').value;
            const travelTime = document.getElementById('travelTime').value;
            
            if (!travelDate) { alert("Please select Travel Date!"); return; }

            const results = allRoutes.filter(r => { 
                let matchFrom = !fromId || r.fromId == fromId;
                let matchTo = !toId || r.toId == toId;
                let matchTime = !travelTime || r.time === travelTime;
                return matchFrom && matchTo && matchTime;
            });

            const container = document.getElementById('routeResultsContainer');
            container.innerHTML = '<h5 class="fw-bold mb-3 mt-4 text-dark"><i class="bi bi-list-check text-primary me-2"></i>Available Routes</h5>';
            
            if (results.length === 0) {
                container.innerHTML += '<div class="k-card p-5 bg-white rounded-4 shadow-sm border-0 text-center text-muted"><i class="bi bi-emoji-frown fs-1"></i><p class="mt-2 fw-bold">No matching routes found.</p></div>';
                return;
            }

            results.forEach(r => {
                container.innerHTML += `
                <div class="k-card mb-3 p-4 bg-white rounded-4 shadow-sm border border-primary border-opacity-10 transition-all hover-scale cursor-pointer">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center">
                            <img src="${r.imageUrl}" style="width: 80px; height: 60px; object-fit: cover; border-radius: 8px;" class="me-3 border shadow-sm" />
                            <div>
                                <h5 class="mb-1 fw-bold text-dark">${r.name}</h5>
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25"><i class="bi bi-clock me-1"></i> ${r.time}</span>
                            </div>
                        </div>
                    </div>
                    <div class="row text-center bg-light p-2 rounded-3 mb-3 border g-0 align-items-center">
                        <div class="col-5">
                            <small class="text-muted d-block text-uppercase">From</small>
                            <small class="text-dark fw-bold">${r.fromName}</small>
                        </div>
                        <div class="col-2"><i class="bi bi-arrow-right text-primary"></i></div>
                        <div class="col-5">
                            <small class="text-muted d-block text-uppercase">To</small>
                            <small class="text-primary fw-bold">${r.toName}</small>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <div>
                            <small class="text-muted d-block fw-bold">Ticket Price</small>
                            <h4 class="text-success fw-bold mb-0">$${r.price.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 })}</h4>
                        </div>
                        <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" onclick="selectRoute(${r.id})">Select Seats</button>
                    </div>
                </div>`;
            });
        }

        // ================== CHỌN GHẾ & SUBMIT ==================
        function selectRoute(id) {
            var isMember = document.getElementById("typeMember").checked;
            if (!isMember) {
                if (!document.getElementById("inputWalkInName").value.trim()) {
                    alert("Please enter full name for walk-in customer!");
                    document.getElementById("inputWalkInName").focus();
                    return;
                }
                if (!validatePhone()) {
                    alert("Please check the phone number format!");
                    walkInPhoneInput.focus();
                    return;
                }
            } else {
                if (!document.getElementById("hiddenAccountId").value) {
                    alert("Please select a customer account first! (Make sure to click a name from the list)"); 
                    return;
                }
            }
            document.getElementById('hiddenTransportId').value = id;
            document.getElementById('managerBookingForm').submit();
        }
    </script>
}