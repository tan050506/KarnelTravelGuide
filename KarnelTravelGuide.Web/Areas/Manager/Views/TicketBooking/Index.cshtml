@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.Order>
@{
    ViewData["Title"] = "Ticket Bookings";

    int totalCount = Model?.Count() ?? 0;
    bool isDescending = ViewData["CurrentSort"]?.ToString() == "id_desc";
    int displayIndex = isDescending ? totalCount : 1;
}

<div class="k-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <form asp-action="Index" method="get" class="d-flex w-50 gap-2">
            <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="k-input m-0" placeholder="Customer name or phone...">
            <input type="date" name="travelDate" value="@ViewData["CurrentDate"]" class="k-input m-0" style="max-width: 160px;" />
            <button type="submit" class="btn btn-primary px-4 fw-bold rounded-3"><i class="bi bi-search"></i></button>
        </form>
        <a asp-action="Create" class="k-btn-primary"><i class="bi bi-plus-lg me-2"></i> Walk-in Booking</a>
    </div>

    @if (TempData["SuccessMessage"] != null) {
        <div class="alert alert-success rounded-3 fw-bold"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th style="width: 5%; text-align: center;">
                        <a asp-action="Index"
                           asp-route-sortOrder="@ViewData["IdSortParm"]"
                           asp-route-searchString="@ViewData["CurrentSearch"]"
                           asp-route-travelDate="@ViewData["CurrentDate"]"
                           class="text-decoration-none text-dark d-flex justify-content-center align-items-center"
                           title="Click to sort">
                            <i class="bi bi-arrow-down-up fs-5 fw-bold text-dark"></i>
                        </a>
                    </th>
                    <th>Customer</th>
                    <th>Route Info</th>
                    <th>Date & Time</th>
                    <th>Total</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any()) {
                    foreach (var order in Model) {
                        var firstTicket = order.OrderDetails?.FirstOrDefault(od => od.TicketBooking != null)?.TicketBooking;
                        if (firstTicket == null) continue;

                        var seats = string.Join(", ", order.OrderDetails!.Where(od => od.TicketBooking != null).Select(od => od.TicketBooking!.Seat));
                        <tr>
                            <td class="fw-bold text-secondary fs-6 text-center">@displayIndex</td>
                            <td>
                                <strong class="text-dark d-block">@(order.Account?.FullName ?? "Unknown")</strong>
                                <small class="text-muted"><i class="bi bi-telephone text-primary me-1"></i>@(order.Account?.PhoneNumber ?? "N/A")</small>
                            </td>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1 mb-1 border border-primary border-opacity-25">Seats: @seats</span>
                                <div class="text-dark fw-bold small">@firstTicket.Transportation?.TransportName</div>
                            </td>
                            <td>
                                <div class="text-danger fw-bold"><i class="bi bi-calendar-event me-1"></i>@(firstTicket.TravelDate.HasValue ? firstTicket.TravelDate.Value.ToString("dd/MM/yyyy") : "N/A")</div>
                                <div class="text-muted small">@firstTicket.Transportation?.DepartureTime?.ToString("HH:mm")</div>
                            </td>
                            <td class="fw-bold text-success fs-6">$@order.TotalAmount?.ToString("N0")</td>
                            <td class="text-center">
                                @if (order.Status == "Confirmed") { <span class="badge bg-success">Confirmed</span> }
                                else if (order.Status == "Canceled") { <span class="badge bg-danger">Canceled</span> }
                                else { <span class="badge bg-warning text-dark">Pending</span> }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-light text-info fw-bold" title="View Details"><i class="bi bi-eye"></i></a>
                                
                                @if (order.Status == "Pending") {
                                    <form asp-action="ConfirmBooking" method="post" class="d-inline">
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <button type="submit" class="btn btn-sm btn-light text-success fw-bold mx-1" title="Confirm Booking"><i class="bi bi-check-lg"></i></button>
                                    </form>
                                }
                                @if (order.Status != "Canceled") {
                                    <form asp-action="CancelOrder" method="post" class="d-inline" onsubmit="return confirm('Canceling this order will release the seats. Are you sure?');">
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <button type="submit" class="btn btn-sm btn-light text-danger fw-bold" title="Cancel Booking"><i class="bi bi-x-circle"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                        
                        if (isDescending) { displayIndex--; } else { displayIndex++; }
                    }
                } else {
                    <tr><td colspan="7" class="text-center py-5 text-muted fw-bold">No bookings found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>