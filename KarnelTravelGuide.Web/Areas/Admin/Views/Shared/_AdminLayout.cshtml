<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Karnel Admin</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            min-height: 100vh;
            background-color: #f8f9fa;
        }
        #sidebar {
            min-width: 250px;
            max-width: 250px;
            min-height: 100vh;
            transition: all 0.3s;
        }
        #sidebar.collapsed {
            margin-left: -250px;
        }
        #content {
            width: 100%;
            transition: all 0.3s;
        }
        .nav-link {
            color: rgba(255,255,255,.8);
            margin-bottom: 5px;
            border-radius: 5px;
        }
        .nav-link:hover, .nav-link.active {
            color: #fff;
            background-color: rgba(255,255,255,.1);
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <nav id="sidebar" class="bg-dark text-white p-3">
            <div class="d-flex align-items-center mb-4 text-white text-decoration-none">
                <i class="bi bi-compass fs-3 me-2 text-warning"></i>
                <span class="fs-4 fw-bold">Karnel Admin</span>
            </div>
            <hr>
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Account" asp-action="Index" class="nav-link">
                        <i class="bi bi-people me-2"></i> Quản lý Tài khoản
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="TouristSpot" asp-action="Index" class="nav-link">
                        <i class="bi bi-geo-alt me-2"></i> Quản lý Địa điểm
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Hotel" asp-action="Index" class="nav-link">
                        <i class="bi bi-building me-2"></i> Quản lý Khách sạn
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Resort" asp-action="Index" class="nav-link">
                        <i class="bi bi-house-heart me-2"></i> Quản lý Resort
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Restaurant" asp-action="Index" class="nav-link">
                        <i class="bi bi-cup-hot me-2"></i> Quản lý Nhà hàng
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Transportation" asp-action="Index" class="nav-link">
                        <i class="bi bi-car-front me-2"></i> Quản lý Phương tiện
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Branch" asp-action="Index" class="nav-link">
                        <i class="bi bi-shop me-2"></i> Quản lý Chi nhánh
                    </a>
                </li>
                <hr />
                <li>
                    <a asp-area="Admin" asp-controller="Booking" asp-action="Index" class="nav-link">
                        <i class="bi bi-calendar-check me-2"></i> Quản lý Đặt chỗ (Booking)
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Invoice" asp-action="Index" class="nav-link">
                        <i class="bi bi-receipt me-2"></i> Thống kê Hóa đơn
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Feedback" asp-action="Index" class="nav-link">
                        <i class="bi bi-chat-left-text me-2"></i> Quản lý Phản hồi
                    </a>
                </li>
            </ul>
        </nav>

        <div id="content" class="d-flex flex-column">
            <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm px-4 py-3">
                <button class="btn btn-outline-secondary" id="sidebarToggle">
                    <i class="bi bi-list fs-5"></i>
                </button>
                
                <div class="ms-auto d-flex align-items-center">
                    <span class="me-3 fw-semibold">Xin chào, Admin!</span>
                    <a href="/Home/Index" class="btn btn-sm btn-outline-primary me-2" target="_blank">Xem trang chủ</a>
                    <a href="/Auth/Logout" class="btn btn-sm btn-danger">Đăng xuất</a>
                </div>
            </nav>

            <main class="p-4 flex-grow-1">
                @RenderBody()
            </main>

            <footer class="bg-white text-center py-3 border-top mt-auto">
                <span class="text-muted">© 2026 Karnel Travel Guide. All rights reserved.</span>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        document.getElementById('sidebarToggle').addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('collapsed');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>