@model KarnelTravelGuide.Web.Models.Entities.Feedback

@{
    ViewData["Title"] = "Phản hồi Khách hàng";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h4 text-danger fw-bold"><i class="bi bi-chat-dots-fill me-2"></i>@ViewData["Title"]</h2>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </div>

            <div class="card shadow border-0 rounded-3 mb-4">
                <div class="card-header bg-dark text-white p-3">
                    <h5 class="card-title mb-0 fs-6"><i class="bi bi-person-circle me-2"></i>Thông tin Khách hàng</h5>
                </div>
                <div class="card-body p-4 bg-light">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <span class="text-muted d-block small fw-bold text-uppercase">Khách hàng</span>
                            <span class="fs-5 fw-medium">@(Model.Account?.FullName ?? "Khách vãng lai")</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <span class="text-muted d-block small fw-bold text-uppercase">Đối tượng đánh giá</span>
                            <span class="fs-6">
                                @if (Model.Stay != null)
                                {
                                    <span class="badge bg-primary rounded-pill"><i class="bi bi-building me-1"></i> @Model.Stay.Name</span>
                                }
                                else if (Model.Restaurant != null)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill"><i class="bi bi-cup-hot-fill me-1"></i> @Model.Restaurant.RestaurantName</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill">Đánh giá chung</span>
                                }
                            </span>
                        </div>
                        <div class="col-12 mt-2">
                            <span class="text-muted d-block small fw-bold text-uppercase mb-2">Lời nhắn / Đánh giá</span>
                            <div class="p-3 bg-white border rounded">
                                @if(string.IsNullOrWhiteSpace(Model.Message))
                                {
                                     <span class="text-muted fst-italic">Không có nội dung.</span>
                                }
                                else
                                {
                                     @Model.Message
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow border-0 rounded-3 border-top border-4 border-danger">
                <div class="card-body p-4">
                    <h5 class="card-title mb-4 fw-bold text-danger"><i class="bi bi-reply-all-fill me-2"></i>Nội dung Phản hồi</h5>
                    <form asp-action="Reply">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="FeedbackId" />
                        
                        <div class="form-group mb-4">
                            <label asp-for="ReplyMessage" class="form-label fw-bold">Soạn phản hồi của bạn:</label>
                            <textarea asp-for="ReplyMessage" class="form-control" rows="5" placeholder="Nhập nội dung trả lời khách hàng tại đây..."></textarea>
                            <span asp-validation-for="ReplyMessage" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light border px-4">Hủy bỏ</a>
                            <button type="submit" class="btn btn-danger px-4 fw-bold">
                                <i class="bi bi-send-fill me-2"></i> Gửi Phản Hồi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
