@model KarnelTravelGuide.Web.Models.Entities.Branch

@{
    ViewData["Title"] = "Update Branch";
    Layout = "_AdminLayout";
}

<div class="container-fluid p-0">
    <h1 class="h3 mb-4 text-gray-800">Update Branch: @Model.BranchName</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="BranchId" />
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="BranchName" class="form-label">Branch Name</label>
                        <input asp-for="BranchName" class="form-control" placeholder="Enter branch name" required />
                        <span asp-validation-for="BranchName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Address" class="form-label">Address</label>
                        <input asp-for="Address" class="form-control" placeholder="Enter address" required />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PhoneBranch" class="form-label">Phone Number</label>
                        <input asp-for="PhoneBranch" class="form-control" placeholder="Enter phone number" required />
                        <span asp-validation-for="PhoneBranch" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EmailBranch" class="form-label">Email</label>
                        <input asp-for="EmailBranch" class="form-control" type="email" placeholder="Enter branch email" required />
                        <span asp-validation-for="EmailBranch" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Change image (Leave blank to keep current)</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mt-2">
                                <p class="mb-1 text-muted small">Current image:</p>
                                <img src="@Model.ImageUrl" alt="Current Image" class="img-thumbnail" style="max-height: 150px; object-fit: cover;" />
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-warning text-dark">Save Changes</button>
                    <a asp-action="Index" class="btn btn-secondary">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
