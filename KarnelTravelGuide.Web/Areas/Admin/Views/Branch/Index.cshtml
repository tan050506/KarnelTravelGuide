@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.Branch>

@{
    ViewData["Title"] = "Quản lý Chi Nhánh";
    Layout = "_AdminLayout";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["Success"]
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách Chi Nhánh</h6>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm"><i class="bi bi-plus"></i> Thêm Mới</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 text-sm" style="font-size: 0.9rem;">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Tên Chi Nhánh</th>
                        <th>Địa Chỉ</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th class="text-center" style="width: 120px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 align-middle">@item.BranchId</td>
                            <td class="align-middle fw-semibold">@item.BranchName</td>
                            <td class="align-middle text-truncate" style="max-width: 200px;" title="@item.Address">@item.Address</td>
                            <td class="align-middle">@item.PhoneBranch</td>
                            <td class="align-middle">@item.EmailBranch</td>
                            <td class="text-center align-middle">
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.BranchId" class="btn btn-warning btn-sm py-0 px-2" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                    <form asp-action="Delete" asp-route-id="@item.BranchId" method="post" onsubmit="return confirm('Xóa chi nhánh này có thể xóa cả các liên kết liên quan (Tài khoản, Địa điểm du lịch, v.v.). Bạn có chắc chắn muốn xóa?');" style="margin: 0;">
                                        <button type="submit" class="btn btn-danger btn-sm py-0 px-2" title="Xóa"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
