@model KarnelTravelGuide.Web.Models.Entities.Account

@{
    ViewData["Title"] = "Sửa Tài Khoản";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <h1 class="h3 mb-2 text-gray-800">Cập nhật Tài Khoản: @Model.FullName</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="AccountId" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName" class="form-label">Họ và Tên</label>
                        <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên" required />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="Nhập email" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Password" class="form-label">Mật khẩu</label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Nhập mật khẩu mới (hoặc giữ nguyên)" required />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label">Địa chỉ</label>
                    <input asp-for="Address" class="form-control" placeholder="Nhập địa chỉ" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="RoleId" class="form-label">Vai trò</label>
                        <select asp-for="RoleId" class="form-select border" asp-items="ViewBag.RoleId" required>
                            <option value="">-- Chọn vai trò --</option>
                        </select>
                        <span asp-validation-for="RoleId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="BranchId" class="form-label">Chi nhánh</label>
                        <select asp-for="BranchId" class="form-select border" asp-items="ViewBag.BranchId">
                            <option value="">-- Chọn chi nhánh (Tùy chọn) --</option>
                        </select>
                        <span asp-validation-for="BranchId" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-warning text-dark">Lưu Thay Đổi</button>
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            function toggleBranch() {
                var selectedRole = $("#RoleId option:selected").text().trim();
                if (selectedRole.toLowerCase() === "customer") {
                    $("#BranchId").closest(".col-md-6").hide();
                    $("#BranchId").val("");
                } else {
                    $("#BranchId").closest(".col-md-6").show();
                }
            }

            $("#RoleId").change(function () {
                toggleBranch();
            });

            toggleBranch();
        });
    </script>
}