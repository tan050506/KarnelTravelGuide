@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.Account>

@{
    ViewData["Title"] = "Quản lý Tài Khoản";
    Layout = "_AdminLayout";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách Tài Khoản</h6>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm"><i class="bi bi-plus"></i> Thêm Mới</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 text-sm" style="font-size: 0.9rem;">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Họ Tên</th>
                        <th>Email</th>
                        <th>SĐT</th>
                        <th>Vai trò</th>
                        <th>Chi nhánh</th>
                        <th class="text-center" style="width: 120px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 align-middle">@item.AccountId</td>
                            <td class="align-middle fw-semibold">@item.FullName</td>
                            <td class="align-middle">@item.Email</td>
                            <td class="align-middle">@item.PhoneNumber</td>
                            <td class="align-middle">
                                @if(item.Role == "Admin") {
                                    <span class="badge bg-danger">Admin</span>
                                } else if(item.Role == "Manager") {
                                    <span class="badge bg-warning text-dark">Manager</span>
                                } else {
                                    <span class="badge bg-success">Customer</span>
                                }
                            </td>
                            <td class="align-middle text-truncate" style="max-width: 150px;" title="@(item.Branch != null ? item.Branch.BranchName : "N/A")">
                                @(item.Branch != null ? item.Branch.BranchName : "N/A")
                            </td>
                            <td class="text-center align-middle">
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.AccountId" class="btn btn-warning btn-sm py-0 px-2" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                    <form asp-action="Delete" asp-route-id="@item.AccountId" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản này?');" style="margin: 0;">
                                        <button type="submit" class="btn btn-danger btn-sm py-0 px-2" title="Xóa"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
