@{
    ViewData["Title"] = "System Monitor";
}

<div class="row mb-4">
    <div class="col-md-12">
        <h3 class="fw-bold text-dark">Welcome back, Admin!</h3>
        <p class="text-muted">Here is the overview of your system infrastructure.</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-0 border-start border-danger border-4 shadow-sm h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs fw-bold text-danger text-uppercase mb-1">Active Branches</div>
                        <div class="h3 mb-0 fw-bold text-dark">8</div>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-diagram-3 fs-1 text-secondary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-0 border-start border-primary border-4 shadow-sm h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs fw-bold text-primary text-uppercase mb-1">Total Accounts</div>
                        <div class="h3 mb-0 fw-bold text-dark">1,245</div>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-people-fill fs-1 text-secondary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-0 border-start border-success border-4 shadow-sm h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col me-2">
                        <div class="text-xs fw-bold text-success text-uppercase mb-1">System Status</div>
                        <div class="h5 mb-0 fw-bold text-dark">Healthy (Online)</div>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-server fs-1 text-secondary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>