@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.TouristSpot>
@{
    ViewData["Title"] = "Explore Destinations";
}

<style>
    body { background-color: #f8fafc; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; }
    
    .dest-hero {
        background: linear-gradient(rgba(15, 23, 42, 0.6), rgba(15, 23, 42, 0.8)), 
                    url('https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
        background-size: cover;
        padding: 100px 0;
        border-radius: 0 0 2rem 2rem;
        margin-bottom: 40px;
    }

    .search-bar-custom {
        background: #fff;
        border-radius: 50rem;
        padding: 8px 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        max-width: 600px;
        margin: 0 auto;
        transform: translateY(30px);
    }

    .dest-card {
        border-radius: 1.25rem; overflow: hidden; border: none; position: relative; cursor: pointer;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: all 0.3s ease;
    }
    .dest-card img { transition: transform 0.6s ease; height: 350px; object-fit: cover; }
    .dest-card:hover { transform: translateY(-8px); box-shadow: 0 15px 30px rgba(0,0,0,0.1); }
    .dest-card:hover img { transform: scale(1.08); }
    
    .dest-overlay {
        position: absolute; bottom: 0; left: 0; right: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0) 100%);
        padding: 2.5rem 1.5rem 1.5rem; color: white;
    }
</style>

<div class="dest-hero text-center text-white position-relative">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3">Find Your Next Adventure</h1>
        <p class="lead opacity-75 mb-0">Discover breathtaking destinations curated just for you.</p>
        
        <div class="search-bar-custom d-flex">
            <form asp-action="Index" method="get" class="d-flex w-100">
                <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control border-0 shadow-none px-4" placeholder="Search a place, city...">
                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Search</button>
            </form>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 pt-3">
        @if (Model != null && Model.Any())
        {
            foreach (var spot in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <a asp-action="Details" asp-route-id="@spot.SpotId" class="text-decoration-none">
                        <div class="card dest-card">
                            <img src="@(string.IsNullOrEmpty(spot.ImageUrl) ? "/img/no-image.jpg" : spot.ImageUrl)" class="w-100" alt="@spot.SpotName">
                            <div class="dest-overlay">
                                <h4 class="fw-bold mb-1 text-truncate">@spot.SpotName</h4>
                                <p class="small mb-0 opacity-75 text-truncate">
                                    <i class="bi bi-geo-alt text-danger me-1"></i> @spot.Address
                                </p>
                            </div>
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge bg-white text-dark py-2 px-3 rounded-pill shadow-sm"><i class="bi bi-camera me-1"></i> @spot.TouristSpotImages.Count Photos</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-map fs-1 d-block mb-3 opacity-50"></i>
                <h4 class="fw-bold">No destinations found</h4>
                <p>Try searching for another keyword or check back later.</p>
            </div>
        }
    </div>
</div>