@model KarnelTravelGuide.Web.Models.Entities.TouristSpot
@{
    ViewData["Title"] = Model.SpotName;
    // Kích hoạt Navbar trong suốt đè lên ảnh nền
    ViewData["HeroPage"] = true; 
}

<style>
    body { background-color: var(--bg); }
    
    .detail-hero {
        height: 65vh; 
        min-height: 500px;
        background-size: cover; 
        background-position: center;
        position: relative;
    }
    .detail-overlay {
        position: absolute; 
        inset: 0;
        background: linear-gradient(to top, rgba(24, 35, 46, 0.95) 0%, rgba(24, 35, 46, 0.2) 100%);
        display: flex; 
        align-items: flex-end; 
        padding-bottom: 4rem;
    }
    
    .hero-title {
        font-family: var(--ff-d);
        font-size: clamp(3rem, 5vw, 4.5rem);
        color: var(--white);
        line-height: 1.1;
    }

    .badge-brand {
        background: var(--g1);
        color: var(--white);
        letter-spacing: 0.05em;
    }
    
    .content-card {
        background: var(--white); 
        border-radius: 1.5rem; 
        padding: 3rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.04); 
        border: 1px solid var(--line); 
        margin-top: -60px; 
        position: relative; 
        z-index: 10;
    }

    .section-title {
        font-family: var(--ff-d);
        font-size: 2rem;
        font-weight: 600;
        color: var(--ink);
    }

    .gallery-img {
        width: 100%; height: 250px; object-fit: cover; 
        border-radius: 1rem;
        transition: 0.3s; cursor: pointer; 
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
    .gallery-img:hover { 
        transform: scale(1.03);
        box-shadow: 0 12px 24px rgba(0,0,0,0.12); 
    }
    
    .booking-widget {
        background: var(--white);
        border-radius: 1.5rem; 
        padding: 2.5rem; 
        border: 1px solid var(--line);
        position: sticky; top: 100px; 
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }

    .icon-wrapper {
        background: var(--g-lt);
        color: var(--g1);
        width: 70px; height: 70px;
        display: inline-flex; align-items: center; justify-content: center;
    }

    .btn-gradient {
        background: linear-gradient(135deg, var(--g1), var(--g2));
        color: var(--white);
        border: none;
        transition: opacity 0.2s, transform 0.2s;
        box-shadow: 0 4px 14px rgba(42,157,143,.3);
    }
    .btn-gradient:hover {
        opacity: 0.9;
        transform: translateY(-2px);
        color: var(--white);
    }
</style>

<div class="detail-hero" style="background-image: url('@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image.jpg" : Model.ImageUrl)');">
    <div class="detail-overlay">
        <div class="container text-white">
            <span class="badge badge-brand px-3 py-2 rounded-pill mb-3 text-uppercase fw-bold"><i class="bi bi-star-fill text-warning me-1"></i> Popular Spot</span>
            <h1 class="hero-title mb-2">@Model.SpotName</h1>
            <p class="fs-5" style="color: rgba(255,255,255,0.8);"><i class="bi bi-geo-alt-fill me-2" style="color: var(--g2);"></i>@Model.Address</p>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-5">
        <div class="col-lg-8">
            <div class="content-card mb-5">
                <h4 class="section-title mb-4">About this place</h4>
                
                <p class="lh-lg fs-6 mb-0" style="color: var(--soft); white-space: pre-line;">
                    @(string.IsNullOrEmpty(Model.Description) ? "Description is currently being updated by the manager." : Model.Description)
                </p>
            </div>

            @if (Model.TouristSpotImages != null && Model.TouristSpotImages.Any())
            {
                <h4 class="section-title mb-4"><i class="bi bi-images me-2" style="color: var(--g1);"></i>Thumbnail</h4>
                <div class="row g-3">
                    @foreach (var img in Model.TouristSpotImages)
                    {
                        <div class="col-md-6">
                            <img src="@img.ImageUrl" class="gallery-img" alt="Gallery Image" title="@img.Caption">
                            @if (!string.IsNullOrEmpty(img.Caption))
                            {
                                <p class="text-center small mt-2 fst-italic" style="color: var(--muted);">@img.Caption</p>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-4 mt-lg-0" style="margin-top: -60px; z-index: 10;">
            <div class="booking-widget text-center">
                <div class="icon-wrapper rounded-circle mb-4">
                    <i class="bi bi-ticket-perforated-fill fs-2"></i>
                </div>
                <h4 class="section-title fs-3 mb-2">Plan Your Trip</h4>
                <p class="small mb-4" style="color: var(--soft);">Book a transport ticket directly to <strong style="color: var(--ink);">@Model.SpotName</strong> and enjoy your seamless journey.</p>
                
                <ul class="list-unstyled text-start mb-4 small" style="color: var(--soft);">
                    <li class="mb-2"><i class="bi bi-check-circle-fill me-2" style="color: var(--g2);"></i> Easy online booking</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill me-2" style="color: var(--g2);"></i> Choose your favorite seat</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill me-2" style="color: var(--g2);"></i> 24/7 Support</li>
                </ul>

                <a href="/BookTicket/Index?toSpotId=@Model.SpotId" class="btn btn-gradient w-100 py-3 rounded-pill fw-bold shadow-sm">
                    Find Tickets Here <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>