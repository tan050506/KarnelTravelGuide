@model KarnelTravelGuide.Web.Models.Entities.Account
@{
    ViewData["Title"] = "My Profile";
}

<style>
    body { background-color: var(--bg); }

    .profile-card { 
        border: 1px solid var(--line); 
        border-radius: 1.5rem; 
        box-shadow: 0 15px 40px rgba(0,0,0,0.04); 
        overflow: hidden; 
        background: var(--white);
    }
    
    .profile-header { 
        background: linear-gradient(135deg, var(--g1), var(--g2)); 
        height: 140px; 
    }
    
    .avatar-wrapper { 
        margin-top: -70px; 
        text-align: center; 
        position: relative;
    }
    
    .avatar-img { 
        width: 140px; height: 140px; 
        object-fit: cover; 
        border: 6px solid var(--white); 
        box-shadow: 0 8px 25px rgba(0,0,0,0.08); 
        background-color: var(--bg);
    }
    
    .form-control-custom { 
        border-radius: 0.75rem; 
        padding: 0.8rem 1.2rem; 
        border: 1px solid var(--line); 
        background-color: var(--bg); 
        font-family: var(--ff-b);
        color: var(--ink); 
        transition: all 0.2s; 
    }
    
    .form-control-custom:focus { 
        background-color: var(--white); 
        border-color: var(--g1); 
        box-shadow: 0 0 0 4px rgba(58, 125, 94, 0.1); 
        outline: none; 
    }
    
    .btn-gradient {
        background: linear-gradient(135deg, var(--g1), var(--g2));
        color: var(--white);
        border: none;
        transition: opacity 0.2s, transform 0.2s;
        box-shadow: 0 4px 14px rgba(42,157,143,.3);
    }
    
    .btn-gradient:hover {
        opacity: 0.9;
        transform: translateY(-2px);
        color: var(--white);
    }

    .section-title {
        font-family: var(--ff-d);
        color: var(--ink);
        font-weight: 600;
    }
</style>

<div class="container py-5 mt-4 mb-5" style="max-width: 900px;">

    @if (TempData["SuccessMessage"] != null) {
        <div class="alert alert-success rounded-4 fw-bold mb-4 shadow-sm border-0" style="background-color: var(--t-lt); color: var(--g1);"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
    }

    <div class="profile-card">
        <div class="profile-header"></div>
        
        <form asp-action="Profile" method="post" enctype="multipart/form-data">
            <div class="card-body px-4 px-md-5 pb-5">
                
                <div class="avatar-wrapper mb-4">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img id="avatarPreview" src="@Model.AvatarUrl" class="rounded-circle avatar-img" />
                    }
                    else
                    {
                        <img id="avatarPreview" src="https://ui-avatars.com/api/?name=@Model.FullName&background=2a9d8f&color=fff&size=150" class="rounded-circle avatar-img" />
                    }
                    
                    <div class="mt-4">
                        <label for="avatarUpload" class="btn bg-white rounded-pill btn-sm px-4 fw-bold shadow-sm" style="color: var(--g1); border: 1px solid var(--line); cursor: pointer;">
                            <i class="bi bi-camera me-1"></i> Change Avatar
                        </label>
                        <input id="avatarUpload" type="file" name="avatarFile" class="d-none" accept="image/*" onchange="previewImage(event)" />
                    </div>
                </div>

                <div class="text-center mb-5">
                    <h3 class="section-title mb-1">@Model.FullName</h3>
                    <p class="small fw-bold text-uppercase" style="color: var(--g2); letter-spacing: 0.05em;">
                        <i class="bi bi-shield-check me-1"></i> @(Model.Role?.RoleName ?? "Customer") Account
                    </p>
                </div>

                <h5 class="section-title fs-4 mb-4 border-bottom pb-3" style="border-color: var(--line) !important;">Personal Information</h5>
                
                <div class="row g-4 mb-5">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-uppercase small" style="color: var(--muted); letter-spacing: 0.05em;">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control form-control-custom fw-bold" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-uppercase small" style="color: var(--muted); letter-spacing: 0.05em;">Email Address</label>
                        <input asp-for="Email" class="form-control form-control-custom" style="background-color: var(--line); color: var(--soft); cursor: not-allowed;" readonly />
                        <small class="mt-2 d-block" style="color: var(--muted); font-size: 0.75rem;"><i class="bi bi-info-circle me-1"></i> Email cannot be changed.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-uppercase small" style="color: var(--muted); letter-spacing: 0.05em;">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control form-control-custom fw-bold" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-uppercase small" style="color: var(--muted); letter-spacing: 0.05em;">Address</label>
                        <input asp-for="Address" class="form-control form-control-custom fw-bold" placeholder="e.g., Can Tho City, VN" />
                    </div>
                </div>

                <h5 class="section-title fs-4 mb-4 border-bottom pb-3" style="border-color: var(--line) !important;">Security</h5>
                
                <div class="row g-4 mb-5">
                    <div class="col-md-12">
                        <label class="form-label fw-bold text-uppercase small" style="color: var(--muted); letter-spacing: 0.05em;">New Password</label>
                        <input type="password" name="newPassword" class="form-control form-control-custom" placeholder="Leave blank if you don't want to change" />
                    </div>
                </div>

                <div class="d-grid gap-3 d-md-flex justify-content-md-end mt-4 pt-4 border-top" style="border-color: var(--line) !important;">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-light rounded-pill px-5 fw-bold py-2 bg-white shadow-sm" style="color: var(--soft); border: 1px solid var(--line);">Cancel</a>
                    <button type="submit" class="btn btn-gradient rounded-pill px-5 fw-bold py-2"><i class="bi bi-save me-2"></i> Save Changes</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function(){
                var output = document.getElementById('avatarPreview');
                output.src = reader.result;
            };
            if(event.target.files[0]) reader.readAsDataURL(event.target.files[0]);
        }
    </script>
}