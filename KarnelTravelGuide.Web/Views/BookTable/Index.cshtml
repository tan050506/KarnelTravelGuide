@using KarnelTravelGuide.Web.Models.Entities
@model IEnumerable<Restaurant>
@{ 
    ViewData["Title"] = "Find Restaurants"; 
    var spotsList = ViewBag.Spots as IEnumerable<TouristSpot> ?? new List<TouristSpot>();
}

<style>
    body { background-color: #f8fafc; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; }
    
    .search-widget { background: #fff; border-radius: 1.25rem; padding: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.05); }
    .form-control-custom { border-radius: 0.75rem; padding: 0.8rem 1rem; border: 1px solid transparent; background-color: #f1f5f9; font-weight: 500; transition: all 0.2s; color: #333; }
    .form-control-custom:focus { border-color: #0d6efd; background-color: #fff; box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1); outline: none; }
    
    .btn-custom { background-color: #0d6efd; color: white; border-radius: 0.75rem; font-weight: 700; transition: all 0.2s; box-shadow: 0 4px 12px rgba(13,110,253,0.2); }
    .btn-custom:hover { background-color: #0b5ed7; transform: translateY(-1px); box-shadow: 0 6px 15px rgba(13,110,253,0.3); }

    .res-card { background: #fff; border-radius: 1.25rem; padding: 1.5rem; transition: all 0.2s ease; border: 1px solid rgba(0,0,0,0.05); }
    .res-card:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(0,0,0,0.08); border-color: rgba(13,110,253,0.15); }
    
    .custom-dropdown-menu { max-height: 250px; overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1000; width: 100%; background: #fff; border-radius: 0.75rem; display: none; margin-top: 5px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); border: 1px solid #eee; }
    .custom-dropdown-menu.show { display: block; }
    .dropdown-item-custom { transition: background-color 0.2s; cursor: pointer; white-space: normal; padding: 12px 15px; }
    .dropdown-item-custom:hover { background-color: #f8f9fa; }
</style>

<div class="container py-5" style="max-width: 1000px;">
    
    <div class="text-center mb-5">
        <h2 class="fw-bold text-dark mb-2">Reserve your table</h2>
        <p class="text-muted">Find the best dining experiences for your trip.</p>
    </div>

    @if (TempData["SuccessMessage"] != null) { 
        <div class="alert alert-success rounded-3 fw-bold mb-4"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]</div> 
    }

    <div class="search-widget mb-5">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-5 position-relative">
                <label class="form-label text-muted small fw-bold text-uppercase">Destination</label>
                <input type="text" id="spotSearchInput" class="form-control form-control-custom" placeholder="Where to dine?" autocomplete="off">
                <input type="hidden" name="spotId" id="hiddenSpotId" value="@ViewBag.CurrentSpot" />
                <div id="spotDropdown" class="custom-dropdown-menu p-0 border"></div>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold text-uppercase">Date</label>
                <input type="date" name="resDate" value="@ViewBag.ResDate" class="form-control form-control-custom" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="col-md-2">
                <label class="form-label text-muted small fw-bold text-uppercase">Time</label>
                <input type="time" name="resTime" value="@ViewBag.ResTime" class="form-control form-control-custom" required />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-custom w-100 py-3"><i class="bi bi-search me-2"></i> Search</button>
            </div>
        </form>
    </div>

    <h5 class="fw-bold text-dark mb-4"><i class="bi bi-shop-window text-primary me-2"></i>Available Restaurants</h5>

    @if (Model != null && Model.Any()) {
        <div class="row g-4">
            @foreach (var item in Model) {
                var minPrice = item.RestaurantTables != null && item.RestaurantTables.Any() ? item.RestaurantTables.Min(t => t.PriceRes ?? 0) : 0;
                
                <div class="col-md-6">
                    <div class="res-card shadow-sm h-100 d-flex flex-column">
                        <div class="d-flex mb-3">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/img/no-image.jpg" : item.ImageUrl)" style="width: 100px; height: 80px; object-fit: cover; border-radius: 8px;" class="me-3 shadow-sm border" />
                            <div>
                                <h5 class="fw-bold text-dark mb-1">@item.RestaurantName</h5>
                                <div class="mb-1">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">Restaurant</span>
                                </div>
                                <div class="small text-muted fw-bold mt-1 text-truncate" style="max-width: 200px;" title="@(item.Spot?.SpotName)"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@(item.Spot?.SpotName)</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                            <div>
                                <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.7rem;">Starts from</small>
                                <h4 class="text-success fw-bold mb-0">$@minPrice.ToString("0.##")</h4>
                            </div>
                            <div class="text-end">
                                <a asp-action="Booking" asp-route-id="@item.RestaurantId" asp-route-resDate="@ViewBag.ResDate" asp-route-resTime="@ViewBag.ResTime" class="btn btn-custom px-4 py-2">Select Tables</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    } else {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light">
            <i class="bi bi-egg-fried text-muted mb-3" style="font-size: 4rem;"></i>
            <h4 class="fw-bold text-dark">No restaurants found</h4>
            <p class="text-muted">Try modifying your search criteria.</p>
        </div>
    }

    <div class="mt-5 d-flex justify-content-between px-4 py-4 bg-white rounded-3 shadow-sm border">
        <a href="/BookRoom/Index?spotId=@ViewBag.CurrentSpot" class="btn btn-outline-secondary fw-bold px-4 py-2 rounded-pill">
            <i class="bi bi-arrow-left me-2"></i> Back to Room Booking
        </a>
        <a href="/Invoice/MyInvoices?tab=pending" class="btn btn-primary fw-bold px-5 py-2 rounded-pill shadow-sm">
            Skip & Go to Invoice <i class="bi bi-arrow-right ms-2"></i>
        </a>
    </div>
</div>

@section Scripts {
    <script>
        const spotsData = [ @foreach(var s in spotsList) { <text>{ id: @s.SpotId, name: "@Html.Raw(s.SpotName)" },</text> } ];
        const spotInput = document.getElementById('spotSearchInput'); const spotDropdown = document.getElementById('spotDropdown'); const hiddenSpotId = document.getElementById('hiddenSpotId');

        window.onload = function() {
            if (hiddenSpotId.value) { const t = spotsData.find(x => x.id == hiddenSpotId.value); if (t) spotInput.value = t.name; }
        };

        function renderDrop(filterText) {
            spotDropdown.innerHTML = '';
            const lowerFilter = filterText.toLowerCase();
            const filtered = spotsData.filter(item => item.name.toLowerCase().includes(lowerFilter));

            const anyItem = document.createElement('div');
            anyItem.className = 'dropdown-item-custom border-bottom text-primary fw-bold';
            anyItem.innerText = "-- All Destinations (Anywhere) --";
            anyItem.onclick = function() { hiddenSpotId.value = ""; spotInput.value = ""; spotDropdown.classList.remove('show'); };
            spotDropdown.appendChild(anyItem);

            if (filtered.length === 0) {
                spotDropdown.innerHTML += '<div class="p-3 text-muted small fst-italic">No matches found.</div>';
            } else {
                filtered.forEach(item => {
                    const div = document.createElement('div');
                    div.className = 'dropdown-item-custom border-bottom fw-bold text-dark';
                    div.innerText = item.name;
                    div.onclick = function() { hiddenSpotId.value = item.id; spotInput.value = item.name; spotDropdown.classList.remove('show'); };
                    spotDropdown.appendChild(div);
                });
            }
            spotDropdown.classList.add('show');
        }

        spotInput.addEventListener('input', function() { hiddenSpotId.value = ''; renderDrop(this.value); });
        spotInput.addEventListener('focus', function() { renderDrop(this.value); });
        document.addEventListener('click', function(e) { if (!spotInput.contains(e.target) && !spotDropdown.contains(e.target)) spotDropdown.classList.remove('show'); });
    </script>
}