@model KarnelTravelGuide.Web.Models.Entities.Stay
@{
    ViewData["Title"] = "Select Room";
    var availableRooms = ViewBag.AvailableRooms as Dictionary<int, int>;
}

<style>
    body { background-color: #f8fafc; }
    .card-custom { background: #fff; border-radius: 1.25rem; padding: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: none; }
    
    .room-card { border: 2px solid #e2e8f0; border-radius: 1rem; padding: 1.5rem; transition: all 0.2s; cursor: pointer; position: relative; overflow: hidden; }
    .room-card:hover { border-color: #cbd5e1; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
    .room-card.selected { border-color: #0d6efd; background-color: #f8faff; box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1); }
    .room-card.selected::before { content: '\F26A'; font-family: 'bootstrap-icons'; position: absolute; top: 20px; right: 20px; color: #0d6efd; font-size: 1.8rem; line-height: 1; z-index: 2;}
    
    .qty-input { width: 70px; text-align: center; font-weight: bold; border: 1px solid #ced4da; border-radius: 0.5rem; }
    .qty-btn { background: #e9ecef; border: none; border-radius: 0.5rem; width: 35px; height: 35px; font-weight: bold; transition: 0.2s; }
    .qty-btn:hover:not(:disabled) { background: #dee2e6; }
    
    .bottom-checkout-bar { position: sticky; bottom: 20px; background: #fff; padding: 1.5rem; box-shadow: 0 10px 30px rgba(0,0,0,0.15); z-index: 1000; border-radius: 1.25rem; margin-top: 30px; border: 1px solid rgba(0,0,0,0.05); }
    .btn-custom { background-color: #0d6efd; color: white; border-radius: 0.75rem; font-weight: 700; transition: 0.3s; }
    .btn-custom:hover:not(:disabled) { background-color: #0b5ed7; box-shadow: 0 8px 20px rgba(13, 110, 253, 0.3); transform: translateY(-2px); }
</style>

<div class="container py-5" style="max-width: 900px;">
    
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h3 class="fw-bold mb-0 text-dark">@Model.Name</h3>
            <span class="text-muted small"><i class="bi bi-geo-alt-fill text-danger"></i> @Model.Address</span>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null) { 
        <div class="alert alert-danger rounded-4 fw-bold shadow-sm mb-4"><i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]</div> 
    }

    <form asp-action="Booking" method="post" id="checkoutForm">
        <input type="hidden" name="stayId" value="@Model.StayId" />
        <input type="hidden" name="checkIn" value="@ViewBag.CheckIn" />
        <input type="hidden" name="checkOut" value="@ViewBag.CheckOut" />
        <input type="hidden" name="roomId" id="selectedRoomId" required />
        <input type="hidden" name="numberOfRooms" id="selectedQty" required />

        <div class="card-custom mb-0">
            
            <div class="mb-4">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/img/no-image.jpg" : Model.ImageUrl)" 
                     class="img-fluid rounded-4 shadow-sm border w-100" 
                     style="height: 350px; object-fit: cover;" 
                     alt="@Model.Name" />
            </div>

             <div class="row text-center bg-light p-3 rounded-4 mb-4 g-3 border">
                <div class="col-4 border-end">
                    <small class="text-muted fw-bold d-block text-uppercase">Check-in</small>
                    <strong class="fs-5 text-dark">@ViewBag.CheckIn</strong>
                </div>
                 <div class="col-4 border-end">
                    <small class="text-muted fw-bold d-block text-uppercase">Check-out</small>
                    <strong class="fs-5 text-dark">@ViewBag.CheckOut</strong>
                </div>
                <div class="col-4">
                    <small class="text-muted fw-bold d-block text-uppercase">Total Nights</small>
                    <strong class="fs-5 text-primary">@ViewBag.TotalNights Nights</strong>
                </div>
            </div>

            <h5 class="fw-bold mb-3 mt-4"><i class="bi bi-door-open text-primary me-2"></i>Select Room Type</h5>

            <div class="row g-3">
                @foreach(var room in Model.Rooms)
                {
                    int avail = availableRooms != null && availableRooms.ContainsKey(room.RoomId) ? availableRooms[room.RoomId] : 0;
                    bool isSoldOut = avail <= 0;

                    <div class="col-12">
                        <div class="room-card @(isSoldOut ? "opacity-50" : "")" onclick="@(!isSoldOut ? $"selectRoom({room.RoomId}, {room.PriceRoom ?? 0}, {avail}, '{room.RoomType}')" : "")" id="room-card-@room.RoomId">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    
                                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                                        <i class="bi bi-door-open-fill fs-4 text-primary"></i>
                                    </div>
                                    
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1">@room.RoomType</h5>
                                        @if(isSoldOut) {
                                            <span class="badge bg-danger">Sold Out</span>
                                        } else {
                                            <span class="text-success small fw-bold"><i class="bi bi-check-circle-fill me-1"></i> @avail rooms available</span>
                                        }
                                    </div>
                                </div>
                                <div class="text-end pe-5">
                                    <h4 class="fw-bold text-primary mb-0">$@((room.PriceRoom ?? 0).ToString("N0"))</h4>
                                    <small class="text-muted">/ room / night</small>
                                </div>
                            </div>

                            <div class="mt-3 pt-3 border-top d-none align-items-center justify-content-between" id="qty-box-@room.RoomId">
                                <span class="fw-bold text-dark">Number of Rooms:</span>
                                <div class="d-flex align-items-center gap-2" onclick="event.stopPropagation()">
                                    <button type="button" class="qty-btn" onclick="updateQty(-1)">-</button>
                                    <input type="number" class="qty-input py-1" id="displayQty-@room.RoomId" value="1" min="1" max="@avail" readonly />
                                    <button type="button" class="qty-btn" onclick="updateQty(1)">+</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="bottom-checkout-bar">
            <div class="row align-items-center m-0">
                <div class="col-md-5 text-start ps-0 pe-4">
                    <span class="text-muted fw-bold d-block mb-1">Selected Room:</span>
                    <div class="fw-bold text-dark fs-5 lh-base" id="roomLabel">None</div>
                </div>
                <div class="col-md-4 text-center border-start border-end">
                    <span class="text-muted fw-bold d-block mb-1">Total Amount:</span>
                    <span class="fs-3 fw-bold text-primary lh-1" id="priceLabel">$0</span>
                </div>
                <div class="col-md-3 text-end pe-0 ps-4">
                    <button type="submit" class="btn btn-custom py-3 w-100" id="submitBtn" disabled>Confirm Booking</button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const totalNights = @ViewBag.TotalNights;
        let currentRoomId = null;
        let currentPrice = 0;
        let maxAvail = 0;
        let currentQty = 1;

        function selectRoom(roomId, price, avail, typeName) {
            document.querySelectorAll('.room-card').forEach(c => c.classList.remove('selected'));
            document.querySelectorAll('[id^="qty-box-"]').forEach(b => b.classList.add('d-none'));
            document.querySelectorAll('.qty-input').forEach(i => i.value = 1);

            document.getElementById('room-card-' + roomId).classList.add('selected');
            document.getElementById('qty-box-' + roomId).classList.remove('d-none');
            document.getElementById('qty-box-' + roomId).classList.add('d-flex');

            currentRoomId = roomId;
            currentPrice = price;
            maxAvail = avail;
            currentQty = 1;

            document.getElementById("selectedRoomId").value = roomId;
            document.getElementById("selectedQty").value = currentQty;
            
            document.getElementById("roomLabel").innerText = typeName + " (x" + currentQty + ")";
            document.getElementById("submitBtn").disabled = false;
            calcTotal();
        }

        function updateQty(change) {
            if(!currentRoomId) return;
            
            let newQty = currentQty + change;
            if(newQty >= 1 && newQty <= maxAvail) {
                currentQty = newQty;
                document.getElementById('displayQty-' + currentRoomId).value = currentQty;
                document.getElementById("selectedQty").value = currentQty;
                
                let typeName = document.querySelector('#room-card-' + currentRoomId + ' h5').innerText;
                document.getElementById("roomLabel").innerText = typeName + " (x" + currentQty + ")";
                calcTotal();
            }
        }

        function calcTotal() {
            let total = currentPrice * currentQty * totalNights;
            document.getElementById("priceLabel").innerText = "$" + total.toLocaleString('en-US');
        }

        document.getElementById("checkoutForm").addEventListener("submit", function() {
            const btn = document.getElementById("submitBtn");
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Processing...';
            btn.classList.add('disabled');
        });
    </script>
}