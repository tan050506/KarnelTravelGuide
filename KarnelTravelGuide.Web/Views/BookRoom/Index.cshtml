@using KarnelTravelGuide.Web.Models.Entities
@model IEnumerable<Stay>
@{ 
    ViewData["Title"] = "Find Stays"; 
    ViewData["HeroPage"] = true; // Kích hoạt Navbar trong suốt
    var spotsList = ViewBag.Spots as IEnumerable<TouristSpot> ?? new List<TouristSpot>();
}

<style>
    body { background-color: var(--bg); }
    
    .stay-hero {
        background: linear-gradient(rgba(24, 35, 46, 0.5), rgba(24, 35, 46, 0.8)), 
                    url('https://images.unsplash.com/photo-1542314831-c6a4d2748610?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
        background-size: cover;
        padding: 160px 0 120px;
        border-radius: 0 0 2rem 2rem;
        margin-bottom: 20px;
    }

    .hero-title {
        font-family: var(--ff-d);
        font-size: clamp(2.5rem, 5vw, 4rem);
        color: var(--white);
        line-height: 1.1;
    }

    .search-widget { 
        background: var(--white); 
        border-radius: 1.5rem; 
        padding: 2.5rem; 
        box-shadow: 0 15px 40px rgba(0,0,0,0.08); 
        border: 1px solid var(--line); 
        margin-top: -80px; 
        position: relative;
        z-index: 10;
    }
    
    .form-control-custom { 
        border-radius: 0.75rem; 
        padding: 0.8rem 1.2rem; 
        border: 1px solid var(--line); 
        background-color: var(--bg); 
        font-family: var(--ff-b);
        color: var(--ink); 
        transition: all 0.2s; 
    }
    .form-control-custom:focus { 
        border-color: var(--g1); 
        background-color: var(--white); 
        box-shadow: 0 0 0 4px rgba(58, 125, 94, 0.1); 
        outline: none; 
    }
    
    .btn-gradient {
        background: linear-gradient(135deg, var(--g1), var(--g2));
        color: var(--white);
        border: none;
        border-radius: 0.75rem; 
        font-weight: 700;
        transition: opacity 0.2s, transform 0.2s;
        box-shadow: 0 4px 14px rgba(42,157,143,.3);
    }
    .btn-gradient:hover {
        opacity: 0.9;
        transform: translateY(-2px);
        color: var(--white);
    }

    .stay-card { 
        background: var(--white); 
        border-radius: 1.25rem; 
        padding: 1.5rem;
        transition: all 0.3s ease; 
        border: 1px solid var(--line); 
    }
    .stay-card:hover { 
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.06); 
        border-color: rgba(42,157,143,0.2); 
    }
    
    .stay-name {
        font-family: var(--ff-d);
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--ink);
    }

    .custom-dropdown-menu { 
        max-height: 250px;
        overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1000; width: 100%; 
        background: var(--white); border-radius: 0.75rem; display: none; margin-top: 5px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1); border: 1px solid var(--line); 
    }
    .custom-dropdown-menu.show { display: block; }
    .dropdown-item-custom { transition: background-color 0.2s; cursor: pointer; white-space: normal; padding: 12px 15px; color: var(--soft); }
    .dropdown-item-custom:hover { background: var(--g-lt); color: var(--g1); }
</style>

<div class="stay-hero text-center position-relative">
    <div class="container">
        <h1 class="hero-title mb-3">Find Your Perfect Stay</h1>
        <p class="lead mb-0" style="color: rgba(255,255,255,0.85); font-weight: 300;">Discover amazing hotels and eco-resorts for your next trip.</p>
    </div>
</div>

<div class="container pb-5" style="max-width: 1100px;">
    
    @if (TempData["SuccessMessage"] != null) { 
        <div class="alert alert-success rounded-3 fw-bold mb-4 shadow-sm border-0" style="background-color: var(--t-lt); color: var(--g1);">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div> 
    }

    <div class="search-widget mb-5">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-4 position-relative">
                <label class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em;">Destination</label>
                <input type="text" id="spotSearchInput" class="form-control form-control-custom" placeholder="Where to?" autocomplete="off">
                <input type="hidden" name="spotId" id="hiddenSpotId" value="@ViewBag.CurrentSpot" />
                <div id="spotDropdown" class="custom-dropdown-menu p-0 border"></div>
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em;">Check-in</label>
                <input type="date" name="checkIn" value="@ViewBag.CheckIn" class="form-control form-control-custom" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em;">Check-out</label>
                <input type="date" name="checkOut" value="@ViewBag.CheckOut" class="form-control form-control-custom" min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-gradient w-100 py-3"><i class="bi bi-search me-2"></i> Search</button>
            </div>
        </form>
    </div>

    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold text-dark m-0" style="font-family: var(--ff-d);"><i class="bi bi-building me-2" style="color: var(--g1);"></i>Available Stays</h3>
    </div>

    @if (Model != null && Model.Any()) {
        <div class="row g-4">
            @foreach (var item in Model) {
                var minPrice = item.Rooms != null && item.Rooms.Any() ? item.Rooms.Min(r => r.PriceRoom ?? 0) : 0;
                
                <div class="col-md-6">
                    <div class="stay-card shadow-sm h-100 d-flex flex-column">
                        <div class="d-flex mb-3">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/img/no-image.jpg" : item.ImageUrl)" style="width: 110px; height: 90px; object-fit: cover; border-radius: 12px;" class="me-3 shadow-sm" />
                            <div class="overflow-hidden">
                                <h5 class="stay-name mb-1 text-truncate" title="@item.Name">@item.Name</h5>
                                <div class="mb-1">
                                    <span class="badge" style="background-color: var(--t-lt); color: var(--g1); border: 1px solid var(--g-lt);">@item.StayType</span>
                                </div>
                                <div class="small fw-bold mt-1 text-truncate" style="color: var(--soft);" title="@(item.Spot?.SpotName)">
                                    <i class="bi bi-geo-alt-fill me-1" style="color: var(--g2);"></i>@(item.Spot?.SpotName)
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                            <div>
                                <small class="d-block fw-bold text-uppercase" style="color: var(--muted); font-size: 0.7rem; letter-spacing: 0.05em;">Starts from</small>
                                <h4 class="fw-bold mb-0" style="color: var(--g1);">$@minPrice.ToString("0.##")</h4>
                            </div>
                            <div class="text-end">
                                <a asp-action="Booking" asp-route-id="@item.StayId" asp-route-checkIn="@ViewBag.CheckIn" asp-route-checkOut="@ViewBag.CheckOut" class="btn btn-gradient px-4 py-2 rounded-pill">Select Rooms</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    } else {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light">
            <i class="bi bi-building-x mb-3" style="font-size: 4rem; color: var(--line);"></i>
            <h4 class="fw-bold text-dark" style="font-family: var(--ff-d);">No stays found</h4>
            <p style="color: var(--soft);">Try modifying your search criteria to find available accommodations.</p>
        </div>
    }

    <div class="mt-5 d-flex justify-content-between px-4 py-4 bg-white rounded-4 shadow-sm border border-light">
        <a href="/BookTicket/Index?toSpotId=@ViewBag.CurrentSpot" class="btn btn-outline-secondary fw-bold px-4 py-2 rounded-pill d-flex align-items-center">
            <i class="bi bi-arrow-left me-2"></i> Back to Tickets
        </a>
        <a href="/BookTable/Index?spotId=@ViewBag.CurrentSpot" class="btn fw-bold px-4 py-2 rounded-pill" style="color: var(--g1); background-color: var(--g-lt);">
            Skip to Dining <i class="bi bi-arrow-right ms-2"></i>
        </a>
    </div>
</div>

@section Scripts {
    <script>
        const spotsData = [ @foreach(var s in spotsList) { <text>{ id: @s.SpotId, name: "@Html.Raw(s.SpotName)" },</text> } ];
        const spotInput = document.getElementById('spotSearchInput'); const spotDropdown = document.getElementById('spotDropdown');
        const hiddenSpotId = document.getElementById('hiddenSpotId');

        window.onload = function() {
            if (hiddenSpotId.value) { const t = spotsData.find(x => x.id == hiddenSpotId.value);
            if (t) spotInput.value = t.name; }
        };
        function renderDrop(filterText) {
            spotDropdown.innerHTML = '';
            const lowerFilter = filterText.toLowerCase();
            const filtered = spotsData.filter(item => item.name.toLowerCase().includes(lowerFilter));

            const anyItem = document.createElement('div');
            anyItem.className = 'dropdown-item-custom border-bottom fw-bold';
            anyItem.style.color = 'var(--g1)';
            anyItem.innerText = "-- All Destinations (Anywhere) --";
            anyItem.onclick = function() { hiddenSpotId.value = ""; spotInput.value = ""; spotDropdown.classList.remove('show'); };
            spotDropdown.appendChild(anyItem);

            if (filtered.length === 0) {
                spotDropdown.innerHTML += '<div class="p-3 small fst-italic" style="color: var(--muted);">No matches found.</div>';
            } else {
                filtered.forEach(item => {
                    const div = document.createElement('div');
                    div.className = 'dropdown-item-custom border-bottom fw-bold text-dark';
                    div.innerText = item.name;
                    div.onclick = function() { hiddenSpotId.value = item.id; spotInput.value = item.name; spotDropdown.classList.remove('show'); };
                    spotDropdown.appendChild(div);
                });
            }
            spotDropdown.classList.add('show');
        }

        spotInput.addEventListener('input', function() { hiddenSpotId.value = ''; renderDrop(this.value); });
        spotInput.addEventListener('focus', function() { renderDrop(this.value); });
        document.addEventListener('click', function(e) { if (!spotInput.contains(e.target) && !spotDropdown.contains(e.target)) spotDropdown.classList.remove('show'); });
    </script>
}