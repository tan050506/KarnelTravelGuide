@using Microsoft.AspNetCore.Http
@{
    var userName = Context.Session.GetString("UserName");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KarnelTravel</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        .k-navbar { background-color: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px); border-bottom: 1px solid var(--k-border); }
        .k-brand { color: var(--k-primary); font-weight: 800; font-size: 1.5rem; letter-spacing: -0.5px; }
        .k-brand span { color: #f59e0b; }
        
        .k-nav-link { color: var(--k-text-muted); font-weight: 600; padding: 8px 16px !important; border-radius: 8px; transition: 0.2s; margin: 0 4px; }
        .k-nav-link:hover, .k-nav-link.active { color: var(--k-primary); background-color: #eff6ff; }
        
        .k-footer { background-color: var(--k-sidebar-bg); color: #94a3b8; }
        .k-footer h5 { color: #ffffff; font-weight: 700; margin-bottom: 1.5rem; }
        .k-footer a { color: #94a3b8; transition: 0.2s; }
        .k-footer a:hover { color: var(--k-primary); }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg k-navbar sticky-top py-3">
            <div class="container-fluid px-lg-5"> 
                <a class="navbar-brand k-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-geo-alt-fill text-warning me-1"></i>Karnel<span>Travel</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <i class="bi bi-list fs-1 text-dark"></i>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link k-nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link k-nav-link" asp-controller="Destination" asp-action="Index">Destinations</a></li>
                        <li class="nav-item"><a class="nav-link k-nav-link" asp-controller="BookRoom" asp-action="Index">Book Room</a></li>
                        <li class="nav-item"><a class="nav-link k-nav-link" asp-controller="BookTable" asp-action="Index">Book Table</a></li>
                        <li class="nav-item"><a class="nav-link k-nav-link" asp-controller="BookTicket" asp-action="Index">Book Ticket</a></li>
                        <li class="nav-item"><a class="nav-link k-nav-link" asp-controller="Home" asp-action="About">About Us</a></li>
                        <li class="nav-item"><a class="nav-link k-nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>
                    
                    <ul class="navbar-nav align-items-center gap-3 mt-3 mt-lg-0">
                        @if (!string.IsNullOrEmpty(userName))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-bold text-dark d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        @userName.Substring(0, 1).ToUpper()
                                    </div>
                                    @userName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-3 p-2">
                                    <li><a class="dropdown-item py-2 fw-bold rounded-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2 text-primary"></i> My Profile</a></li>
                                    <li><a class="dropdown-item py-2 fw-bold rounded-2" asp-controller="Invoice" asp-action="MyInvoices"><i class="bi bi-receipt me-2 text-primary"></i> My Bookings</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 fw-bold text-danger rounded-2" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link fw-bold text-dark" asp-controller="Account" asp-action="Register">Sign Up</a></li>
                            <li class="nav-item"><a class="k-btn-primary" asp-controller="Account" asp-action="Login">Log In</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="k-footer pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 pe-lg-5">
                    <h4 class="k-brand text-white mb-3"><i class="bi bi-geo-alt-fill text-warning me-1"></i>Karnel<span class="text-warning">Travel</span></h4>
                    <p class="small lh-lg">Experience the world with Karnel Travel. We provide the best booking services for stays, transportation, and unforgettable dining experiences.</p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h5>Explore</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a asp-controller="Destination" asp-action="Index">Top Destinations</a></li>
                        <li><a asp-controller="BookRoom" asp-action="Index">Luxury Stays</a></li>
                        <li><a asp-controller="BookTable" asp-action="Index">Local Cuisine</a></li>
                        <li><a asp-controller="BookTicket" asp-action="Index">Book Tickets</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5>Support</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a href="#">Cancellation Policy</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5>Contact</h5>
                    <ul class="list-unstyled d-flex flex-column gap-3 small">
                        <li class="d-flex align-items-center gap-3"><i class="bi bi-geo-alt fs-5 text-primary"></i> Can Tho University, VN</li>
                        <li class="d-flex align-items-center gap-3"><i class="bi bi-telephone fs-5 text-primary"></i> +84 1900 xxxx</li>
                    </ul>
                </div>
            </div>
            <div class="text-center small mt-5 pt-4 border-top border-secondary opacity-75">
                &copy; 2026 Karnel Travel Guide. Designed for exceptional journeys.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.css"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>