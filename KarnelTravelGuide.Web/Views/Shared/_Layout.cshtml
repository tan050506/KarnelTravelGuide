@using Microsoft.AspNetCore.Http
@{
    var userName = Context.Session.GetString("UserName");
    var isHero   = ViewData["HeroPage"] as bool? == true;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* ─── TOKENS ─── */
        :root {
            --g1: #3a7d5e;
            --g2: #2a9d8f;
            --g-lt: #edf5f0;
            --t-lt: #e4f5f4;
            --ink: #18232e;
            --soft: #52667a;
            --muted: #8fa4b4;
            --line: #e4ecf0;
            --bg: #f7f9f8;
            --white: #ffffff;
            --ff-d: 'Cormorant Garamond', Georgia, serif;
            --ff-b: 'Jost', system-ui, sans-serif;
        }
        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            font-family: var(--ff-b);
            background: var(--white);
            color: var(--ink);
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
            margin: 0; padding: 0;
        }
        a { text-decoration: none; color: inherit; }
        img { display: block; max-width: 100%; }

        /* ─── NAVBAR ─── */
        #site-nav {
            position: absolute;
            top: 0; left: 0; right: 0;
            z-index: 999;
            height: 70px;
            transition: background .35s, box-shadow .35s;
        }
        #site-nav.pinned {
            position: fixed;
            background: rgba(255,255,255,.97);
            box-shadow: 0 1px 24px rgba(0,0,0,.07);
            backdrop-filter: blur(12px);
        }
        #site-nav.no-hero {
            position: sticky;
            top: 0;
            background: rgba(255,255,255,.97);
            box-shadow: 0 1px 24px rgba(0,0,0,.07);
            backdrop-filter: blur(12px);
        }

        .nav-inner {
            height: 70px;
            display: flex;
            align-items: center;
            padding: 0 2.5rem;
            gap: 2rem;
        }

        /* brand */
        .nav-brand {
            display: flex;
            align-items: center;
            gap: .55rem;
            font-family: var(--ff-d);
            font-size: 1.5rem;
            font-weight: 600;
            color: white;
            white-space: nowrap;
            flex-shrink: 0;
            letter-spacing: .01em;
            line-height: 1;
        }
        #site-nav.pinned .nav-brand,
        #site-nav.no-hero .nav-brand { color: var(--g1); }

        .brand-mark {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, var(--g1), var(--g2));
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: .85rem;
            flex-shrink: 0;
        }
        .brand-accent { color: var(--g2); margin-left: 1px; }

        /* center links */
        .nav-links {
            display: flex;
            align-items: center;
            gap: .1rem;
            list-style: none;
            margin: 0 auto;
            padding: 0;
        }
        .nav-links a {
            display: block;
            padding: .4rem .85rem;
            border-radius: 7px;
            font-size: .875rem;
            font-weight: 500;
            color: rgba(255,255,255,.82);
            transition: background .17s, color .17s;
            white-space: nowrap;
        }
        .nav-links a:hover { color: #fff; background: rgba(255,255,255,.13); }
        #site-nav.pinned .nav-links a,
        #site-nav.no-hero .nav-links a { color: var(--soft); }
        #site-nav.pinned .nav-links a:hover,
        #site-nav.no-hero .nav-links a:hover { color: var(--g1); background: var(--g-lt); }

        /* right auth — ALWAYS single row */
        .nav-auth {
            display: flex;
            align-items: center;
            gap: .6rem;
            flex-shrink: 0;
        }
        .nav-btn-ghost {
            padding: .42rem 1.1rem;
            border-radius: 50px;
            border: 1.5px solid rgba(255,255,255,.38);
            font-size: .85rem;
            font-weight: 600;
            color: rgba(255,255,255,.88);
            transition: background .17s, border-color .17s;
            white-space: nowrap;
        }
        .nav-btn-ghost:hover { background: rgba(255,255,255,.14); border-color: rgba(255,255,255,.65); color: #fff; }
        #site-nav.pinned .nav-btn-ghost,
        #site-nav.no-hero .nav-btn-ghost { color: var(--soft); border-color: var(--line); }
        #site-nav.pinned .nav-btn-ghost:hover,
        #site-nav.no-hero .nav-btn-ghost:hover { color: var(--g1); background: var(--g-lt); border-color: var(--g1); }

        .nav-btn-fill {
            padding: .46rem 1.25rem;
            border-radius: 50px;
            background: linear-gradient(135deg, var(--g1), var(--g2));
            font-size: .85rem;
            font-weight: 700;
            color: #fff;
            white-space: nowrap;
            box-shadow: 0 4px 14px rgba(42,157,143,.3);
            transition: opacity .17s, transform .15s;
        }
        .nav-btn-fill:hover { opacity: .9; transform: translateY(-1px); color: #fff; }

        /* user dropdown */
        .nav-avatar {
            width: 32px; height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--g1), var(--g2));
            color: #fff;
            display: flex; align-items: center; justify-content: center;
            font-size: .78rem; font-weight: 700;
        }
        .nav-user-trigger {
            display: flex; align-items: center; gap: .5rem;
            font-size: .875rem; font-weight: 600;
            color: rgba(255,255,255,.88);
            cursor: pointer;
        }
        #site-nav.pinned .nav-user-trigger,
        #site-nav.no-hero .nav-user-trigger { color: var(--ink); }

        .dropdown-menu {
            border: 1px solid var(--line) !important;
            border-radius: 14px !important;
            box-shadow: 0 12px 40px rgba(0,0,0,.1) !important;
            padding: .5rem !important;
            min-width: 188px;
        }
        .dropdown-item {
            border-radius: 8px;
            padding: .55rem .9rem;
            font-size: .875rem;
            font-weight: 500;
            font-family: var(--ff-b);
            color: var(--soft);
        }
        .dropdown-item:hover { background: var(--g-lt); color: var(--g1); }

        /* mobile toggle */
        .nav-toggle {
            display: none;
            background: none;
            border: none;
            cursor: pointer;
            color: #fff;
            font-size: 1.65rem;
            padding: 0;
            margin-left: auto;
            flex-shrink: 0;
        }
        #site-nav.pinned .nav-toggle,
        #site-nav.no-hero .nav-toggle { color: var(--ink); }

        /* mobile drawer */
        .nav-drawer {
            display: none;
            flex-direction: column;
            gap: .25rem;
            background: #fff;
            border-top: 1px solid var(--line);
            padding: 1rem 1.5rem 1.5rem;
            box-shadow: 0 8px 24px rgba(0,0,0,.07);
        }
        .nav-drawer.open { display: flex; }
        .nav-drawer .nav-links { flex-direction: column; align-items: flex-start; width: 100%; }
        .nav-drawer .nav-links a { color: var(--soft); width: 100%; }
        .nav-drawer .nav-auth { flex-direction: column; width: 100%; padding-top: .75rem; border-top: 1px solid var(--line); }
        .nav-drawer .nav-btn-ghost,
        .nav-drawer .nav-btn-fill { width: 100%; text-align: center; display: block; color: var(--soft); border-color: var(--line); }
        .nav-drawer .nav-btn-fill { color: #fff; }

        @@media (max-width: 991px) {
            .nav-toggle { display: flex; align-items: center; }
            .nav-center-group { display: none !important; }
        }

        /* ─── FOOTER ─── */
        .site-footer {
            background: #111b16;
            color: #5e7a6a;
            font-family: var(--ff-b);
            padding: 5rem 0 0;
        }
        .ft-logo {
            font-family: var(--ff-d);
            font-size: 1.55rem;
            font-weight: 600;
            color: #fff;
            display: flex; align-items: center; gap: .5rem;
        }
        .ft-logo i { color: var(--g2); }
        .ft-blurb { font-size: .875rem; color: #4e6a5a; line-height: 1.85; margin-top: .8rem; max-width: 270px; }
        .ft-socials { display: flex; gap: .5rem; margin-top: 1.5rem; }
        .ft-socials a {
            width: 34px; height: 34px;
            border-radius: 8px;
            background: rgba(255,255,255,.05);
            display: flex; align-items: center; justify-content: center;
            color: #4e6a5a; font-size: .9rem;
            transition: background .18s, color .18s;
        }
        .ft-socials a:hover { background: var(--g1); color: #fff; }

        .ft-col-head {
            font-size: .7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .14em;
            color: #fff;
            margin-bottom: 1.4rem;
        }
        .ft-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: .7rem; }
        .ft-list a { font-size: .875rem; color: #4e6a5a; transition: color .17s; }
        .ft-list a:hover { color: #b0cfc0; }

        .ft-contact-row { display: flex; align-items: flex-start; gap: .7rem; margin-bottom: .85rem; font-size: .875rem; color: #4e6a5a; }
        .ft-contact-row i { color: var(--g2); font-size: .9rem; margin-top: .15rem; flex-shrink: 0; }

        .ft-bottom {
            border-top: 1px solid rgba(255,255,255,.05);
            margin-top: 3.5rem;
            padding: 1.4rem 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: .5rem;
        }
        .ft-copy { font-size: .78rem; color: #3a5040; }
        .ft-policy { display: flex; gap: 1.5rem; }
        .ft-policy a { font-size: .78rem; color: #3a5040; transition: color .17s; }
        .ft-policy a:hover { color: var(--g2); }

        /* ─── TOASTS ─── */
        .toast { border-radius: 10px !important; font-family: var(--ff-b); }
    </style>
</head>
<body>

@if (ViewData["HideHeaderFooter"] as bool? != true)
{
    <nav id="site-nav" class="@(isHero ? "" : "no-hero")">
        <!-- Desktop row -->
        <div class="nav-inner">
            <a class="nav-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-mark"><i class="bi bi-geo-alt-fill"></i></div>
                Karnel<span class="brand-accent">Travel</span>
            </a>

            <!-- center links (hidden mobile via CSS) -->
            <ul class="nav-links nav-center-group">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Destination" asp-action="Index">Destinations</a></li>
                <li><a asp-controller="BookRoom" asp-action="Index">Stay</a></li>
                <li><a asp-controller="BookTable" asp-action="Index">Dinning</a></li>
                <li><a asp-controller="BookTicket" asp-action="Index">Vehicle</a></li>
                <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                <li><a asp-controller="Feedback" asp-action="Reviews">Contact Us</a></li>
            </ul>

            <!-- auth — always same row -->
            <div class="nav-auth nav-center-group">
                @if (!string.IsNullOrEmpty(userName))
                {
                    <div class="dropdown">
                        <div class="nav-user-trigger" data-bs-toggle="dropdown">
                            <div class="nav-avatar">@userName.Substring(0,1).ToUpper()</div>
                            <span class="d-none d-xl-inline">@userName</span>
                            <i class="bi bi-chevron-down" style="font-size:.6rem;opacity:.55"></i>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end mt-2">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                            <li><a class="dropdown-item" asp-controller="Invoice" asp-action="MyInvoices"><i class="bi bi-receipt me-2"></i>My Bookings</a></li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="nav-btn-ghost" asp-controller="Account" asp-action="Login">Log In</a>
                    <a class="nav-btn-fill" asp-controller="Account" asp-action="Register">Sign Up</a>
                }
            </div>

            <!-- mobile toggle -->
            <button class="nav-toggle" id="navToggle" aria-label="Menu">
                <i class="bi bi-list" id="navToggleIcon"></i>
            </button>
        </div>

        <!-- Mobile drawer (below nav row) -->
        <div class="nav-drawer" id="navDrawer">
            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Destination" asp-action="Index">Destinations</a></li>
                <li><a asp-controller="BookRoom" asp-action="Index"> Room</a></li>
                <li><a asp-controller="BookTable" asp-action="Index">Dining</a></li>
                <li><a asp-controller="BookTicket" asp-action="Index">Vehicle</a></li>
                <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                <li><a asp-controller="Feedback" asp-action="Reviews">Contact Us</a></li>
            </ul>
            <div class="nav-auth">
                @if (!string.IsNullOrEmpty(userName))
                {
                    <a class="nav-btn-ghost" asp-controller="Account" asp-action="Profile">My Profile</a>
                    <a class="nav-btn-ghost" asp-controller="Account" asp-action="Logout">Logout</a>
                }
                else
                {
                    <a class="nav-btn-ghost" asp-controller="Account" asp-action="Login">Log In</a>
                    <a class="nav-btn-fill" asp-controller="Account" asp-action="Register">Sign Up Free</a>
                }
            </div>
        </div>
    </nav>
}

<main role="main">@RenderBody()</main>

@if (ViewData["HideHeaderFooter"] as bool? != true)
{
    <footer class="site-footer">
        <div class="container">
            <div class="row gy-5">
                <div class="col-lg-4 col-md-12">
                    <div class="ft-logo"><i class="bi bi-geo-alt-fill"></i> KarnelTravel</div>
                    <p class="ft-blurb">Discover breathtaking journeys across Vietnam. We handle the details — you just explore.</p>
                    <div class="ft-socials">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-twitter-x"></i></a>
                        <a href="#"><i class="bi bi-youtube"></i></a>
                        <a href="#"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <div class="ft-col-head">Explore</div>
                    <ul class="ft-list">
                        <li><a asp-controller="Destination" asp-action="Index">Destinations</a></li>
                        <li><a asp-controller="BookRoom" asp-action="Index">Luxury Stays</a></li>
                        <li><a asp-controller="BookTable" asp-action="Index">Dining</a></li>
                        <li><a asp-controller="BookTicket" asp-action="Index">Book Tickets</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <div class="ft-col-head">Company</div>
                    <ul class="ft-list">
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a href="#">Careers</a></li>
                        <li><a href="#">Blog</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-4">
                    <div class="ft-col-head">Contact</div>
                    <div class="ft-contact-row"><i class="bi bi-geo-alt-fill"></i><span>Can Tho University, Vietnam</span></div>
                    <div class="ft-contact-row"><i class="bi bi-telephone-fill"></i><span>+84 1900 xxxx</span></div>
                    <div class="ft-contact-row"><i class="bi bi-envelope-fill"></i><span>hello@karneltravel.vn</span></div>
                    <div class="ft-contact-row"><i class="bi bi-clock-fill"></i><span>Mon–Fri 8:00 AM – 6:00 PM</span></div>
                </div>
            </div>
            <div class="ft-bottom">
                <span class="ft-copy">© 2026 Karnel Travel Guide. All rights reserved.</span>
                <div class="ft-policy">
                    <a href="#">Terms</a>
                    <a href="#">Privacy</a>
                    <a href="#">Cookies</a>
                </div>
            </div>
        </div>
    </footer>
}

<!-- Toasts -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:1060;">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast align-items-center text-bg-success border-0 mb-2" role="alert" aria-atomic="true">
            <div class="d-flex"><div class="toast-body">@TempData["SuccessMessage"]</div><button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="toast align-items-center text-bg-danger border-0 mb-2" role="alert" aria-atomic="true">
            <div class="d-flex"><div class="toast-body">@TempData["ErrorMessage"]</div><button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>
        </div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        foreach (var ms in ViewData.ModelState.Values)
            foreach (var e in ms.Errors)
            {
                <div class="toast align-items-center text-bg-danger border-0 mb-2" role="alert" aria-atomic="true">
                    <div class="d-flex"><div class="toast-body">@e.ErrorMessage</div><button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>
                </div>
            }
    }
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    // toasts
    document.querySelectorAll('.toast').forEach(el =>
        new bootstrap.Toast(el, { autohide: true, delay: 5000 }).show()
    );

    // mobile toggle
    const btn  = document.getElementById('navToggle');
    const drawer = document.getElementById('navDrawer');
    const icon = document.getElementById('navToggleIcon');
    if (btn) btn.addEventListener('click', () => {
        const open = drawer.classList.toggle('open');
        icon.className = open ? 'bi bi-x-lg' : 'bi bi-list';
    });

    // scroll pin (hero pages only)
    const nav = document.getElementById('site-nav');
    if (nav && !nav.classList.contains('no-hero')) {
        const pin = () => nav.classList.toggle('pinned', window.scrollY > 40);
        window.addEventListener('scroll', pin, { passive: true });
        pin();
    }
});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
