@model KarnelTravelGuide.Web.Models.Entities.Transportation
@{
    ViewData["Title"] = "Select Seats";
}

<style>
    body { background-color: var(--bg); }
    
    .card-custom { 
        background: var(--white); 
        border-radius: 1.5rem; 
        padding: 2.5rem; 
        box-shadow: 0 10px 40px rgba(0,0,0,0.04); 
        border: 1px solid var(--line); 
    }
    
    .legend-container { display: flex; justify-content: center; gap: 24px; margin-bottom: 30px; }
    .legend-item { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.95rem; color: var(--soft); }
    .legend-box { width: 24px; height: 24px; border-radius: 6px; }

    .seat-grid { display: grid; gap: 15px; justify-content: center; }
    .seat { 
        height: 45px; width: 50px; 
        border-radius: 8px 8px 15px 15px; 
        display: flex; align-items: center; justify-content: center; 
        font-weight: 700; font-size: 1rem; cursor: pointer; 
        transition: all 0.2s ease; user-select: none; 
    }
    .seat.available { background-color: var(--white); border: 2px solid var(--g2); color: var(--g2); }
    .seat.available:hover { background-color: var(--t-lt); transform: translateY(-2px); }
    
    .seat.booked { background-color: var(--line); color: var(--muted); border: 2px solid #ced4da; cursor: not-allowed; }
    
    .seat.selected { 
        background-color: var(--g1); color: var(--white); border: 2px solid var(--g1); 
        transform: scale(1.05); box-shadow: 0 4px 10px rgba(42,157,143,0.3); 
    }

    .bottom-checkout-bar { 
        position: sticky; bottom: 20px; 
        background: rgba(255, 255, 255, 0.95); 
        backdrop-filter: blur(10px);
        padding: 20px 30px; 
        box-shadow: 0 -10px 40px rgba(0,0,0,0.08);
        z-index: 1000; 
        border: 1px solid var(--line); 
        border-radius: 1rem; 
        margin-top: 30px;
    }

    .btn-gradient {
        background: linear-gradient(135deg, var(--g1), var(--g2));
        color: var(--white);
        border: none;
        transition: opacity 0.2s, transform 0.2s;
        box-shadow: 0 4px 14px rgba(42,157,143,.3);
    }
    .btn-gradient:hover:not(.disabled) {
        opacity: 0.9; transform: translateY(-2px); color: var(--white);
    }
</style>

<div class="container py-5" style="max-width: 900px;">
    
    <div class="d-flex align-items-center mb-5">
        <a asp-action="Index" class="btn btn-light bg-white shadow-sm rounded-circle me-4 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; border: 1px solid var(--line);">
            <i class="bi bi-arrow-left" style="color: var(--ink);"></i>
        </a>
        <div>
            <h2 class="fw-bold mb-1" style="font-family: var(--ff-d); color: var(--ink);">@Model.TransportName</h2>
            <span style="color: var(--soft);"><i class="bi bi-ui-checks-grid me-1" style="color: var(--g2);"></i>Select your preferred seats</span>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null) { 
        <div class="alert alert-danger rounded-3 fw-bold mb-4 border-0"><i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]</div> 
    }

    <form asp-action="ConfirmBooking" method="post" id="checkoutForm">
        <input type="hidden" name="transportationId" value="@Model.TransportationId" id="transportId" />
        <input type="hidden" name="travelDate" value="@ViewBag.TravelDate" id="travelDateVal" />
        <input type="hidden" name="selectedSeats" id="hiddenSelectedSeats" />

        <div class="card-custom mb-0">
            <div class="row p-3 rounded-4 mb-4 g-3 border align-items-center text-center" style="background-color: var(--bg); border-color: var(--line) !important;">
                <div class="col-4 border-end" style="border-color: var(--line) !important;">
                    <small class="fw-bold d-block text-uppercase mb-1" style="color: var(--muted); letter-spacing: 0.05em; font-size: 0.75rem;">From</small>
                    <strong class="fs-6 fw-bold" style="color: var(--ink);">@Model.FromBranch?.BranchName</strong>
                </div>
                <div class="col-4 border-end" style="border-color: var(--line) !important;">
                    <small class="fw-bold d-block text-uppercase mb-1" style="color: var(--muted); letter-spacing: 0.05em; font-size: 0.75rem;">To</small>
                    <strong class="fs-6 fw-bold" style="color: var(--g1);">@Model.ToSpot?.SpotName</strong>
                </div>
                <div class="col-4">
                    <small class="fw-bold d-block text-uppercase mb-1" style="color: var(--muted); letter-spacing: 0.05em; font-size: 0.75rem;">Date & Time</small>
                    <div class="fs-6 fw-bold text-danger">
                        <i class="bi bi-calendar-event me-1"></i>@ViewBag.TravelDate
                        <span class="mx-1 fw-normal" style="color: var(--muted);">|</span>
                        <i class="bi bi-clock me-1"></i>@Model.DepartureTime?.ToString("HH:mm")
                    </div>
                </div>
            </div>

            <div class="legend-container pb-4 border-bottom" style="border-color: var(--line) !important;">
                <div class="legend-item"><div class="legend-box border border-2 bg-white" style="border-color: var(--g2);"></div>Available</div>
                <div class="legend-item"><div class="legend-box border border-2" style="background-color: var(--g1); border-color: var(--g1);"></div>Selected</div>
                <div class="legend-item"><div class="legend-box border border-2" style="background-color: var(--line); border-color: #ced4da;"></div>Booked</div>
            </div>

            <div class="text-center mt-5" id="loadingSpinner">
                <div class="spinner-border" style="color: var(--g1);" role="status"></div>
                <p class="mt-2 fw-bold" style="color: var(--soft);">Loading seat map...</p>
            </div>
            
            <div id="seatMapContainer" class="d-none mt-4">
                <div class="row justify-content-center">
                    <div class="col-md-6 mb-4">
                        <div class="p-4 rounded-4 border" style="background-color: var(--bg); border-color: var(--line) !important;">
                            <h5 class="text-center fw-bold mb-4 border-bottom pb-2" style="color: var(--ink); border-color: var(--line) !important;">Lower Deck (Floor 1)</h5>
                            <div class="seat-grid" id="floor1"></div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-4">
                        <div class="p-4 rounded-4 border" style="background-color: var(--bg); border-color: var(--line) !important;">
                            <h5 class="text-center fw-bold mb-4 border-bottom pb-2" style="color: var(--ink); border-color: var(--line) !important;">Upper Deck (Floor 2)</h5>
                            <div class="seat-grid" id="floor2"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="bottom-checkout-bar">
            <div class="row align-items-center m-0">
                <div class="col-md-5 text-start ps-0 pe-4">
                    <span class="fw-bold d-block mb-1" style="color: var(--muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">Selected Seats</span>
                    <div class="fw-bold fs-5 lh-base" style="color: var(--ink);" id="seatLabel">None</div>
                </div>
                <div class="col-md-3 text-center border-start border-end" style="border-color: var(--line) !important;">
                    <span class="fw-bold d-block mb-1" style="color: var(--muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">Total Amount</span>
                    <span class="fs-3 fw-bold lh-1" style="color: var(--g1);" id="priceLabel">$0</span>
                </div>
                <div class="col-md-4 text-end pe-0 ps-4 d-flex justify-content-end gap-2">
                    <a href="/BookRoom/Index?spotId=@Model.ToSpotId" class="btn btn-outline-secondary py-3 fw-bold rounded-pill border-0" style="background: var(--bg); color: var(--soft);">Skip</a>
                    <button type="submit" class="btn btn-gradient py-3 w-100 rounded-pill" id="submitBtn" disabled>
                        Book & Next <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tId = document.getElementById("transportId").value;
            const tDate = document.getElementById("travelDateVal").value;
            const capacity = @Model.SeatCapacity;
            const unitPrice = @(Model.PriceTransport ?? 0);
            
            fetch(`/BookTicket/GetBookedSeats?transportationId=${tId}&date=${tDate}`)
                .then(response => response.json())
                .then(data => {
                    document.getElementById("loadingSpinner").classList.add("d-none");
                    document.getElementById("seatMapContainer").classList.remove("d-none");

                    const f1 = document.getElementById("floor1");
                    const f2 = document.getElementById("floor2");
                    
                    let floor1Seats = [];
                    let floor2Seats = [];
            
                    let cols = ['A', 'B', 'C', 'D', 'E', 'F'];
                    let colsPerRow = capacity > 60 ? 6 : 4; 
                    
                    let currentSeatCount = 0;
                    let row = 1;

                    while (currentSeatCount < capacity) {
                        for (let c = 0; c < colsPerRow; c++) {
                            if (currentSeatCount >= capacity) break;
                            let seatCode = cols[c] + row;
                            if (capacity >= 30 && currentSeatCount >= Math.ceil(capacity / 2)) floor2Seats.push(seatCode);
                            else floor1Seats.push(seatCode);
                            currentSeatCount++;
                        }
                        row++;
                    }

                    f1.style.gridTemplateColumns = `repeat(${colsPerRow}, 1fr)`;
                    f2.style.gridTemplateColumns = `repeat(${colsPerRow}, 1fr)`;

                    if (floor2Seats.length === 0) {
                        f2.parentElement.classList.add("d-none");
                        f1.parentElement.classList.remove("col-md-6");
                        f1.parentElement.classList.add("col-12"); 
                    }

                    floor1Seats.forEach(id => f1.appendChild(createSeatHTML(id, data.bookedSeats.includes(id))));
                    floor2Seats.forEach(id => f2.appendChild(createSeatHTML(id, data.bookedSeats.includes(id))));
                });

            let selectedSeats = [];

            function createSeatHTML(id, isBooked) {
                let div = document.createElement("div");
                div.className = `seat ${isBooked ? 'booked' : 'available'}`;
                div.innerText = id;
                if (!isBooked) {
                    div.onclick = function () {
                        if (div.classList.contains("selected")) {
                            div.classList.remove("selected");
                            selectedSeats = selectedSeats.filter(s => s !== id);
                        } else {
                            div.classList.add("selected");
                            selectedSeats.push(id);
                        }
                        updateFooter();
                    };
                }
                return div;
            }

            function updateFooter() {
                const seatLabel = document.getElementById("seatLabel");
                const hiddenSeats = document.getElementById("hiddenSelectedSeats");
                const priceLabel = document.getElementById("priceLabel");
                const submitBtn = document.getElementById("submitBtn");
                
                if (selectedSeats.length > 0) {
                    seatLabel.innerHTML = `<span class="badge me-1 mb-1" style="background-color: var(--g1); color: white;">${selectedSeats.join('</span> <span class="badge me-1 mb-1" style="background-color: var(--g1); color: white;">')}</span>`;
                    hiddenSeats.value = selectedSeats.join(',');
                    priceLabel.innerText = "$" + (selectedSeats.length * unitPrice).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
                    submitBtn.disabled = false;
                } else {
                    seatLabel.innerText = "None";
                    hiddenSeats.value = "";
                    priceLabel.innerText = "$0";
                    submitBtn.disabled = true;
                }
            }

            document.getElementById("checkoutForm").addEventListener("submit", function() {
                const btn = document.getElementById("submitBtn");
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Processing...';
                btn.classList.add('disabled');
            });
        });
    </script>
}