@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.Transportation>
@{
    ViewData["Title"] = "Tìm chuyến xe";
}

<style>
    body { background-color: #f5f5f5; }
    
    .booking-container { max-width: 800px; margin: 30px auto; display: flex; flex-direction: column; gap: 20px; }
    .search-widget { background: #fff; border-radius: 16px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #f0f0f0; }
    
    .form-control-custom { border-radius: 8px; padding: 14px 16px; border: 1px solid #e0e0e0; background-color: #f9f9f9; font-weight: 500; width: 100%; transition: all 0.3s; color: #333; }
    .form-control-custom:focus { border-color: #0061e6; background-color: #fff; box-shadow: 0 0 0 3px rgba(0, 97, 230, 0.1); outline: none; }

    .btn-futa { background-color: #0061e6; color: white; border-radius: 10px; font-weight: 700; padding: 14px; width: 100%; border: none; font-size: 1.1rem; transition: 0.2s; }
    .btn-futa:hover { background-color: #004bb5; color: white; transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0, 97, 230, 0.3); }

    .trip-card { background: #fff; border-radius: 12px; padding: 24px; border: 1px solid #ebebeb; transition: transform 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.04); margin-bottom: 15px;}
    .trip-card:hover { border-color: #0061e6; box-shadow: 0 6px 16px rgba(0, 97, 230, 0.1); }
    .time-large { font-size: 1.5rem; font-weight: bold; color: #333; }
    .price-text { color: #0061e6; font-size: 1.3rem; font-weight: bold; }
</style>

<div class="container pb-5">
    <div class="booking-container">
        
        @if (TempData["SuccessMessage"] != null) { 
            <div class="alert alert-success rounded-3 fw-bold"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]</div> 
        }

        <div class="search-widget">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold">Điểm đi <i class="bi bi-arrow-up-right-circle text-primary ms-1"></i></label>
                        <select name="fromBranchId" class="form-select form-control-custom border-0 bg-light fs-5">
                            <option value="">Tất cả</option>
                            @foreach (var branch in ViewBag.Branches) { 
                                <option value="@branch.BranchId" selected="@(ViewBag.CurrentFrom == branch.BranchId ? "selected" : null)">@branch.BranchName</option> 
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold">Điểm đến <i class="bi bi-geo-alt text-danger ms-1"></i></label>
                        <select name="toSpotId" class="form-select form-control-custom border-0 bg-light fs-5">
                            <option value="">Tất cả</option>
                            @foreach (var spot in ViewBag.Spots) { 
                                <option value="@spot.SpotId" selected="@(ViewBag.CurrentTo == spot.SpotId ? "selected" : null)">@spot.SpotName</option> 
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold">Loại phương tiện</label>
                        <select name="transportType" class="form-select form-control-custom border-0 bg-light fs-5">
                            <option value="">Tất cả</option>
                            <option value="Land" selected="@(ViewBag.CurrentType == "Land" ? "selected" : null)">🚌 Đường bộ</option>
                            <option value="Water" selected="@(ViewBag.CurrentType == "Water" ? "selected" : null)">🛳️ Đường thủy</option>
                            <option value="Air" selected="@(ViewBag.CurrentType == "Air" ? "selected" : null)">✈️ Hàng không</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold">Ngày đi</label>
                        <input type="date" name="travelDate" value="@ViewBag.CurrentDate" min="@DateTime.Now.ToString("yyyy-MM-dd")" class="form-control form-control-custom border-0 bg-light fs-5" required />
                    </div>
                    <div class="col-12 mt-4">
                        <button type="submit" class="btn-futa py-3"><i class="bi bi-search me-2"></i>Tìm kiếm</button>
                    </div>
                </div>
            </form>
        </div>

        <h5 class="fw-bold mb-3 mt-2 text-dark">Các chuyến đi</h5>
        
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="trip-card">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-bus-front-fill fs-2 text-primary me-3"></i>
                            <div>
                                <h5 class="mb-1 fw-bold text-dark">@item.TransportName</h5>
                                <span class="badge bg-light text-dark border border-secondary">@item.TransportType</span>
                            </div>
                        </div>

                    </div>

                    <div class="row align-items-center text-center mb-3">
                        <div class="col-4">
                            <div class="time-large">@item.DepartureTime?.ToString("HH:mm")</div>
                            <small class="text-muted fw-bold">@item.FromBranch?.BranchName</small>
                        </div>
                        <div class="col-4">
                            <small class="text-muted d-block mb-1">Chi tiết xe</small>
                            <i class="bi bi-arrow-right fs-4 text-muted"></i>
                        </div>
                        <div class="col-4">
                            <div class="time-large text-primary">Tới bến</div>
                            <small class="text-muted fw-bold">@item.ToSpot?.SpotName</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 mt-3">
                        <div>
                            <small class="text-muted d-block">Từ</small>
                            <div class="price-text">@item.PriceTransport?.ToString("N0") $</div>
                        </div>
                        <a href="/BookTicket/Booking/@item.TransportationId?date=@ViewBag.CurrentDate" class="btn btn-primary rounded-pill px-4 fw-bold py-2">Chọn ghế</a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5 bg-white rounded-4 border text-muted">
                <i class="bi bi-journal-x fs-1"></i>
                <p class="mt-2 fw-bold">Không tìm thấy chuyến xe phù hợp.</p>
            </div>
        }
    </div>
</div>