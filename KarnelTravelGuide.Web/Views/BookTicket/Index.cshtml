@using KarnelTravelGuide.Web.Models.Entities
@model IEnumerable<Transportation>
@{
    ViewData["Title"] = "Find Tickets";
    ViewData["HeroPage"] = true; 
    var branchesList = ViewBag.Branches as IEnumerable<Branch> ?? new List<Branch>();
    var spotsList = ViewBag.Spots as IEnumerable<TouristSpot> ?? new List<TouristSpot>();
}

<style>
    body { background-color: var(--bg); }
    
    .ticket-hero {
        background: linear-gradient(rgba(24, 35, 46, 0.5), rgba(24, 35, 46, 0.8)), 
                    url('https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?q=80&w=2069&auto=format&fit=crop') no-repeat center center;
        background-size: cover;
        padding: 160px 0 120px;
        border-radius: 0 0 2rem 2rem;
        margin-bottom: 20px;
    }

    .hero-title {
        font-family: var(--ff-d);
        font-size: clamp(2.5rem, 5vw, 4rem);
        color: var(--white);
        line-height: 1.1;
    }

    .search-widget { 
        background: var(--white); 
        border-radius: 1.5rem; 
        padding: 2.5rem; 
        box-shadow: 0 15px 40px rgba(0,0,0,0.08); 
        border: 1px solid var(--line); 
        margin-top: -80px; 
        position: relative;
        z-index: 10;
    }
    
    .form-control-custom { 
        border-radius: 0.75rem; 
        padding: 0.8rem 1.2rem; 
        border: 1px solid var(--line); 
        background-color: var(--bg); 
        font-family: var(--ff-b);
        color: var(--ink); 
        transition: all 0.2s; 
    }
    .form-control-custom:focus { 
        border-color: var(--g1); 
        background-color: var(--white); 
        box-shadow: 0 0 0 4px rgba(58, 125, 94, 0.1); 
        outline: none; 
    }
    
    .btn-gradient {
        background: linear-gradient(135deg, var(--g1), var(--g2));
        color: var(--white);
        border: none;
        border-radius: 0.75rem; 
        font-weight: 700;
        transition: opacity 0.2s, transform 0.2s;
        box-shadow: 0 4px 14px rgba(42,157,143,.3);
    }
    .btn-gradient:hover {
        opacity: 0.9;
        transform: translateY(-2px);
        color: var(--white);
    }

    .route-card { 
        background: var(--white); 
        border-radius: 1.25rem; 
        padding: 1.5rem;
        transition: all 0.3s ease; 
        border: 1px solid var(--line); 
    }
    .route-card:hover { 
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.06); 
        border-color: rgba(42,157,143,0.2); 
    }
    
    .custom-dropdown-menu { 
        max-height: 250px; overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1000; width: 100%; 
        background: var(--white); border-radius: 0.75rem; display: none; margin-top: 5px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1); border: 1px solid var(--line); 
    }
    .custom-dropdown-menu.show { display: block; }
    .dropdown-item-custom { transition: background-color 0.2s; cursor: pointer; white-space: normal; padding: 12px 15px; color: var(--soft); }
    .dropdown-item-custom:hover { background: var(--g-lt); color: var(--g1); }
</style>

<div class="ticket-hero text-center position-relative">
    <div class="container">
        <h1 class="hero-title mb-3">Book Your Journey</h1>
        <p class="lead mb-0" style="color: rgba(255,255,255,0.85); font-weight: 300;">Find the best routes and book your tickets instantly.</p>
    </div>
</div>

<div class="container pb-5" style="max-width: 1100px;">

    @if (TempData["SuccessMessage"] != null) { 
        <div class="alert alert-success rounded-3 fw-bold mb-4 shadow-sm border-0" style="background-color: var(--t-lt); color: var(--g1);">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div> 
    }

    <div class="search-widget mb-5">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3 position-relative">
                <label class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em;">From</label>
                <input type="text" id="fromSearchInput" class="form-control form-control-custom" placeholder="Any Origin" autocomplete="off">
                <input type="hidden" name="fromBranchId" id="hiddenFromId" value="@ViewBag.CurrentFrom" />
                <div id="fromDropdown" class="custom-dropdown-menu p-0 border"></div>
            </div>

            <div class="col-md-3 position-relative">
                <label class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em;">To</label>
                <input type="text" id="toSearchInput" class="form-control form-control-custom" placeholder="Any Destination" autocomplete="off">
                <input type="hidden" name="toSpotId" id="hiddenToId" value="@ViewBag.CurrentTo" />
                <div id="toDropdown" class="custom-dropdown-menu p-0 border"></div>
            </div>

            <div class="col-md-2">
                <label class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em;">Type</label>
                <select name="transportType" class="form-select form-control-custom">
                    <option value="">All</option>
                    @if (ViewBag.CurrentType == "Land") { <option value="Land" selected>Land</option> } else { <option value="Land">Land</option> }
                    @if (ViewBag.CurrentType == "Air") { <option value="Air" selected>Air</option> } else { <option value="Air">Air</option> }
                    @if (ViewBag.CurrentType == "Water") { <option value="Water" selected>Water</option> } else { <option value="Water">Water</option> }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.05em;">Date</label>
                <input type="date" name="travelDate" value="@ViewBag.CurrentDate" class="form-control form-control-custom" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-gradient w-100 py-3"><i class="bi bi-search me-2"></i> Search</button>
            </div>
        </form>
    </div>

    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold text-dark m-0" style="font-family: var(--ff-d);"><i class="bi bi-geo-alt-fill me-2" style="color: var(--g1);"></i>Available Routes</h3>
    </div>

    @if (Model != null && Model.Any()) {
        <div class="row g-4">
            @foreach (var item in Model) {
                <div class="col-md-6">
                    <div class="route-card shadow-sm h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/img/no-image.jpg" : item.ImageUrl)" style="width: 70px; height: 50px; object-fit: cover; border-radius: 8px;" class="me-3 shadow-sm border" />
                                <div>
                                    <h6 class="fw-bold mb-1" style="color: var(--ink);">@item.TransportName</h6>
                                    @if (item.TransportType == "Air") { <span class="badge" style="background-color: var(--t-lt); color: var(--g1); border: 1px solid var(--g-lt);"><i class="bi bi-airplane-fill me-1"></i> Air</span> }
                                    else if (item.TransportType == "Land") { <span class="badge" style="background-color: var(--t-lt); color: var(--g1); border: 1px solid var(--g-lt);"><i class="bi bi-car-front-fill me-1"></i> Land</span> }
                                    else { <span class="badge" style="background-color: var(--t-lt); color: var(--g1); border: 1px solid var(--g-lt);"><i class="bi bi-water me-1"></i> Water</span> }
                                </div>
                            </div>
                        </div>

                        <div class="row text-center p-2 rounded-3 mb-3 border g-0 align-items-center" style="background-color: var(--bg); border-color: var(--line) !important;">
                            <div class="col-5">
                                <small class="d-block text-uppercase fw-bold" style="font-size: 0.7rem; color: var(--muted); letter-spacing: 0.05em;">From</small>
                                <span class="fw-bold text-truncate d-block" style="color: var(--ink);" title="@item.FromBranch?.BranchName">@item.FromBranch?.BranchName</span>
                            </div>
                            <div class="col-2"><i class="bi bi-arrow-right" style="color: var(--g1);"></i></div>
                            <div class="col-5">
                                <small class="d-block text-uppercase fw-bold" style="font-size: 0.7rem; color: var(--muted); letter-spacing: 0.05em;">To</small>
                                <span class="fw-bold text-truncate d-block" style="color: var(--g1);" title="@item.ToSpot?.SpotName">@item.ToSpot?.SpotName</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top" style="border-color: var(--line) !important;">
                            <div>
                                <small class="d-block fw-bold text-uppercase" style="font-size: 0.7rem; color: var(--muted); letter-spacing: 0.05em;">Price</small>
                                <h4 class="fw-bold mb-0" style="color: var(--g1);">$@item.PriceTransport?.ToString("0.##")</h4>
                            </div>
                            <div class="text-end d-flex align-items-center gap-3">
                                <small class="fw-bold mb-0" style="color: #e74c3c;"><i class="bi bi-clock me-1"></i>@item.DepartureTime?.ToString("HH:mm")</small>
                                <a asp-action="Booking" asp-route-id="@item.TransportationId" asp-route-date="@ViewBag.CurrentDate" class="btn btn-gradient px-4 py-2 rounded-pill">Select Seats</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    } else {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light">
            <i class="bi bi-journal-x mb-3" style="font-size: 4rem; color: var(--line);"></i>
            <h4 class="fw-bold text-dark" style="font-family: var(--ff-d);">No routes found</h4>
            <p style="color: var(--soft);">Try adjusting your filters (date, origin, destination).</p>
        </div>
    }

    <div class="mt-5 d-flex justify-content-between px-4 py-4 bg-white rounded-4 shadow-sm border border-light">
        <div>
            <p class="mb-1 text-muted fw-bold small">Already have a ticket or don't need one?</p>
            <a href="/BookRoom/Index?spotId=@ViewBag.CurrentTo" class="btn btn-outline-secondary fw-bold px-4 py-2 rounded-pill d-flex align-items-center">
                Skip & Go to Room Booking <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const branchesData = [ @foreach(var b in branchesList) { <text>{ id: @b.BranchId, name: "@Html.Raw(b.BranchName)" },</text> } ];
        const spotsData = [ @foreach(var s in spotsList) { <text>{ id: @s.SpotId, name: "@Html.Raw(s.SpotName)" },</text> } ];
        
        const fromInput = document.getElementById('fromSearchInput'); const fromDropdown = document.getElementById('fromDropdown'); const hiddenFromId = document.getElementById('hiddenFromId');
        const toInput = document.getElementById('toSearchInput'); const toDropdown = document.getElementById('toDropdown');
        const hiddenToId = document.getElementById('hiddenToId');

        window.onload = function() {
            if (hiddenFromId.value) { const f = branchesData.find(x => x.id == hiddenFromId.value);
            if (f) fromInput.value = f.name; }
            if (hiddenToId.value) { const t = spotsData.find(x => x.id == hiddenToId.value);
            if (t) toInput.value = t.name; }
        };
        
        function setupAutocomplete(inputEl, dropdownEl, hiddenEl, dataArray, allLabel) {
            function renderDrop(filterText) {
                dropdownEl.innerHTML = '';
                const lowerFilter = filterText.toLowerCase();
                const filtered = dataArray.filter(item => item.name.toLowerCase().includes(lowerFilter));

                const anyItem = document.createElement('div');
                anyItem.className = 'dropdown-item-custom border-bottom fw-bold';
                anyItem.style.color = 'var(--g1)';
                anyItem.innerText = "-- " + allLabel + " --";
                anyItem.onclick = function() { hiddenEl.value = ""; inputEl.value = ""; dropdownEl.classList.remove('show'); };
                dropdownEl.appendChild(anyItem);

                if (filtered.length === 0) {
                    dropdownEl.innerHTML += '<div class="p-3 small fst-italic" style="color: var(--muted);">No matches found.</div>';
                } else {
                    filtered.forEach(item => {
                        const div = document.createElement('div');
                        div.className = 'dropdown-item-custom border-bottom fw-bold text-dark';
                        div.innerText = item.name;
                        div.onclick = function() { hiddenEl.value = item.id; inputEl.value = item.name; dropdownEl.classList.remove('show'); };
                        dropdownEl.appendChild(div);
                    });
                }
                dropdownEl.classList.add('show');
            }
            inputEl.addEventListener('input', function() { hiddenEl.value = ''; renderDrop(this.value); });
            inputEl.addEventListener('focus', function() { renderDrop(this.value); });
            document.addEventListener('click', function(e) { if (!inputEl.contains(e.target) && !dropdownEl.contains(e.target)) dropdownEl.classList.remove('show'); });
        }

        setupAutocomplete(fromInput, fromDropdown, hiddenFromId, branchesData, "All Locations");
        setupAutocomplete(toInput, toDropdown, hiddenToId, spotsData, "All Destinations");
    </script>
}