@using KarnelTravelGuide.Web.Models.Entities
@model IEnumerable<Transportation>
@{
    ViewData["Title"] = "Find Tickets";
    var branchesList = ViewBag.Branches as IEnumerable<Branch> ?? new List<Branch>();
    var spotsList = ViewBag.Spots as IEnumerable<TouristSpot> ?? new List<TouristSpot>();
}

<style>
    body { background-color: #f8fafc; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; }
    .search-widget { background: #fff; border-radius: 1.25rem; padding: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.05); }
    .form-control-custom { border-radius: 0.75rem; padding: 0.8rem 1rem; border: 1px solid transparent; background-color: #f1f5f9; font-weight: 500; transition: all 0.2s; color: #333; }
    .form-control-custom:focus { border-color: #0d6efd; background-color: #fff; box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1); outline: none; }
    .btn-custom { background-color: #0d6efd; color: white; border-radius: 0.75rem; font-weight: 700; transition: all 0.2s; box-shadow: 0 4px 12px rgba(13,110,253,0.2); }
    .btn-custom:hover { background-color: #0b5ed7; transform: translateY(-1px); box-shadow: 0 6px 15px rgba(13,110,253,0.3); }

    .route-card { background: #fff; border-radius: 1.25rem; padding: 1.5rem; transition: all 0.2s ease; border: 1px solid rgba(0,0,0,0.05); }
    .route-card:hover { transform: translateY(-3px); box-shadow: 0 15px 35px rgba(0,0,0,0.08); border-color: rgba(13,110,253,0.15); }
    
    .custom-dropdown-menu { max-height: 250px; overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1000; width: 100%; background: #fff; border-radius: 0.75rem; display: none; margin-top: 5px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); border: 1px solid #eee; }
    .custom-dropdown-menu.show { display: block; }
    .dropdown-item-custom { transition: background-color 0.2s; cursor: pointer; white-space: normal; padding: 12px 15px; }
    .dropdown-item-custom:hover { background-color: #f8f9fa; }
</style>

<div class="container py-5" style="max-width: 1000px;">
    
    <div class="text-center mb-5">
        <h2 class="fw-bold text-dark mb-2">Where do you want to go?</h2>
        <p class="text-muted">Find the best routes and book your tickets instantly.</p>
    </div>

    @if (TempData["SuccessMessage"] != null) { 
        <div class="alert alert-success rounded-3 fw-bold mb-4"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]</div> 
    }

    <div class="search-widget mb-5">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3 position-relative">
                <label class="form-label text-muted small fw-bold text-uppercase">From</label>
                <input type="text" id="fromSearchInput" class="form-control form-control-custom" placeholder="Any Origin" autocomplete="off">
                <input type="hidden" name="fromBranchId" id="hiddenFromId" value="@ViewBag.CurrentFrom" />
                <div id="fromDropdown" class="custom-dropdown-menu p-0 border"></div>
            </div>

            <div class="col-md-3 position-relative">
                <label class="form-label text-muted small fw-bold text-uppercase">To</label>
                <input type="text" id="toSearchInput" class="form-control form-control-custom" placeholder="Any Destination" autocomplete="off">
                <input type="hidden" name="toSpotId" id="hiddenToId" value="@ViewBag.CurrentTo" />
                <div id="toDropdown" class="custom-dropdown-menu p-0 border"></div>
            </div>

            <div class="col-md-2">
                <label class="form-label text-muted small fw-bold text-uppercase">Type</label>
                <select name="transportType" class="form-select form-control-custom">
                    <option value="">All</option>
                    @if (ViewBag.CurrentType == "Land") { <option value="Land" selected>Land</option> } else { <option value="Land">Land</option> }
                    @if (ViewBag.CurrentType == "Air") { <option value="Air" selected>Air</option> } else { <option value="Air">Air</option> }
                    @if (ViewBag.CurrentType == "Water") { <option value="Water" selected>Water</option> } else { <option value="Water">Water</option> }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label text-muted small fw-bold text-uppercase">Date</label>
                <input type="date" name="travelDate" value="@ViewBag.CurrentDate" class="form-control form-control-custom" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-2">
                <label class="form-label text-muted small fw-bold text-uppercase">Time (Opt)</label>
                <input type="time" name="travelTime" value="@ViewBag.CurrentTime" class="form-control form-control-custom" />
            </div>

            <div class="col-12 mt-4">
                <button type="submit" class="btn btn-custom w-100 py-3"><i class="bi bi-search me-2"></i> Find Routes</button>
            </div>
        </form>
    </div>

    <h5 class="fw-bold text-dark mb-4"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Available Routes</h5>

    @if (Model != null && Model.Any()) {
        <div class="row g-4">
            @foreach (var item in Model) {
                <div class="col-md-6">
                    <div class="route-card shadow-sm h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/img/no-image.jpg" : item.ImageUrl)" style="width: 70px; height: 50px; object-fit: cover; border-radius: 8px;" class="me-3 shadow-sm border" />
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">@item.TransportName</h6>
                                    @if (item.TransportType == "Air") { <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1"><i class="bi bi-airplane-fill me-1"></i> Air</span> }
                                    else if (item.TransportType == "Land") { <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1"><i class="bi bi-car-front-fill me-1"></i> Land</span> }
                                    else { <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1"><i class="bi bi-water me-1"></i> Water</span> }
                                </div>
                            </div>
                        </div>

                        <div class="row text-center bg-light p-2 rounded-3 mb-3 border g-0 align-items-center">
                            <div class="col-5">
                                <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">From</small>
                                <span class="text-dark fw-bold text-truncate d-block" title="@item.FromBranch?.BranchName">@item.FromBranch?.BranchName</span>
                            </div>
                            <div class="col-2"><i class="bi bi-arrow-right text-primary"></i></div>
                            <div class="col-5">
                                <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">To</small>
                                <span class="text-primary fw-bold text-truncate d-block" title="@item.ToSpot?.SpotName">@item.ToSpot?.SpotName</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                            <div>
                                <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.7rem;">Price</small>
                                <h4 class="text-success fw-bold mb-0">$@item.PriceTransport?.ToString("0.##")</h4>
                            </div>
                            <div class="text-end">
                                <small class="text-danger fw-bold d-block mb-2"><i class="bi bi-clock me-1"></i>@item.DepartureTime?.ToString("HH:mm")</small>
                                <a asp-action="Booking" asp-route-id="@item.TransportationId" asp-route-date="@ViewBag.CurrentDate" class="btn btn-custom px-4 py-2">Select Seats</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    } else {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light">
            <i class="bi bi-journal-x text-muted mb-3" style="font-size: 4rem;"></i>
            <h4 class="fw-bold text-dark">No routes found</h4>
            <p class="text-muted">Try adjusting your filters (date, origin, destination).</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        const branchesData = [ @foreach(var b in branchesList) { <text>{ id: @b.BranchId, name: "@Html.Raw(b.BranchName)" },</text> } ];
        const spotsData = [ @foreach(var s in spotsList) { <text>{ id: @s.SpotId, name: "@Html.Raw(s.SpotName)" },</text> } ];

        const fromInput = document.getElementById('fromSearchInput'); const fromDropdown = document.getElementById('fromDropdown'); const hiddenFromId = document.getElementById('hiddenFromId');
        const toInput = document.getElementById('toSearchInput'); const toDropdown = document.getElementById('toDropdown'); const hiddenToId = document.getElementById('hiddenToId');

        // Pre-fill inputs on load
        window.onload = function() {
            if (hiddenFromId.value) { const f = branchesData.find(x => x.id == hiddenFromId.value); if (f) fromInput.value = f.name; }
            if (hiddenToId.value) { const t = spotsData.find(x => x.id == hiddenToId.value); if (t) toInput.value = t.name; }
        };

        function setupAutocomplete(inputEl, dropdownEl, hiddenEl, dataArray, allLabel) {
            function renderDrop(filterText) {
                dropdownEl.innerHTML = '';
                const lowerFilter = filterText.toLowerCase();
                const filtered = dataArray.filter(item => item.name.toLowerCase().includes(lowerFilter));

                const anyItem = document.createElement('div');
                anyItem.className = 'dropdown-item-custom border-bottom text-primary fw-bold';
                anyItem.innerText = "-- " + allLabel + " --";
                anyItem.onclick = function() { hiddenEl.value = ""; inputEl.value = ""; dropdownEl.classList.remove('show'); };
                dropdownEl.appendChild(anyItem);

                if (filtered.length === 0) {
                    dropdownEl.innerHTML += '<div class="p-3 text-muted small fst-italic">No matches found.</div>';
                } else {
                    filtered.forEach(item => {
                        const div = document.createElement('div');
                        div.className = 'dropdown-item-custom border-bottom fw-bold text-dark';
                        div.innerText = item.name;
                        div.onclick = function() { hiddenEl.value = item.id; inputEl.value = item.name; dropdownEl.classList.remove('show'); };
                        dropdownEl.appendChild(div);
                    });
                }
                dropdownEl.classList.add('show');
            }
            inputEl.addEventListener('input', function() { hiddenEl.value = ''; renderDrop(this.value); });
            inputEl.addEventListener('focus', function() { renderDrop(this.value); });
            document.addEventListener('click', function(e) { if (!inputEl.contains(e.target) && !dropdownEl.contains(e.target)) dropdownEl.classList.remove('show'); });
        }

        setupAutocomplete(fromInput, fromDropdown, hiddenFromId, branchesData, "All Locations");
        setupAutocomplete(toInput, toDropdown, hiddenToId, spotsData, "All Destinations");
    </script>
}