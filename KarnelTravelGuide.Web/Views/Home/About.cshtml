@{
    ViewData["Title"] = "About Us";
    ViewData["HeroPage"] = true;
}

<style>
    body { background-color: var(--bg); }

    .about-hero {
        position: relative;
        background: linear-gradient(rgba(24, 35, 46, 0.6), rgba(24, 35, 46, 0.8)), 
                    url('https://images.unsplash.com/photo-1506197603052-3cc9c3a201bd?q=80&w=2070&auto=format&fit=crop') no-repeat center center;
        background-size: cover;
        padding: 180px 0 120px;
        border-radius: 0 0 2rem 2rem;
        margin-bottom: 40px;
    }

    .hero-title {
        font-family: var(--ff-d);
        font-size: clamp(3rem, 5vw, 4.5rem);
        color: var(--white);
        line-height: 1.1;
    }

    .section-title {
        font-family: var(--ff-d);
        font-size: 2.5rem;
        font-weight: 600;
        color: var(--ink);
    }

    .glass-card {
        background: var(--white);
        border-radius: 1.5rem;
        padding: 2.5rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.04);
        border: 1px solid var(--line);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .glass-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        border-color: rgba(42,157,143,0.2);
    }

    .icon-box {
        width: 65px;
        height: 65px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin-bottom: 1.5rem;
        background: var(--g-lt);
        color: var(--g1);
        transition: all 0.3s ease;
    }

    .glass-card:hover .icon-box {
        background: var(--g1);
        color: var(--white);
        transform: scale(1.1);
    }

    .stat-number {
        font-family: var(--ff-d);
        font-size: 3.5rem;
        font-weight: 700;
        color: var(--g1);
        line-height: 1;
        margin-bottom: 0.5rem;
    }

    .story-img-container {
        position: relative;
        border-radius: 1.5rem;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
    }
    
    .story-img-container img {
        width: 100%;
        height: auto;
        transition: transform 0.6s ease;
    }

    .story-img-container:hover img {
        transform: scale(1.05);
    }

    .btn-gradient {
        background: linear-gradient(135deg, var(--g1), var(--g2));
        color: var(--white);
        border: none;
        transition: opacity 0.2s, transform 0.2s;
        box-shadow: 0 4px 14px rgba(42,157,143,.3);
    }
    
    .btn-gradient:hover {
        opacity: 0.9;
        transform: translateY(-2px);
        color: var(--white);
    }
</style>

<section class="about-hero text-center">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="mb-4"><i class="bi bi-compass" style="font-size: 3.5rem; color: var(--g2);"></i></div>
                <h1 class="hero-title mb-4">Explore the World with Karnel Travel</h1>
                <p class="lead" style="color: rgba(255,255,255,0.85); font-weight: 300;">
                    We don’t just provide trips, we create unforgettable experiences.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="py-4" style="margin-top: -80px; z-index: 10; position: relative;">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="glass-card h-100 p-4">
                    <div class="stat-number">10k+</div>
                    <p class="fw-bold text-uppercase mb-0" style="color: var(--soft); font-size: 0.85rem; letter-spacing: 0.05em;">Happy Travelers</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card h-100 p-4" style="border-bottom: 4px solid var(--g1);">
                    <div class="stat-number">50+</div>
                    <p class="fw-bold text-uppercase mb-0" style="color: var(--soft); font-size: 0.85rem; letter-spacing: 0.05em;">Exclusive Destinations</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card h-100 p-4">
                    <div class="stat-number">24/7</div>
                    <p class="fw-bold text-uppercase mb-0" style="color: var(--soft); font-size: 0.85rem; letter-spacing: 0.05em;">Customer Support</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 my-4">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="story-img-container">
                    <img src="https://images.unsplash.com/photo-1522083165195-3444bed50e47?q=80&w=2000&auto=format&fit=crop" alt="Travel Journey" />
                    <div class="position-absolute bottom-0 start-0 p-4 w-100" style="background: linear-gradient(to top, rgba(24,35,46,0.9), rgba(24,35,46,0));">
                        <h4 class="text-white fw-bold m-0" style="font-family: var(--ff-d);">Journey started in 2026</h4>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <span class="badge px-3 py-2 rounded-pill text-uppercase fw-bold mb-3 shadow-sm" style="background-color: var(--t-lt); color: var(--g1); letter-spacing: 0.05em; border: 1px solid var(--g-lt);">Our Story</span>
                <h2 class="section-title mb-4">Beyond Every Border</h2>
                <p class="fs-6 lh-lg mb-4" style="color: var(--soft); text-align: justify;">
                    Karnel Travel Guide was founded with a simple belief: travel is the best way to change perspectives and connect people. We understand that every journey is a unique story, and we are here to help you connect each chapter.
                </p>
                <p class="fs-6 lh-lg mb-5" style="color: var(--soft); text-align: justify;">
                    More than just a booking platform, we create a complete ecosystem. From premium accommodations and safe transportation to unique local culinary experiences. Our attention to detail and technology ensure a worry-free journey.
                </p>
                <a href="/Destination" class="btn btn-gradient rounded-pill px-5 py-3 fw-bold shadow-sm">
                    Start Exploring <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="py-5 position-relative" style="background-color: var(--white); border-top: 1px solid var(--line);">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="section-title mb-3">Our Core Values</h2>
            <p class="fs-6 mx-auto" style="color: var(--muted); max-width: 600px;">
                Quality and dedication define how Karnel Travel serves every customer.
            </p>
        </div>
        
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="glass-card h-100" style="background: var(--bg);">
                    <div class="icon-box shadow-sm">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h4 class="fw-bold mb-3" style="font-family: var(--ff-d); color: var(--ink);">Attention to Detail</h4>
                    <p class="mb-0 lh-lg" style="color: var(--soft); text-align: justify; font-size: 0.95rem;">
                        Every restaurant, transport service, and accommodation is carefully evaluated to ensure absolute safety and maximum comfort for your journey.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="glass-card h-100" style="background: var(--bg);">
                    <div class="icon-box shadow-sm">
                        <i class="bi bi-lightning-charge"></i>
                    </div>
                    <h4 class="fw-bold mb-3" style="font-family: var(--ff-d); color: var(--ink);">Fast Technology</h4>
                    <p class="mb-0 lh-lg" style="color: var(--soft); text-align: justify; font-size: 0.95rem;">
                        A smart, secure, and minimalist booking platform. Choose, pay, and start your journey easier than ever.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="glass-card h-100" style="background: var(--bg);">
                    <div class="icon-box shadow-sm">
                        <i class="bi bi-heart"></i>
                    </div>
                    <h4 class="fw-bold mb-3" style="font-family: var(--ff-d); color: var(--ink);">24/7 Support</h4>
                    <p class="mb-0 lh-lg" style="color: var(--soft); text-align: justify; font-size: 0.95rem;">
                        From technical support to travel advice, our dedicated team is always ready whenever you need assistance.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>