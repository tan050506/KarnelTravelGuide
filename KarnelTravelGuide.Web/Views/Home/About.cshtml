@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5" style="max-width: 900px;">
    <div class="text-center mb-5">
        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold mb-3">About KarnelTravel</span>
        <h1 class="fw-bold text-dark mb-3">Your Trusted Travel Companion</h1>
        <p class="text-muted fs-5">We provide comprehensive travel solutions from transportation and accommodation to dining experiences.</p>
    </div>

    <div class="k-card border-0 shadow-sm p-md-5 mb-5">
        <div class="row align-items-center">
            <div class="col-md-6 mb-4 mb-md-0">
                <h3 class="fw-bold text-dark mb-4">Our Story</h3>
                <p class="text-muted lh-lg" style="text-align: justify;">
                    Founded with the mission to connect passionate explorers, <strong>KarnelTravel</strong> is more than just a booking system. We are a complete ecosystem where you can find safe transportation, cozy rooms, and delicious local meals.
                </p>
                <p class="text-muted lh-lg" style="text-align: justify;">
                    With modern technology and a user-friendly interface, we are committed to providing you with a smooth, fast, and completely secure booking experience.
                </p>
            </div>
            <div class="col-md-6">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="k-card bg-light border-0 text-center p-4 mb-0 h-100">
                            <h2 class="fw-bold text-primary mb-1">50+</h2>
                            <span class="text-muted small fw-bold text-uppercase">Destinations</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="k-card bg-light border-0 text-center p-4 mb-0 h-100">
                            <h2 class="fw-bold text-success mb-1">24/7</h2>
                            <span class="text-muted small fw-bold text-uppercase">Support</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="k-card bg-light border-0 text-center p-4 mb-0">
                            <h2 class="fw-bold text-warning mb-1">100%</h2>
                            <span class="text-muted small fw-bold text-uppercase">Satisfaction</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>