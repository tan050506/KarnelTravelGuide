@{
    ViewData["Title"] = "About Us";
}

<style>
    .about-hero {
        position: relative;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: white;
        padding: 120px 0;
        overflow: hidden;
    }

    .about-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -10%;
        width: 60%;
        height: 150%;
        background: radial-gradient(circle, rgba(13,110,253,0.15) 0%, rgba(0,0,0,0) 70%);
        transform: rotate(-15deg);
        pointer-events: none;
    }

    .about-hero::after {
        content: '';
        position: absolute;
        bottom: -30%;
        right: -10%;
        width: 50%;
        height: 100%;
        background: radial-gradient(circle, rgba(245,158,11,0.15) 0%, rgba(0,0,0,0) 70%);
        pointer-events: none;
    }

    .hero-title {
        font-family: 'Inter', sans-serif;
        font-weight: 800;
        font-size: 3.5rem;
        letter-spacing: -1px;
        background: linear-gradient(to right, #ffffff, #94a3b8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 20px;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 20px 40px rgba(0,0,0,0.05);
        border-radius: 20px;
        padding: 40px;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
    }

    .glass-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 30px 60px rgba(0,0,0,0.1);
    }

    .icon-box {
        width: 70px;
        height: 70px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin-bottom: 24px;
        color: white;
    }

    .ic-primary { background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%); }
    .ic-warning { background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%); }
    .ic-success { background: linear-gradient(135deg, #10b981 0%, #34d399 100%); }

    .stat-number {
        font-size: 3rem;
        font-weight: 800;
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 5px;
    }

    .float-anim {
        animation: floating 3s ease-in-out infinite;
    }

    @@keyframes floating {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-15px); }
        100% { transform: translateY(0px); }
    }

    .story-img-container {
        position: relative;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 25px 50px rgba(0,0,0,0.15);
    }
    
    .story-img-container img {
        width: 100%;
        height: auto;
        transition: transform 0.5s ease;
    }

    .story-img-container:hover img {
        transform: scale(1.05);
    }
</style>

<!-- Hero Section -->
<section class="about-hero text-center">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="display-1 float-anim mb-4"><i class="bi bi-compass text-warning"></i></div>
                <h1 class="hero-title">Explore the World with Karnel Travel</h1>
                <p class="lead text-light opacity-75 fs-4 mb-5">
                    We don’t just provide trips, we create unforgettable experiences.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="py-5" style="margin-top: -60px; z-index: 10; position: relative;">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="glass-card h-100">
                    <div class="stat-number">10k+</div>
                    <p class="text-muted fw-bold text-uppercase mb-0">Happy Customers</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card h-100 border-primary border-opacity-25">
                    <div class="stat-number" style="background: linear-gradient(135deg, #f59e0b, #ed1c24); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">50+</div>
                    <p class="text-muted fw-bold text-uppercase mb-0">Exclusive Destinations</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card h-100">
                    <div class="stat-number" style="background: linear-gradient(135deg, #10b981, #059669); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">24/7</div>
                    <p class="text-muted fw-bold text-uppercase mb-0">Customer Support</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Our Story Section -->
<section class="py-5 my-5">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="story-img-container">
                    <img src="/images/background/cam-nang-du-lich.jpg" alt="Travel Journey" />
                    <div class="position-absolute bottom-0 start-0 p-4 w-100" style="background: linear-gradient(to top, rgba(0,0,0,0.8), rgba(0,0,0,0));">
                        <h4 class="text-white fw-bold m-0">Journey started in 2026</h4>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <span class="badge text-bg-warning px-3 py-2 rounded-pill text-uppercase fw-bold mb-3 shadow-sm">Our Story</span>
                <h2 class="fw-bold fs-1 mb-4 text-dark">Beyond Every Border</h2>
                <p class="text-muted fs-5 lh-lg mb-4 text-justify">
                    Karnel Travel Guide was founded with a simple belief: travel is the best way to change perspectives and connect people. We understand that every journey is a unique story, and we are here to help you connect each chapter.
                </p>
                <p class="text-muted fs-5 lh-lg mb-5 text-justify">
                    More than just a booking platform, we create a complete ecosystem. From premium accommodations and safe transportation to unique local culinary experiences. Our attention to detail and technology ensure a worry-free journey.
                </p>
                <a href="/Destination" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg" style="transition: all 0.3s; background: linear-gradient(135deg, #0d6efd, #0b5ed7); border: none;">
                    Start Booking <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Core Values Section -->
<section class="py-5 bg-light position-relative">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="fw-bold fs-1 mb-3">Our Core Values</h2>
            <p class="text-muted fs-5 mx-auto" style="max-width: 600px;">
                Quality and dedication define how Karnel Travel serves every customer.
            </p>
        </div>
        
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="glass-card h-100" style="background: white;">
                    <div class="icon-box ic-primary shadow-sm">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h4 class="fw-bold mb-3 text-dark">Attention to Detail</h4>
                    <p class="text-muted mb-0 lh-lg" style="text-align: justify;">
                        Every restaurant, transport service, and accommodation is carefully evaluated to ensure absolute safety and maximum comfort for your journey.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="glass-card h-100" style="background: white;">
                    <div class="icon-box ic-warning shadow-sm">
                        <i class="bi bi-lightning-charge"></i>
                    </div>
                    <h4 class="fw-bold mb-3 text-dark">Fast Technology</h4>
                    <p class="text-muted mb-0 lh-lg" style="text-align: justify;">
                        A smart, secure, and minimalist booking platform. Choose, pay, and start your journey easier than ever.
                    </p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="glass-card h-100" style="background: white;">
                    <div class="icon-box ic-success shadow-sm">
                        <i class="bi bi-heart"></i>
                    </div>
                    <h4 class="fw-bold mb-3 text-dark">24/7 Support</h4>
                    <p class="text-muted mb-0 lh-lg" style="text-align: justify;">
                        From technical support to travel advice, our dedicated team is always ready whenever you need assistance.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>