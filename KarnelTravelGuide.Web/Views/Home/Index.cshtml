@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.TouristSpot>
@{
    ViewData["Title"] = "KarnelTravel — Discover Your Next Journey";
    ViewData["HeroPage"] = true;
}

<style>

.label-tag {
    display: inline-block;
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--g1);
    margin-bottom: .65rem;
}

.sec-h {
    font-family: var(--ff-d);
    font-size: clamp(1.9rem, 3.8vw, 2.75rem);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.18;
    margin-bottom: .5rem;
}

.sec-p {
    font-size: .95rem;
    color: var(--muted);
    line-height: 1.75;
}

.hero {
    position: relative;
    height: 100vh;
    min-height: 680px;
    max-height: 960px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.hero__bg {
    position: absolute;
    inset: 0;
    background:
        linear-gradient(180deg,
            rgba(8,20,14,.48) 0%,
            rgba(8,20,14,.22) 38%,
            rgba(8,20,14,.72) 100%),
        url('https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?q=80&w=2070&auto=format&fit=crop')
        center / cover no-repeat;
    animation: heroScale 22s ease-out both;
    transform-origin: center;
}
@@keyframes heroScale {
    from { transform: scale(1.07); }
    to   { transform: scale(1.0); }
}

.hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 0 1.5rem;
    max-width: 760px;
    margin: 0 auto;
    animation: fadeUp .8s .1s both;
}

@@keyframes fadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
}

.hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: .9rem;
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: rgba(255,255,255,.6);
    margin-bottom: 1.5rem;
}
.hero__kicker::before,
.hero__kicker::after {
    content: '';
    width: 32px;
    height: 1px;
    background: rgba(255,255,255,.3);
}

.hero__title {
    font-family: var(--ff-d);
    font-size: clamp(3.2rem, 8vw, 5.8rem);
    font-weight: 600;
    color: #fff;
    line-height: 1.07;
    letter-spacing: -.02em;
    margin-bottom: 1.2rem;
}
.hero__title em {
    font-style: italic;
    color: #7dd9c6;
}

.hero__sub {
    font-size: 1rem;
    color: rgba(255,255,255,.62);
    line-height: 1.8;
    max-width: 460px;
    margin: 0 auto 2.5rem;
    font-weight: 300;
}

.hero__cta {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
}

.btn-solid {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .82rem 2rem;
    border-radius: 50px;
    font-size: .9rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--g1), var(--g2));
    color: #fff;
    box-shadow: 0 8px 28px rgba(42,157,143,.4);
    transition: transform .18s, box-shadow .18s;
}
.btn-solid:hover { transform: translateY(-2px); box-shadow: 0 14px 38px rgba(42,157,143,.5); color: #fff; }

.btn-outline-w {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .82rem 2rem;
    border-radius: 50px;
    font-size: .9rem;
    font-weight: 700;
    color: rgba(255,255,255,.88);
    border: 1.5px solid rgba(255,255,255,.32);
    backdrop-filter: blur(6px);
    transition: background .18s, border-color .18s;
}
.btn-outline-w:hover { background: rgba(255,255,255,.13); border-color: rgba(255,255,255,.65); color: #fff; }

.hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .4rem;
    color: rgba(255,255,255,.35);
    font-size: .65rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    animation: scrollBounce 2.4s ease-in-out infinite;
}
.hero__scroll span {
    display: block;
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, rgba(255,255,255,.35), transparent);
}
@@keyframes scrollBounce {
    0%,100% { opacity: .4; transform: translateX(-50%) translateY(0); }
    50%      { opacity: .8; transform: translateX(-50%) translateY(6px); }
}

.search-section {
    background: var(--white);
    padding: 0;
    position: relative;
    z-index: 10;
    margin-top: -1px;
}

.search-card {
    background: var(--white);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 6px 32px rgba(0,0,0,.07);
}

.search-form {
    display: flex;
    align-items: stretch;
    width: 100%;
    min-height: 72px;
}

.sf-field {
    flex: 1;
    min-width: 0;
    padding: 1rem 1.5rem;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .28rem;
    position: relative;
}
.sf-field:last-of-type { border-right: none; }

.sf-label {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: .35rem;
    line-height: 1;
}
.sf-label i { color: var(--g2); font-size: .72rem; }

.sf-input {
    width: 100%;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--ff-b);
    font-size: .925rem;
    font-weight: 500;
    color: var(--ink);
    padding: 0;
    line-height: 1.4;
}
.sf-input::placeholder { color: var(--line); font-weight: 400; }
.sf-input option { font-weight: 400; color: var(--ink); }

.sf-btn-cell {
    padding: .85rem 1.25rem;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    border-left: 1px solid var(--line);
}

.sf-btn {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .72rem 1.8rem;
    background: linear-gradient(135deg, var(--g1), var(--g2));
    color: #fff;
    border: none;
    border-radius: 10px;
    font-family: var(--ff-b);
    font-size: .9rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 4px 16px rgba(42,157,143,.28);
    transition: opacity .17s, transform .15s;
}
.sf-btn:hover { opacity: .9; transform: translateY(-1px); }

@@media (max-width: 767px) {
    .search-form { flex-direction: column; }
    .sf-field { border-right: none; border-bottom: 1px solid var(--line); }
    .sf-btn-cell { border-left: none; border-top: 1px solid var(--line); padding: 1rem 1.5rem; }
    .sf-btn { width: 100%; justify-content: center; border-radius: 8px; }
}

.features-sec {
    padding: 6rem 0 5rem;
    background: var(--bg);
}

.feat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
}
@@media (max-width: 991px) { .feat-grid { grid-template-columns: repeat(2, 1fr); } }
@@media (max-width: 575px)  { .feat-grid { grid-template-columns: 1fr; } }

.feat-item {
    background: var(--white);
    border-radius: 16px;
    border: 1px solid var(--line);
    padding: 2rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: .1rem;
    position: relative;
    overflow: hidden;
    transition: transform .26s, box-shadow .26s;
}
.feat-item::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--g1), var(--g2));
    opacity: 0;
    transition: opacity .26s;
}
.feat-item:hover { transform: translateY(-6px); box-shadow: 0 16px 48px rgba(26,60,45,.1); }
.feat-item:hover::after { opacity: 1; }

.feat-icon {
    width: 52px; height: 52px;
    border-radius: 13px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem;
    margin-bottom: 1.15rem;
}
.fi-green { background: var(--g-lt); color: var(--g1); }
.fi-teal  { background: var(--t-lt); color: var(--g2); }
.fi-blue  { background: #ebf1fb; color: #3b72d4; }
.fi-amber { background: #fdf4e3; color: #b87d1a; }

.feat-title { font-size: 1rem; font-weight: 700; color: var(--ink); margin-bottom: .45rem; }
.feat-desc  { font-size: .85rem; color: var(--muted); line-height: 1.65; flex: 1; }
.feat-more  {
    display: inline-flex; align-items: center; gap: .3rem;
    font-size: .8rem; font-weight: 700; color: var(--g1);
    margin-top: 1rem;
    transition: gap .18s;
}
.feat-more:hover { gap: .55rem; }

.dest-sec {
    padding: 6rem 0;
    background: var(--white);
}

.dest-sec .sec-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
    gap: 1rem;
}

.btn-border-green {
    display: inline-flex; align-items: center; gap: .4rem;
    font-size: .845rem; font-weight: 700;
    color: var(--g1);
    border: 1.5px solid var(--g1);
    border-radius: 50px;
    padding: .52rem 1.35rem;
    transition: background .18s, color .18s;
}
.btn-border-green:hover { background: var(--g1); color: #fff; }

.dcard {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    display: block;
    width: 100%;
}
.dcard img {
    width: 100%;
    object-fit: cover;
    display: block;
    transition: transform .6s cubic-bezier(.4,0,.2,1);
}
.dcard:hover img { transform: scale(1.06); }

.dcard__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top,
        rgba(6,18,12,.88) 0%,
        rgba(6,18,12,.18) 50%,
        transparent 100%);
}

.dcard__body {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 1.5rem 1.5rem 1.4rem;
    z-index: 2;
}

.dcard__badge {
    display: inline-flex; align-items: center; gap: .3rem;
    font-size: .68rem; font-weight: 700;
    letter-spacing: .07em; text-transform: uppercase;
    color: #fff;
    background: rgba(42,157,143,.75);
    border-radius: 50px;
    padding: .25rem .75rem;
    margin-bottom: .6rem;
    backdrop-filter: blur(4px);
}

.dcard__name {
    font-family: var(--ff-d);
    font-weight: 600;
    color: #fff;
    line-height: 1.2;
    margin-bottom: .4rem;
}
.dcard__name.big { font-size: 2rem; }
.dcard__name.sm  { font-size: 1.45rem; }

.dcard__meta {
    display: flex; align-items: center; gap: 1rem;
    font-size: .78rem; color: rgba(255,255,255,.58);
    flex-wrap: wrap;
}
.dcard__meta span { display: flex; align-items: center; gap: .28rem; }

.dcard__btn {
    display: inline-flex; align-items: center; gap: .35rem;
    font-size: .78rem; font-weight: 700; color: #fff;
    background: rgba(255,255,255,.14);
    border: 1px solid rgba(255,255,255,.3);
    border-radius: 50px;
    padding: .35rem 1rem;
    margin-top: .8rem;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity .22s, transform .22s;
    backdrop-filter: blur(4px);
}
.dcard:hover .dcard__btn { opacity: 1; transform: translateY(0); }

.dcard-tall  img { height: 520px; }
.dcard-short img { height: 248px; }
@@media (max-width: 767px) {
    .dcard-tall  img,
    .dcard-short img { height: 280px; }
}

.dest-empty {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--g-lt);
    border-radius: 16px;
    border: 1.5px dashed var(--line);
}
.dest-empty-icon {
    width: 64px; height: 64px;
    border-radius: 50%;
    background: var(--white);
    color: var(--g1);
    font-size: 1.6rem;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1.1rem;
    box-shadow: 0 4px 16px rgba(26,60,45,.08);
}

.why-sec {
    padding: 6rem 0;
    background: var(--bg);
}

.why-img-wrap { position: relative; }
.why-img {
    width: 100%;
    height: 440px;
    object-fit: cover;
    border-radius: 18px;
    display: block;
    box-shadow: 0 24px 64px rgba(8,24,16,.18);
}
.why-float {
    position: absolute;
    bottom: 2rem;
    left: -1.25rem;
    background: var(--white);
    border-radius: 14px;
    padding: 1rem 1.35rem;
    box-shadow: 0 12px 36px rgba(8,24,16,.14);
    display: flex; align-items: center; gap: .8rem;
}
.why-float__num {
    font-family: var(--ff-d);
    font-size: 2rem;
    font-weight: 600;
    color: var(--g1);
    line-height: 1;
}
.why-float__lbl { font-size: .78rem; color: var(--muted); line-height: 1.45; font-weight: 600; }

@@media (max-width: 767px) {
    .why-img { height: 280px; }
    .why-float { left: 0; bottom: -1rem; }
}

.stat-cards { display: flex; flex-direction: column; gap: 1rem; margin-top: 2.25rem; }
.stat-card {
    display: flex; align-items: center; gap: 1rem;
    padding: 1.1rem 1.35rem;
    background: var(--white);
    border-radius: 14px;
    border: 1px solid var(--line);
    transition: box-shadow .22s;
}
.stat-card:hover { box-shadow: 0 8px 28px rgba(26,60,45,.08); }
.stat-card__icon {
    width: 44px; height: 44px;
    border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
}
.sic-green { background: var(--g-lt); color: var(--g1); }
.sic-teal  { background: var(--t-lt); color: var(--g2); }
.sic-gold  { background: #fdf4e3; color: #b87d1a; }
.stat-card__num { font-family: var(--ff-d); font-size: 1.45rem; font-weight: 600; color: var(--ink); line-height: 1; }
.stat-card__lbl { font-size: .82rem; color: var(--muted); line-height: 1.5; }

.trust-sec {
    background: linear-gradient(135deg, #1f5c43 0%, #1a8a7a 100%);
    padding: 3.25rem 0;
}

.trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    align-items: center;
}

.trust-item {
    display: flex;
    align-items: center;
    gap: .85rem;
    padding: 0 2rem;
    border-right: 1px solid rgba(255,255,255,.13);
    color: rgba(255,255,255,.88);
}
.trust-item:last-child { border-right: none; }

.trust-icon {
    width: 44px; height: 44px;
    border-radius: 11px;
    background: rgba(255,255,255,.12);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.15rem;
    flex-shrink: 0;
}
.trust-num {
    font-family: var(--ff-d);
    font-size: 1.55rem;
    font-weight: 600;
    color: #fff;
    line-height: 1;
}
.trust-lbl { font-size: .78rem; color: rgba(255,255,255,.55); margin-top: .1rem; }

@@media (max-width: 767px) {
    .trust-grid { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
    .trust-item { border-right: none; padding: 0 1rem; }
}
</style>

<section class="hero">
    <div class="hero__bg"></div>

    <div class="hero__content">
        <div class="hero__kicker">Explore · Discover · Experience</div>
        <h1 class="hero__title">
            Your World Awaits,<br>
            <em>Start Exploring</em>
        </h1>
        <p class="hero__sub">
            Hand-crafted journeys across Vietnam's most stunning landscapes — seamless bookings for transport, stays &amp; dining.
        </p>
        <div class="hero__cta">
            <a asp-controller="Destination" asp-action="Index" class="btn-solid">
                <i class="bi bi-compass"></i> Browse Destinations
            </a>
            <a asp-controller="Home" asp-action="About" class="btn-outline-w">
                <i class="bi bi-play-circle"></i> Our Story
            </a>
        </div>
    </div>

    <div class="hero__scroll"><span></span>Scroll</div>
</section>

<section class="search-section">
    <div class="search-card">
        <div class="container-fluid px-0">
            <form class="search-form" action="#" method="get">
                <div class="sf-field">
                    <div class="sf-label"><i class="bi bi-geo-alt-fill"></i> Where to?</div>
                    <input type="text" class="sf-input" placeholder="City, landmark, region…">
                </div>

                <div class="sf-field">
                    <div class="sf-label"><i class="bi bi-calendar3"></i> Date</div>
                    <input type="date" class="sf-input">
                </div>

                <div class="sf-field">
                    <div class="sf-label"><i class="bi bi-grid-fill"></i> Service</div>
                    <select class="sf-input">
                        <option value="">All Services</option>
                        <option>Transport Ticket</option>
                        <option>Hotel &amp; Stay</option>
                        <option>Dining / Restaurant</option>
                    </select>
                </div>

                <div class="sf-btn-cell">
                    <button type="submit" class="sf-btn">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<section class="features-sec">
    <div class="container">
        <div class="text-center mb-5">
            <div class="label-tag">What We Offer</div>
            <h2 class="sec-h">All-In-One Travel Platform</h2>
            <p class="sec-p" style="max-width:440px;margin:0 auto;">Everything you need for a perfect trip, seamlessly packed into one place.</p>
        </div>
        </div>
    </div>
</section>

<section class="dest-sec">
    <div class="container">
        <div class="sec-header">
            <div>
                <div class="label-tag">Top Picks</div>
                <h2 class="sec-h mb-0">Trending Destinations</h2>
                <p class="sec-p mt-1 mb-0">Places our travelers are loving right now.</p>
            </div>
            <a asp-controller="Destination" asp-action="Index" class="btn-border-green">
                View All <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        @{
            var spots = Model?.ToList() ?? new List<KarnelTravelGuide.Web.Models.Entities.TouristSpot>();
        }

        @if (!spots.Any())
        {
            <div class="dest-empty">
                <div class="dest-empty-icon"><i class="bi bi-map"></i></div>
                <h5 style="font-family:var(--ff-d);font-size:1.5rem;font-weight:600;color:var(--ink)">No Destinations Yet</h5>
                <p class="sec-p mb-0">New tourist spots will appear here once added by the team.</p>
            </div>
        }
        else if (spots.Count == 1)
        {
            <a asp-controller="Destination" asp-action="Detail" asp-route-id="@spots[0].SpotId" class="dcard dcard-tall">
                <img src="@(string.IsNullOrEmpty(spots[0].ImageUrl) ? "/img/no-image.jpg" : spots[0].ImageUrl)" alt="@spots[0].SpotName">
                <div class="dcard__veil"></div>
                <div class="dcard__body">
                    <div class="dcard__badge">Featured</div>
                    <div class="dcard__name big">@spots[0].SpotName</div>
                    <div class="dcard__meta">
                        <span><i class="bi bi-camera"></i> @spots[0].TouristSpotImages.Count photos</span>
                        <span><i class="bi bi-geo-alt"></i> @spots[0].Address</span>
                    </div>
                    <div class="dcard__btn">Explore <i class="bi bi-arrow-right"></i></div>
                </div>
            </a>
        }
        else if (spots.Count == 2)
        {
            <div class="row g-4">
                @foreach (var s in spots)
                {
                    <div class="col-md-6">
                        <a asp-controller="Destination" asp-action="Detail" asp-route-id="@s.SpotId" class="dcard dcard-tall">
                            <img src="@(string.IsNullOrEmpty(s.ImageUrl) ? "/img/no-image.jpg" : s.ImageUrl)" alt="@s.SpotName">
                            <div class="dcard__veil"></div>
                            <div class="dcard__body">
                                <div class="dcard__badge">Trending</div>
                                <div class="dcard__name sm">@s.SpotName</div>
                                <div class="dcard__meta">
                                    <span><i class="bi bi-camera"></i> @s.TouristSpotImages.Count</span>
                                    <span><i class="bi bi-geo-alt"></i> @(s.Address?.Length > 24 ? s.Address[..24] + "…" : s.Address)</span>
                                </div>
                                <div class="dcard__btn">Explore <i class="bi bi-arrow-right"></i></div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-7">
                    <a asp-controller="Destination" asp-action="Detail" asp-route-id="@spots[0].SpotId" class="dcard dcard-tall">
                        <img src="@(string.IsNullOrEmpty(spots[0].ImageUrl) ? "/img/no-image.jpg" : spots[0].ImageUrl)" alt="@spots[0].SpotName">
                        <div class="dcard__veil"></div>
                        <div class="dcard__body">
                            <div class="dcard__badge">Featured</div>
                            <div class="dcard__name big">@spots[0].SpotName</div>
                            <div class="dcard__meta">
                                <span><i class="bi bi-camera"></i> @spots[0].TouristSpotImages.Count photos</span>
                                <span><i class="bi bi-geo-alt"></i> @spots[0].Address</span>
                            </div>
                            <div class="dcard__btn">Explore <i class="bi bi-arrow-right"></i></div>
                        </div>
                    </a>
                </div>

                <div class="col-lg-5 d-flex flex-column gap-4">
                    @for (int i = 1; i < spots.Count && i <= 2; i++)
                    {
                        var s = spots[i];
                        <a asp-controller="Destination" asp-action="Detail" asp-route-id="@s.SpotId"
                           class="dcard dcard-short" style="flex:1">
                            <img src="@(string.IsNullOrEmpty(s.ImageUrl) ? "/img/no-image.jpg" : s.ImageUrl)" alt="@s.SpotName">
                            <div class="dcard__veil"></div>
                            <div class="dcard__body">
                                <div class="dcard__badge">Trending</div>
                                <div class="dcard__name sm">@s.SpotName</div>
                                <div class="dcard__meta">
                                    <span><i class="bi bi-camera"></i> @s.TouristSpotImages.Count</span>
                                    <span><i class="bi bi-geo-alt"></i> @(s.Address?.Length > 22 ? s.Address[..22] + "…" : s.Address)</span>
                                </div>
                                <div class="dcard__btn">Explore <i class="bi bi-arrow-right"></i></div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</section>


