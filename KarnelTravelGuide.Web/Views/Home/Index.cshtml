@model IEnumerable<KarnelTravelGuide.Web.Models.Entities.TouristSpot>
@{
    ViewData["Title"] = "Home - KarnelTravelGuide";
}

<style>
    :root {
        --kt-primary: #0d6efd;
        --kt-primary-hover: #0b5ed7;
    }

    body {
        background-color: #f8fafc;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    /* 1. Khu vực ảnh bìa */
    .hero-banner {
        background: linear-gradient(rgba(15, 23, 42, 0.4), rgba(15, 23, 42, 0.7)), 
                    url('https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?q=80&w=2021&auto=format&fit=crop') no-repeat center center;
        background-size: cover;
        height: 75vh;
        min-height: 550px;
        display: flex;
        align-items: center;
        border-radius: 0 0 2.5rem 2.5rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    /* 2. Khung tìm kiếm */
    .search-glass {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px);
        border-radius: 1.25rem;
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        transform: translateY(50%);
        z-index: 10;
        border: 1px solid rgba(255,255,255,0.5);
    }

    .form-control-custom {
        background-color: #f1f5f9;
        border: 1px solid transparent;
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
        transition: all 0.2s;
    }
    .form-control-custom:focus {
        background-color: #fff;
        border-color: var(--kt-primary);
        box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1);
    }

    /* 3. Thẻ Dịch vụ */
    .service-card {
        border: none;
        border-radius: 1.25rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background: #fff;
        height: 100%;
    }
    .service-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.06);
    }
    .icon-box {
        width: 64px; height: 64px;
        border-radius: 1rem;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.75rem;
        margin-bottom: 1.25rem;
    }

    /* 4. Thẻ Địa điểm */
    .dest-card {
        border-radius: 1.25rem;
        overflow: hidden;
        border: none;
        position: relative;
        cursor: pointer;
    }
    .dest-card img {
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        height: 350px;
        object-fit: cover;
    }
    .dest-card:hover img {
        transform: scale(1.08);
    }
    .dest-overlay {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0) 100%);
        padding: 2rem 1.5rem 1.5rem;
        color: white;
    }
    
    .section-title {
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 1rem;
    }
</style>

<section class="hero-banner position-relative mb-5">
    <div class="container h-100 pb-5">
        <div class="row h-100 align-items-center">
            <div class="col-lg-8 mx-auto text-center text-white">
                <span class="badge bg-white text-dark px-3 py-2 rounded-pill mb-3 shadow-sm fw-bold">🚀 The Leading Travel Platform</span>
                <h1 class="display-3 fw-bold mb-4" style="letter-spacing: -1px;">Explore the World with KarnelTravel</h1>
                <p class="lead mb-0 opacity-75 fs-5">Experience the perfect journey with our premium booking system for transportation, unforgettable stays, and local dining.</p>
            </div>
        </div>
    </div>

    <div class="position-absolute start-0 w-100" style="bottom: 0;">
        <div class="container">
            <div class="search-glass p-4 mx-auto" style="max-width: 1000px;">
                <form class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-secondary small mb-1"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Where to?</label>
                        <input type="text" class="form-control form-control-custom" placeholder="City, destination...">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small mb-1"><i class="bi bi-calendar-event-fill text-primary me-1"></i> Date</label>
                        <input type="date" class="form-control form-control-custom">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small mb-1"><i class="bi bi-grid-fill text-success me-1"></i> Service</label>
                        <select class="form-select form-control-custom">
                            <option>Transport Ticket</option>
                            <option>Hotel & Stay</option>
                            <option>Dining / Restaurant</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm" style="padding: 0.75rem 1rem; border-radius: 0.75rem;">
                            Search
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<div style="height: 80px;"></div>

<section class="container py-5 my-4">
    <div class="text-center mb-5">
        <h2 class="section-title">Our Premium Services</h2>
        <p class="text-muted fs-6">Everything you need for a perfect, seamless trip.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="card service-card p-4 text-center shadow-sm">
                <div class="icon-box bg-danger bg-opacity-10 text-danger mx-auto">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <h5 class="fw-bold text-dark">Destinations</h5>
                <p class="text-muted small mb-0 mt-2">Discover popular tourist attractions and breathtaking views.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card service-card p-4 text-center shadow-sm">
                <div class="icon-box bg-primary bg-opacity-10 text-primary mx-auto">
                    <i class="bi bi-bus-front-fill"></i>
                </div>
                <h5 class="fw-bold text-dark">Transport Tickets</h5>
                <p class="text-muted small mb-0 mt-2">Book buses, flights, and ferries quickly and securely.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card service-card p-4 text-center shadow-sm">
                <div class="icon-box bg-success bg-opacity-10 text-success mx-auto">
                    <i class="bi bi-building-fill"></i>
                </div>
                <h5 class="fw-bold text-dark">Luxury Stays</h5>
                <p class="text-muted small mb-0 mt-2">Diverse accommodation system tailored to your comfort.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card service-card p-4 text-center shadow-sm">
                <div class="icon-box bg-warning bg-opacity-10 text-warning mx-auto">
                    <i class="bi bi-shop"></i>
                </div>
                <h5 class="fw-bold text-dark">Local Dining</h5>
                <p class="text-muted small mb-0 mt-2">Taste the essence of local cuisine at top-rated restaurants.</p>
            </div>
        </div>
    </div>
</section>

<section class="container py-5 mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="section-title mb-1">Top Destinations</h2>
            <p class="text-muted mb-0">Discover places travelers love the most.</p>
        </div>
        <a href="#" class="btn btn-outline-primary rounded-pill fw-bold px-4">View All <i class="bi bi-arrow-right ms-1"></i></a>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var spot in Model)
            {
                <div class="col-md-4">
                    <div class="card dest-card shadow-sm">
                        <img src="@(string.IsNullOrEmpty(spot.ImageUrl) ? "/img/no-image.jpg" : spot.ImageUrl)" class="w-100" alt="@spot.SpotName">
                        <div class="dest-overlay">
                            <span class="badge bg-primary mb-2 px-2 py-1">Trending</span>
                            <h4 class="fw-bold mb-1 text-truncate">@spot.SpotName</h4>
                            <p class="small mb-0 opacity-75 text-truncate">
                                <i class="bi bi-camera me-1"></i> @spot.TouristSpotImages.Count Photos • 
                                <i class="bi bi-geo-alt ms-1"></i> @spot.Address
                            </p>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 bg-light rounded-4 border text-muted">
                <i class="bi bi-image fs-1 d-block mb-3"></i>
                <h5>No destinations available</h5>
                <p>New tourist spots added by managers will appear here.</p>
            </div>
        }
    </div>
</section>