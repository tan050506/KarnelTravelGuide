@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid p-0 mb-5">
    <div class="text-white text-center py-5 shadow-sm" style="background: linear-gradient(135deg, #0d6efd 0%, #084298 100%);">
        <div class="container py-5">
            <h1 class="display-3 fw-bold mb-3" style="letter-spacing: -1px;">Discover Vietnam with Karnel</h1>
            <p class="lead mb-4 fw-light opacity-75">Your ultimate guide for Stays, Transportation, and Dining experiences.</p>
            
            <div class="row justify-content-center mt-4">
                <div class="col-md-8">
                    <form class="d-flex bg-white p-2 rounded-pill shadow" asp-controller="TouristSpot" asp-action="Index" method="get">
                        <input type="text" name="searchString" class="form-control border-0 rounded-pill px-4" placeholder="Where do you want to go?" style="box-shadow: none;">
                        <button class="btn btn-primary rounded-pill px-4 fw-bold" type="submit">Search</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-dark mb-2">Our Core Services</h2>
        <div style="width: 50px; height: 4px; background-color: #0d6efd; margin: 0 auto;"></div>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 transition-hover">
                <div class="mb-3"><i class="bi bi-map text-primary" style="font-size: 3rem;"></i></div>
                <h5 class="fw-bold">Destinations</h5>
                <p class="text-muted small">Explore the most beautiful and famous tourist spots across the country.</p>
                <a asp-controller="TouristSpot" asp-action="Index" class="btn btn-outline-primary rounded-pill mt-auto">Explore Now</a>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 transition-hover">
                <div class="mb-3"><i class="bi bi-bus-front text-primary" style="font-size: 3rem;"></i></div>
                <h5 class="fw-bold">Transportation</h5>
                <p class="text-muted small">Book buses, flights, or ferries to your favorite destinations easily.</p>
                <a asp-controller="Transportation" asp-action="Index" class="btn btn-outline-primary rounded-pill mt-auto">View Routes</a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 transition-hover">
                <div class="mb-3"><i class="bi bi-buildings text-primary" style="font-size: 3rem;"></i></div>
                <h5 class="fw-bold">Stays & Hotels</h5>
                <p class="text-muted small">Find the best resorts, hotels, and homestays for a perfect trip.</p>
                <a asp-controller="Stay" asp-action="Index" class="btn btn-outline-primary rounded-pill mt-auto">Book Room</a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 transition-hover">
                <div class="mb-3"><i class="bi bi-cup-hot text-primary" style="font-size: 3rem;"></i></div>
                <h5 class="fw-bold">Restaurants</h5>
                <p class="text-muted small">Reserve a table at top-rated local restaurants and enjoy the cuisine.</p>
                <a asp-controller="Restaurant" asp-action="Index" class="btn btn-outline-primary rounded-pill mt-auto">Find Dining</a>
            </div>
        </div>
    </div>
</div>

<style>
    .transition-hover { transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .transition-hover:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
</style>