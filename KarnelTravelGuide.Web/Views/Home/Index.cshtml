@{
    ViewData["Title"] = "Trang chủ - Karnel Travel Guide";
}

<div class="position-relative bg-dark text-white text-center" style="background: url('https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') no-repeat center center/cover; height: 60vh; min-height: 400px;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background-color: rgba(0, 0, 0, 0.5);"></div>
    <div class="position-relative d-flex flex-column justify-content-center align-items-center h-100 px-3">
        <h1 class="display-4 fw-bold mb-3">Khám phá thế giới cùng Karnel Travel</h1>
        <p class="lead mb-4">Đặt vé xe, phòng khách sạn và nhà hàng dễ dàng trên một nền tảng duy nhất.</p>
        
        <div class="bg-white p-3 rounded shadow w-100" style="max-width: 800px;">
            <form action="/TouristSpot/Search" method="GET" class="row g-2 align-items-center">
                <div class="col-md-8">
                    <input type="text" name="keyword" class="form-control form-control-lg" placeholder="Bạn muốn đi đâu? (VD: Đà Lạt, Nha Trang...)" required>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">Tìm kiếm ngay</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row align-items-center bg-light p-4 rounded shadow-sm border-start border-5 border-warning">
        <div class="col-md-8">
            <h3 class="fw-bold text-danger">🔥 Ưu đãi độc quyền từ Karnel!</h3>
            <p class="mb-md-0 fs-5">Hệ thống sẽ <strong>tự động giảm giá</strong> vào tổng hóa đơn khi bạn đặt từ 2 dịch vụ khác nhau trở lên (VD: Vé xe + Phòng khách sạn, hoặc Phòng + Bàn nhà hàng).</p>
        </div>
        <div class="col-md-4 text-md-end text-center mt-3 mt-md-0">
            <a href="/Combo" class="btn btn-warning btn-lg fw-bold px-4">Xem chi tiết</a>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Điểm đến thịnh hành</h2>
        <a href="/TouristSpot" class="text-decoration-none fw-bold">Xem tất cả <i class="bi bi-arrow-right"></i></a>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://images.unsplash.com/photo-1599708153386-62bf0bd56360?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" class="card-img-top" alt="Hội An" style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Phố cổ Hội An</h5>
                    <p class="card-text text-muted">Khám phá vẻ đẹp cổ kính, lãng mạn của những chiếc đèn lồng và kiến trúc di sản.</p>
                </div>
                <div class="card-footer bg-white border-0 pb-3">
                    <a href="/TouristSpot/Details/1" class="btn btn-outline-primary w-100">Khám phá</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://images.unsplash.com/photo-1559592413-7cec4d0cae2b?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" class="card-img-top" alt="Đà Lạt" style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Thành phố Đà Lạt</h5>
                    <p class="card-text text-muted">Tận hưởng không khí se lạnh, những đồi thông reo và các khu resort nghỉ dưỡng đẳng cấp.</p>
                </div>
                <div class="card-footer bg-white border-0 pb-3">
                    <a href="/TouristSpot/Details/2" class="btn btn-outline-primary w-100">Khám phá</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://images.unsplash.com/photo-1528127269322-539801943592?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" class="card-img-top" alt="Nha Trang" style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Biển xanh Nha Trang</h5>
                    <p class="card-text text-muted">Trải nghiệm các khách sạn ven biển, hải sản tươi sống và phương tiện di chuyển tiện lợi.</p>
                </div>
                <div class="card-footer bg-white border-0 pb-3">
                    <a href="/TouristSpot/Details/3" class="btn btn-outline-primary w-100">Khám phá</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container my-5 text-center">
    <h2 class="fw-bold mb-5">Dịch vụ của chúng tôi</h2>
    <div class="row g-4">
        <div class="col-md-3 col-6">
            <div class="p-4 border rounded shadow-sm bg-white h-100">
                <h1 class="text-primary mb-3">🚗</h1>
                <h5 class="fw-bold">Vé xe</h5>
                <p class="text-muted small">Đặt vé xe khách, tàu hỏa nhanh chóng.</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="p-4 border rounded shadow-sm bg-white h-100">
                <h1 class="text-success mb-3">🏨</h1>
                <h5 class="fw-bold">Khách sạn</h5>
                <p class="text-muted small">Phòng nghỉ đa dạng, giá tốt nhất.</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="p-4 border rounded shadow-sm bg-white h-100">
                <h1 class="text-info mb-3">🏝️</h1>
                <h5 class="fw-bold">Resort</h5>
                <p class="text-muted small">Nghỉ dưỡng sang trọng, đẳng cấp.</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="p-4 border rounded shadow-sm bg-white h-100">
                <h1 class="text-warning mb-3">🍽️</h1>
                <h5 class="fw-bold">Nhà hàng</h5>
                <p class="text-muted small">Đặt bàn trước, thưởng thức tinh hoa.</p>
            </div>
        </div>
    </div>
</div>